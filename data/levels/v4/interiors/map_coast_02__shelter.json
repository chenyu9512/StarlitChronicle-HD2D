  "investigations": [
    {
      "id": "inspect_act01_shelter_1",
      "kind": "medicine_basket",
      "name": "当值药盒",
      "cell": [
        27,
        17
      ],
      "first_text": "药盒边贴着收容床位号；第七号病床的姓名栏仍然空着，但每日的汤药剂量清楚。",
      "repeat_text": "药师按日期补写了一条记录。",
      "after_text": "护士把找回的名字写进床位卡，还保留着最初的空白登记。",
      "owner_absent_text": "这里保存着别人的记录，只能阅读公开部分，不可擅自取走。",
      "owner_present_text": "管理员允许你查阅公开记录，请保留原件。",
      "after_flag": "story.ch002.done",
      "privacy": "observe_only",
      "reward": null,
      "interaction_status": "authored_no_reward"
    },
    {
      "id": "inspect_act01_shelter_2",
      "kind": "crate",
      "name": "搁浅行囊",
      "cell": [
        45,
        18
      ],
      "first_text": "一只湿透的行囊里没有身份证明，只有被海水磨圆的贝壳和一截写着归港日的绳结。",
      "repeat_text": "贝壳安稳地放在干布上。",
      "after_text": "行囊旁多了一张写有船员家乡的回执。",
      "owner_absent_text": "这里保存着别人的记录，只能阅读公开部分，不可擅自取走。",
      "owner_present_text": "管理员允许你查阅公开记录，请保留原件。",
      "after_flag": "story.ch002.done",
      "privacy": "observe_only",
      "reward": null,
      "interaction_status": "authored_no_reward"
    },
    {
      "id": "inspect_act01_shelter_3",
      "kind": "sign",
      "name": "临时名册",
      "cell": [
        29,
        26
      ],
      "first_text": "名册按救援时间排列，几位水手的名字被人用铅笔划掉，旁边却留着不同的笔迹。",
      "repeat_text": "几位病患的名字仍待本人确认。",
      "after_text": "记录员抄了两份名册，一份送去港务处核对。",
      "owner_absent_text": "这里保存着别人的记录，只能阅读公开部分，不可擅自取走。",
      "owner_present_text": "管理员允许你查阅公开记录，请保留原件。",
      "after_flag": "story.ch002.done",
      "privacy": "observe_only",
      "reward": null,
      "interaction_status": "authored_no_reward"
    },
    {
      "id": "inspect_act01_shelter_4",
      "kind": "flowerpot",
      "name": "盐草安神盆",
      "cell": [
        49,
        29
      ],
      "first_text": "盐草闻起来带着淡淡的海风；纸条写着先问清病患是否愿意闻，再靠近床边。",
      "repeat_text": "安神盆的边缘留着细细水痕。",
      "after_text": "收容所将同意与拒绝的照护记录也保存了下来。",
      "owner_absent_text": "这里保存着别人的记录，只能阅读公开部分，不可擅自取走。",
