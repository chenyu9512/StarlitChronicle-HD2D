    },
    {
      "id": "ch036.p13.choice.act",
      "chapter_id": "ch036",
      "after_choice_id": "ch036.choice",
      "choice_option_id": "act",
      "condition": {
        "ch036.approach": "medical_first",
        "world.ch036.approach": "medical_first"
      },
      "insertion": "after_choice_commit_before_encounter",
      "optional": true,
      "independent_route": false,
      "dialogue": [
        {
          "id": "ch036.p13.choice.act.l01",
          "speaker": "岚音",
          "text": "保留医护使用的短眠设备，但要先告知风险并允许撤回。"
