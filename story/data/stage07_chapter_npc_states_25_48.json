      "act_end_extra": {
        "id": "ch042.npc.act_ending",
        "speaker": "旧洲书记员",
        "text": "同一个人可能有两个名字，仍只有一个需要被好好对待的人。户籍册总算有地方容纳这件事。",
        "conditions": {
          "required_flags": [
            "story.ch042.done"
          ]
        },
        "original_new_text": true
      }
