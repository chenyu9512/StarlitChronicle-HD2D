            "type": "chapter_enter",
            "region": "镜眠王都·日轮街"
          },
          "dialogue": [
            {
              "id": "ch031.opening.l01",
              "speaker": "旁白",
              "text": "【镜眠王都·日轮街】空气中藏着异样的气息。"
            },
            {
              "id": "ch031.opening.l02",
              "speaker": "玄璃",
              "text": "你们的影子每晚都消失，为什么没人觉得奇怪？"
            },
            {
              "id": "ch031.opening.l03",
              "speaker": "主角",
              "text": "先把眼前的事弄清楚。调查居民重复同一天的证据。"
            },
            {
              "id": "ch031.opening.l04",
              "speaker": "玄璃",
              "text": "别忘了，沿途的人也有自己的故事。"
            }
          ],
          "objectives": [
            {
              "type": "reach",
              "target": "镜眠王都·日轮街"
            },
            {
              "type": "interact",
              "target": "ch031.key_npc"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch031.started",
