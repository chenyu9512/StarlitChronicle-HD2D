{
  "schema": "starlit.story.npc_barks.v1",
  "lines": [
    {
      "id": "npc_bark_001",
      "speaker": "城门卫兵",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch008.started"
      ],
      "text": "今天过关要检查三次，连我们自己都烦了。"
    },
    {
      "id": "npc_bark_002",
      "speaker": "粮贩",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch012.done"
      ],
      "text": "三国又有商队来了，希望这条路别再关上。"
    },
    {
      "id": "npc_bark_003",
      "speaker": "矿工",
      "location": "赤炉联邦",
      "requires_flags": [
        "story.ch016.started"
      ],
      "text": "我从工厂回来，儿子竟然不认识我了。"
    },
    {
      "id": "npc_bark_004",
      "speaker": "矿工家属",
      "location": "赤炉联邦",
      "requires_flags": [
        "story.ch018.done"
      ],
      "text": "工资还没补足，不过总算有人肯承认我们存在。"
    },
    {
      "id": "npc_bark_005",
      "speaker": "海港船工",
      "location": "海歌港",
      "requires_flags": [
        "story.ch025.started"
      ],
      "text": "这船漏得能养鱼，可修起来会是一艘好船。"
    },
    {
      "id": "npc_bark_006",
      "speaker": "海岛邮差",
      "location": "海歌群岛",
      "requires_flags": [
        "story.ch026.done"
      ],
      "text": "信终于有地方寄了，有些答案不急着到。"
    },
    {
      "id": "npc_bark_007",
      "speaker": "年轻画师",
      "location": "镜眠王都",
      "requires_flags": [
        "story.ch031.started"
      ],
      "text": "我每天都画同一朵花，怎么画也觉得差一点。"
    },
    {
      "id": "npc_bark_008",
      "speaker": "护士",
      "location": "镜眠王都",
      "requires_flags": [
        "story.ch035.done"
      ],
      "text": "醒来的人会哭，也会笑。至少都是自己的心情。"
    },
    {
      "id": "npc_bark_009",
      "speaker": "旧洲商人",
      "location": "旧洲",
      "requires_flags": [
        "story.ch042.done"
      ],
      "text": "我们能重新标上家乡的地名了。"
    },
    {
      "id": "npc_bark_010",
      "speaker": "老人",
      "location": "晨露村",
      "requires_flags": [
        "world.black_star"
      ],
      "text": "灯塔还站着，可我已经忘了它以前是什么颜色。"
    },
    {
      "id": "npc_bark_011",
      "speaker": "修桥工",
      "location": "灾后王都",
      "requires_flags": [
        "story.ch050.done"
      ],
      "text": "旧桥断了好多年，我们正在把路接起来。"
    },
    {
      "id": "npc_bark_012",
      "speaker": "旅店老板",
      "location": "群灯之城",
      "requires_flags": [
        "story.ch057.done"
      ],
      "text": "今天又多了一户人搬进来，厨房得多备两份菜。"
    },
    {
      "id": "npc_bark_013",
      "speaker": "卫兵",
      "location": "群灯之城",
      "requires_flags": [
        "story.ch060.done"
      ],
      "text": "我不替灯王守门，我给愿意回家的居民指路。"
    },
    {
      "id": "npc_bark_014",
      "speaker": "学者",
      "location": "天轨圣域",
      "requires_flags": [
        "story.ch062.done"
      ],
      "text": "原来所谓“万无一失”，从第一天起就是自欺欺人。"
    },
    {
      "id": "npc_bark_015",
      "speaker": "孩子",
      "location": "晨露村",
      "requires_flags": [
        "story.ch072.done"
      ],
      "text": "今天海面上的星星好亮。我想长大后也去旅行。"
    },
    {
      "id": "npc_bark_016",
      "speaker": "三国门卫",
      "location": "三誓王都·外廷",
      "requires_flags": [
        "story.ch007.started"
      ],
      "text": "我也只拿一份薪水，却被要求替三个国家查通行证。"
    },
    {
      "id": "npc_bark_017",
      "speaker": "医师",
      "location": "三誓王都·后巷",
      "requires_flags": [
        "story.ch007.done"
      ],
      "text": "这几天多了些病人，至少这次我们知道他们叫什么。"
    },
    {
      "id": "npc_bark_018",
      "speaker": "难民孩子",
      "location": "三誓王都·后巷",
      "requires_flags": [
        "story.ch007.done"
      ],
      "text": "药师姐姐说我的名字可以写在真正的病历上。"
    },
    {
      "id": "npc_bark_019",
      "speaker": "车夫",
      "location": "灰鹰商道",
      "requires_flags": [
        "story.ch008.started"
      ],
      "text": "我的驴比这三国官员还明白什么时候该让路。"
    },
    {
      "id": "npc_bark_020",
      "speaker": "桥头守卫",
      "location": "灰鹰商道",
      "requires_flags": [
        "story.ch008.done"
      ],
      "text": "两边的人终于能一起在桥上修木板了。"
    },
    {
      "id": "npc_bark_021",
      "speaker": "面包师",
      "location": "灰鹰商道",
      "requires_flags": [
        "story.ch008.done"
      ],
      "text": "一袋面粉从两国经过，吃起来也没变味。"
    },
    {
      "id": "npc_bark_022",
      "speaker": "审判厅书记",
      "location": "三誓王都·审判厅",
      "requires_flags": [
        "story.ch009.started"
      ],
      "text": "今日旁听者太多，请不要把剑带上台阶。"
    },
    {
      "id": "npc_bark_023",
      "speaker": "幸存老妇",
      "location": "三誓王都·审判厅",
      "requires_flags": [
        "story.ch009.done"
      ],
      "text": "他们说今天我很勇敢，其实我只是终于能把话说完。"
    },
    {
      "id": "npc_bark_024",
      "speaker": "旧骑士团学徒",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch009.done"
      ],
      "text": "雷索拒绝复职，我却更愿意向他学怎么举盾。"
    },
    {
      "id": "npc_bark_025",
      "speaker": "粮仓管理员",
      "location": "边境议事站",
      "requires_flags": [
        "story.ch010.started"
      ],
      "text": "这把钥匙是南国的，那把是北国的，都开不了我家的门。"
    },
    {
      "id": "npc_bark_026",
      "speaker": "使者助手",
      "location": "边境议事站",
      "requires_flags": [
        "story.ch010.done"
      ],
      "text": "以前各写各的报告，现在终于有人肯把纸放到一起。"
    },
    {
      "id": "npc_bark_027",
      "speaker": "搬粮士兵",
      "location": "边境议事站",
      "requires_flags": [
        "story.ch010.done"
      ],
      "text": "昨天还盯着对方的剑，今天一起抬车，腰都要断了。"
    },
    {
      "id": "npc_bark_028",
      "speaker": "工兵",
      "location": "旧盟约桥",
      "requires_flags": [
        "story.ch011.started"
      ],
      "text": "桥底的引线不是我装的。但我知道它连着什么。"
    },
    {
      "id": "npc_bark_029",
      "speaker": "使节随员",
      "location": "旧盟约桥",
      "requires_flags": [
        "story.ch011.done"
      ],
      "text": "终于不用在黑石和白石的交界处停下来行礼了。"
    },
    {
      "id": "npc_bark_030",
      "speaker": "小贩",
      "location": "旧盟约桥",
      "requires_flags": [
        "story.ch011.done"
      ],
      "text": "这桥恢复通行，我的热汤才卖得出去。"
    },
    {
      "id": "npc_bark_031",
      "speaker": "果农",
      "location": "律序灯坛",
      "requires_flags": [
        "story.ch012.done"
      ],
      "text": "果树不认王印，它只知道我每年都来浇水。"
    },
    {
      "id": "npc_bark_032",
      "speaker": "议事书记",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch012.done"
      ],
      "text": "上个月的军令和粮食记录都贴在广场，谁都能去看。"
    },
    {
      "id": "npc_bark_033",
      "speaker": "三国商人",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch012.done"
      ],
      "text": "三种钱币还是不好算，但比三道封锁好多了。"
    },
    {
      "id": "npc_bark_034",
      "speaker": "七号矿工",
      "location": "赤炉七号矿坑",
      "requires_flags": [
        "story.ch013.started"
      ],
      "text": "别问我昨天挖了多少矿，我昨天根本没下井。"
    },
    {
      "id": "npc_bark_035",
      "speaker": "矿工家属",
      "location": "赤炉七号矿坑",
      "requires_flags": [
        "story.ch013.done"
      ],
      "text": "他回来了。忘记我的名字没关系，我们可以再认识。"
    },
    {
      "id": "npc_bark_036",
      "speaker": "电工",
      "location": "赤炉总署",
      "requires_flags": [
        "story.ch013.done"
      ],
      "text": "有些电路接得太密了，像有人怕你看见它通向哪里。"
    },
    {
      "id": "npc_bark_037",
      "speaker": "工坊学徒",
      "location": "缇珐工坊",
      "requires_flags": [
        "story.ch014.started"
      ],
      "text": "师傅不是不睡觉，她只是永远认为再修一下就能好了。"
    },
    {
      "id": "npc_bark_038",
      "speaker": "矿工孩子",
      "location": "缇珐工坊",
      "requires_flags": [
        "story.ch014.done"
      ],
      "text": "我把蓝围巾带回家了。爸爸还记不得，但他会摸摸它。"
    },
    {
      "id": "npc_bark_039",
      "speaker": "旧机保管员",
      "location": "缇珐工坊",
      "requires_flags": [
        "story.ch014.done"
      ],
      "text": "以前机器开着我害怕，现在关了我反而想起那段声音。"
    },
    {
      "id": "npc_bark_040",
      "speaker": "百工塔学徒",
      "location": "赤炉百工塔",
      "requires_flags": [
        "story.ch015.started"
      ],
      "text": "我家没钱签终身合同，就只能在塔外看别人练习。"
    },
    {
      "id": "npc_bark_041",
      "speaker": "护盾考官",
      "location": "赤炉百工塔",
      "requires_flags": [
        "story.ch015.done"
      ],
      "text": "最好的守卫不只会举盾，还会知道什么时候让别人先走。"
    },
    {
      "id": "npc_bark_042",
      "speaker": "学徒父亲",
      "location": "赤炉百工塔",
      "requires_flags": [
        "story.ch015.done"
      ],
      "text": "第一次看儿子拿着自己画的图纸回家。"
    },
    {
      "id": "npc_bark_043",
      "speaker": "灰砂老妇",
      "location": "赤炉安置区",
      "requires_flags": [
        "story.ch016.started"
      ],
      "text": "我把老伴名字绣进袖子。每天都要摸一摸。"
    },
    {
      "id": "npc_bark_044",
      "speaker": "档案员",
      "location": "赤炉安置区",
      "requires_flags": [
        "story.ch016.done"
      ],
      "text": "今天终于可以不用独自证明昨天写过的字了。"
    },
    {
      "id": "npc_bark_045",
      "speaker": "街头居民",
      "location": "赤炉安置区",
      "requires_flags": [
        "story.ch016.done"
      ],
      "text": "热水没停，名册也没烧。看来不是非得选一样失去。"
    },
    {
      "id": "npc_bark_046",
      "speaker": "医院医师",
      "location": "赤炉主炉",
      "requires_flags": [
        "story.ch017.started"
      ],
      "text": "我们有很多伤员，可不能靠一门大炮替他们供氧。"
    },
    {
      "id": "npc_bark_047",
      "speaker": "备用电工",
      "location": "赤炉主炉",
      "requires_flags": [
        "story.ch017.done"
      ],
      "text": "那夜三分钟像三小时。再不能让医院和炮口接在同一条线上。"
    },
    {
      "id": "npc_bark_048",
      "speaker": "小孩",
      "location": "赤炉主炉",
      "requires_flags": [
        "story.ch017.done"
      ],
      "text": "那台大机器不再朝我们转头了。"
    },
    {
      "id": "npc_bark_049",
      "speaker": "熔炉工人",
      "location": "赤炉联邦",
      "requires_flags": [
        "story.ch018.started"
      ],
      "text": "说实话我们害怕停工，但也不想拿同事的过去换工资。"
    },
    {
      "id": "npc_bark_050",
      "speaker": "小摊主",
      "location": "赤炉联邦",
      "requires_flags": [
        "story.ch018.done"
      ],
      "text": "电灯不像以前那么亮，可我知道是谁把它点亮的。"
    },
    {
      "id": "npc_bark_051",
      "speaker": "学徒",
      "location": "赤炉联邦",
      "requires_flags": [
        "story.ch018.done"
      ],
      "text": "师傅说图纸可以改，我第一次敢问她为什么。"
    },
    {
      "id": "npc_bark_052",
      "speaker": "灰石村民",
      "location": "十年前·灰石边村",
      "requires_flags": [
        "story.ch019.started"
      ],
      "text": "那天我们只在屋顶放了求救烟，怎么就变成叛军？"
    },
    {
      "id": "npc_bark_053",
      "speaker": "村民后代",
      "location": "三誓边村",
      "requires_flags": [
        "story.ch019.done"
      ],
      "text": "祖父留下雷索的故事，不是叫人去崇拜英雄，是叫我们别随便点火。"
    },
    {
      "id": "npc_bark_054",
      "speaker": "旧军士",
      "location": "三誓边村",
      "requires_flags": [
        "story.ch019.done"
      ],
      "text": "我那天签了字。即使没人夸我，我也不想再说谎。"
    },
    {
      "id": "npc_bark_055",
      "speaker": "老船员",
      "location": "无名海",
      "requires_flags": [
        "story.ch020.started"
      ],
      "text": "海图边缘那块白色，像有人把家乡生生刮掉了。"
    },
    {
      "id": "npc_bark_056",
      "speaker": "渔童",
      "location": "旧航路港",
      "requires_flags": [
        "story.ch020.done"
      ],
      "text": "我也想见见朔弦说的那棵歪树。"
    },
    {
      "id": "npc_bark_057",
      "speaker": "海港贩子",
      "location": "旧航路港",
      "requires_flags": [
        "story.ch020.done"
      ],
      "text": "有人拿再多钱，也买不走你记得的味道。"
    },
    {
      "id": "npc_bark_058",
      "speaker": "药房邻居",
      "location": "晨露村",
      "requires_flags": [
        "story.ch021.started"
      ],
      "text": "那几天药房的人都头疼，只有两个孩子还说得出那个名字。"
    },
    {
      "id": "npc_bark_059",
      "speaker": "守灯人",
      "location": "晨露村",
      "requires_flags": [
        "story.ch021.done"
      ],
      "text": "岚音藏了那么久的病历，终于可以不再由她一个人承担。"
    },
    {
      "id": "npc_bark_060",
      "speaker": "小药师",
      "location": "晨露村",
      "requires_flags": [
        "story.ch021.done"
      ],
      "text": "如果有病人不肯说话，我会先陪他坐着。"
    },
    {
      "id": "npc_bark_061",
      "speaker": "灯笼商",
      "location": "王都白夜祭",
      "requires_flags": [
        "story.ch022.started"
      ],
      "text": "今年灯笼卖得不错，可王宫忽然多了好几队陌生守卫。"
    },
    {
      "id": "npc_bark_062",
      "speaker": "宫廷乐师",
      "location": "王都白夜祭",
      "requires_flags": [
        "story.ch022.done"
      ],
      "text": "有些歌能唱出来，有些人声必须先问主人能不能放给别人听。"
    },
    {
      "id": "npc_bark_063",
      "speaker": "庆典孩子",
      "location": "王都白夜祭",
      "requires_flags": [
        "story.ch022.done"
      ],
      "text": "明年白夜祭我想自己做一盏不卖的灯。"
    },
    {
      "id": "npc_bark_064",
      "speaker": "档案抄写员",
      "location": "王城档案室",
      "requires_flags": [
        "story.ch023.started"
      ],
      "text": "这架书柜又换了位置，明明昨天我还给它做过记号。"
    },
    {
      "id": "npc_bark_065",
      "speaker": "档案抄写员",
      "location": "王城档案室",
      "requires_flags": [
        "story.ch023.done"
      ],
      "text": "现在进门先登记姓名，不再有人把档案上的人当成数字。"
    },
    {
      "id": "npc_bark_066",
      "speaker": "古文研究者",
      "location": "王城档案室",
      "requires_flags": [
        "story.ch023.done"
      ],
      "text": "“自愿”旁边少了签名，居然这么多年都没人问过。"
    },
    {
      "id": "npc_bark_067",
      "speaker": "断层祭司",
      "location": "断层议会遗迹",
      "requires_flags": [
        "story.ch024.started"
      ],
      "text": "人们都说七灯是奇迹，可奇迹是给谁看的？"
    },
    {
      "id": "npc_bark_068",
      "speaker": "平民见证者",
      "location": "断层议会遗迹",
      "requires_flags": [
        "story.ch024.done"
      ],
      "text": "我们可以为当年的救人感激，也可以为当年的伤害生气。"
    },
    {
      "id": "npc_bark_069",
      "speaker": "档案守夜人",
      "location": "断层议会遗迹",
      "requires_flags": [
        "story.ch024.done"
      ],
      "text": "今天有人来献花，也有人骂了整晚。我会替他们把门留着。"
    }
  ]
}
