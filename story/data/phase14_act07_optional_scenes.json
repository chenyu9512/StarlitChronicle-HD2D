{
  "schema": "starlit.story.phase14.act07.optional.v1",
  "status": "text_only_not_runtime_bound",
  "scenes": [
    {
      "id": "ch037.p14.town",
      "chapter_id": "ch037",
      "title": "生活场景·在场的人",
      "kind": "town",
      "insert_after_scene_id": "ch037.opening",
      "required_flags": [
        "ch037.started"
      ],
      "optional": true,
      "dialogue": [
        {
          "id": "ch037.p14.town.l01",
          "speaker": "岛上老人",
          "text": "先吃饭，再说旧屋。"
        },
        {
          "id": "ch037.p14.town.l02",
          "speaker": "朔弦",
          "text": "我想看看它如今住着什么人。"
        },
        {
          "id": "ch037.p14.town.l03",
          "speaker": "岛上渔妇",
          "text": "我们怕新商会来收租。"
        },
        {
          "id": "ch037.p14.town.l04",
          "speaker": "伊泽",
          "text": "我先搬行李，不唱归乡歌。"
        },
        {
          "id": "ch037.p14.town.l05",
          "speaker": "主角",
          "text": "航路怎样开放，要听你们的。"
        },
        {
          "id": "ch037.p14.town.l06",
          "speaker": "旁白",
          "text": "歪树下又摆出一张椅子。"
        }
      ]
    },
    {
      "id": "ch037.p14.evidence",
      "chapter_id": "ch037",
      "title": "调查场景·留下的证据",
      "kind": "evidence",
      "insert_after_scene_id": "ch037.investigate",
      "required_flags": [
        "ch037.evidence"
      ],
      "optional": true,
      "dialogue": [
        {
          "id": "ch037.p14.evidence.l01",
          "speaker": "缇珐",
          "text": "漂流标向西，磁针向北。"
        },
        {
          "id": "ch037.p14.evidence.l02",
          "speaker": "朔弦",
          "text": "这条浅水线还需复测。"
        },
        {
          "id": "ch037.p14.evidence.l03",
          "speaker": "渔妇",
          "text": "航图不必画出我家门。"
        },
        {
          "id": "ch037.p14.evidence.l04",
          "speaker": "主角",
          "text": "只标救援路线与礁位。"
        },
        {
          "id": "ch037.p14.evidence.l05",
          "speaker": "伊泽",
          "text": "旧港名先写成待核实。"
        },
        {
          "id": "ch037.p14.evidence.l06",
          "speaker": "旁白",
          "text": "纸上留下一段虚线。"
        }
      ]
    },
    {
      "id": "ch038.p14.town",
      "chapter_id": "ch038",
      "title": "生活场景·在场的人",
      "kind": "town",
      "insert_after_scene_id": "ch038.opening",
      "required_flags": [
        "ch038.started"
      ],
      "optional": true,
      "dialogue": [
        {
          "id": "ch038.p14.town.l01",
          "speaker": "面包师",
          "text": "祖母过百岁生日，档案却写她三岁。"
        },
        {
          "id": "ch038.p14.town.l02",
          "speaker": "小女孩",
          "text": "该插多少根蜡烛呢？"
        },
        {
          "id": "ch038.p14.town.l03",
          "speaker": "岚音",
          "text": "先问祖母自己想怎样过。"
        },
        {
          "id": "ch038.p14.town.l04",
          "speaker": "祖母",
          "text": "一根吧，愿明年还能看见花。"
        },
        {
          "id": "ch038.p14.town.l05",
          "speaker": "玄璃",
          "text": "她的愿望不是假的。"
        },
        {
          "id": "ch038.p14.town.l06",
          "speaker": "旁白",
          "text": "蛋糕上的火光轻轻晃动。"
        }
      ]
    },
    {
      "id": "ch038.p14.evidence",
      "chapter_id": "ch038",
      "title": "调查场景·留下的证据",
      "kind": "evidence",
      "insert_after_scene_id": "ch038.investigate",
      "required_flags": [
        "ch038.evidence"
      ],
      "optional": true,
      "dialogue": [
        {
          "id": "ch038.p14.evidence.l01",
          "speaker": "修补匠",
          "text": "旧页有针孔，新页没有。"
        },
        {
          "id": "ch038.p14.evidence.l02",
          "speaker": "朔弦",
          "text": "有人塞进了改过的家谱。"
        },
        {
          "id": "ch038.p14.evidence.l03",
          "speaker": "老居民",
          "text": "我的家事请先保密。"
        },
        {
          "id": "ch038.p14.evidence.l04",
          "speaker": "岚音",
          "text": "副本可按本人意愿查阅。"
        },
        {
          "id": "ch038.p14.evidence.l05",
          "speaker": "主角",
          "text": "写下纸张与墨迹来源。"
        },
        {
          "id": "ch038.p14.evidence.l06",
          "speaker": "旁白",
          "text": "旧页上仍有无法辨认的字。"
        }
      ]
    },
    {
      "id": "ch039.p14.town",
      "chapter_id": "ch039",
      "title": "生活场景·在场的人",
      "kind": "town",
      "insert_after_scene_id": "ch039.opening",
      "required_flags": [
        "ch039.started"
      ],
      "optional": true,
      "dialogue": [
        {
          "id": "ch039.p14.town.l01",
          "speaker": "炊事员",
          "text": "热粥先给受伤的人。"
        },
        {
          "id": "ch039.p14.town.l02",
          "speaker": "诺依",
          "text": "我想再去井边听听。"
        },
        {
          "id": "ch039.p14.town.l03",
          "speaker": "岚音",
          "text": "先吃半碗，我们陪你看图。"
        },
        {
          "id": "ch039.p14.town.l04",
          "speaker": "诺依",
          "text": "妈妈说海风闻起来不一样。"
        },
        {
          "id": "ch039.p14.town.l05",
          "speaker": "雷索",
          "text": "救援架交给大人搬。"
        },
        {
          "id": "ch039.p14.town.l06",
          "speaker": "旁白",
          "text": "诺依把粥放在地图边。"
        }
      ]
    },
    {
      "id": "ch039.p14.evidence",
      "chapter_id": "ch039",
      "title": "调查场景·留下的证据",
      "kind": "evidence",
      "insert_after_scene_id": "ch039.investigate",
      "required_flags": [
        "ch039.evidence"
      ],
      "optional": true,
      "dialogue": [
        {
          "id": "ch039.p14.evidence.l01",
          "speaker": "诺依",
          "text": "车票正面是妈妈的名字。"
        },
        {
          "id": "ch039.p14.evidence.l02",
          "speaker": "缇珐",
          "text": "敲击可能沿排水管传来。"
        },
        {
          "id": "ch039.p14.evidence.l03",
          "speaker": "救援队长",
          "text": "先检查旧通道入口。"
        },
        {
          "id": "ch039.p14.evidence.l04",
          "speaker": "岚音",
          "text": "围裙还不能确定人的去向。"
        },
        {
          "id": "ch039.p14.evidence.l05",
          "speaker": "主角",
          "text": "原票由诺依自己保管。"
        },
        {
          "id": "ch039.p14.evidence.l06",
          "speaker": "旁白",
          "text": "救援图添上一处待查支路。"
        }
      ]
    },
    {
      "id": "ch040.p14.town",
      "chapter_id": "ch040",
      "title": "生活场景·在场的人",
      "kind": "town",
      "insert_after_scene_id": "ch040.opening",
      "required_flags": [
        "ch040.started"
      ],
      "optional": true,
      "dialogue": [
        {
          "id": "ch040.p14.town.l01",
          "speaker": "诺依",
          "text": "这里的钟声怎么总像有人在叹气？"
        },
        {
          "id": "ch040.p14.town.l02",
          "speaker": "伊泽",
          "text": "因为留下的歌不止一个版本。"
        },
        {
          "id": "ch040.p14.town.l03",
          "speaker": "雷索",
          "text": "先按时间顺序听。"
        },
        {
          "id": "ch040.p14.town.l04",
          "speaker": "玄璃",
          "text": "回廊无法复活过去的人。"
        },
        {
          "id": "ch040.p14.town.l05",
          "speaker": "主角",
          "text": "让记录保持原样。"
        },
        {
          "id": "ch040.p14.town.l06",
          "speaker": "旁白",
          "text": "两束影像从城门两侧升起。"
        }
      ]
    },
    {
      "id": "ch040.p14.evidence",
      "chapter_id": "ch040",
      "title": "调查场景·留下的证据",
      "kind": "evidence",
      "insert_after_scene_id": "ch040.investigate",
      "required_flags": [
        "ch040.evidence"
      ],
      "optional": true,
      "dialogue": [
        {
          "id": "ch040.p14.evidence.l01",
          "speaker": "外城证人",
          "text": "门挡住了寂潮。"
        },
        {
          "id": "ch040.p14.evidence.l02",
          "speaker": "城内证人",
          "text": "门也挡住了我们。"
        },
        {
          "id": "ch040.p14.evidence.l03",
          "speaker": "伊泽",
          "text": "这两件事可以同时存在。"
        },
        {
          "id": "ch040.p14.evidence.l04",
          "speaker": "雷索",
          "text": "记录亲见而非推断。"
        },
        {
          "id": "ch040.p14.evidence.l05",
          "speaker": "主角",
          "text": "给每份证词留出处。"
        },
        {
          "id": "ch040.p14.evidence.l06",
          "speaker": "旁白",
          "text": "双列目录第一次同时展开。"
        }
      ]
    },
    {
      "id": "ch041.p14.town",
      "chapter_id": "ch041",
      "title": "生活场景·在场的人",
      "kind": "town",
      "insert_after_scene_id": "ch041.opening",
      "required_flags": [
        "ch041.started"
      ],
      "optional": true,
      "dialogue": [
        {
          "id": "ch041.p14.town.l01",
          "speaker": "守护者",
          "text": "水渠就在树根下面。"
        },
        {
          "id": "ch041.p14.town.l02",
          "speaker": "缇珐",
          "text": "先量水位再规划线路。"
        },
        {
          "id": "ch041.p14.town.l03",
          "speaker": "诺依",
          "text": "我可以学看地图吗？"
        },
        {
          "id": "ch041.p14.town.l04",
          "speaker": "玄璃",
          "text": "第三扇门不必填满。"
        },
        {
          "id": "ch041.p14.town.l05",
          "speaker": "岚音",
          "text": "先照顾村里的日常供给。"
        },
        {
          "id": "ch041.p14.town.l06",
          "speaker": "旁白",
          "text": "村民沿着根系画出泉眼。"
        }
      ]
    },
    {
      "id": "ch041.p14.evidence",
      "chapter_id": "ch041",
      "title": "调查场景·留下的证据",
      "kind": "evidence",
      "insert_after_scene_id": "ch041.investigate",
      "required_flags": [
        "ch041.evidence"
      ],
      "optional": true,
      "dialogue": [
        {
          "id": "ch041.p14.evidence.l01",
          "speaker": "守护者",
          "text": "旧线路仍有用处。"
        },
        {
          "id": "ch041.p14.evidence.l02",
          "speaker": "缇珐",
          "text": "备用节点可单独停止。"
        },
        {
          "id": "ch041.p14.evidence.l03",
          "speaker": "玄璃",
          "text": "空门给未来留选择。"
        },
        {
          "id": "ch041.p14.evidence.l04",
          "speaker": "伊泽",
          "text": "让本地工匠保存副本。"
        },
        {
          "id": "ch041.p14.evidence.l05",
          "speaker": "主角",
          "text": "先试验，不宣布全网建成。"
        },
        {
          "id": "ch041.p14.evidence.l06",
          "speaker": "旁白",
          "text": "纸上标着尚未施工的支路。"
        }
      ]
    },
    {
      "id": "ch042.p14.town",
      "chapter_id": "ch042",
      "title": "生活场景·在场的人",
      "kind": "town",
      "insert_after_scene_id": "ch042.opening",
      "required_flags": [
        "ch042.started"
      ],
      "optional": true,
      "dialogue": [
        {
          "id": "ch042.p14.town.l01",
          "speaker": "旧洲织工",
          "text": "祖母的名字我想私下留下。"
        },
        {
          "id": "ch042.p14.town.l02",
          "speaker": "伊泽",
          "text": "可以封存，交给你信任的人。"
        },
        {
          "id": "ch042.p14.town.l03",
          "speaker": "诺依",
          "text": "我帮忙传信，不拆开看。"
        },
        {
          "id": "ch042.p14.town.l04",
          "speaker": "朔弦",
          "text": "修路的事也要问各村。"
        },
        {
          "id": "ch042.p14.town.l05",
          "speaker": "主角",
          "text": "先写每个人愿意公开的范围。"
        },
        {
          "id": "ch042.p14.town.l06",
          "speaker": "旁白",
          "text": "灯坛前分开摆出两张桌。"
        }
      ]
    },
    {
      "id": "ch042.p14.evidence",
      "chapter_id": "ch042",
      "title": "调查场景·留下的证据",
      "kind": "evidence",
      "insert_after_scene_id": "ch042.investigate",
      "required_flags": [
        "ch042.evidence"
      ],
      "optional": true,
      "dialogue": [
        {
          "id": "ch042.p14.evidence.l01",
          "speaker": "旧贵族",
          "text": "重新出现的村庄，土地怎么算？"
        },
        {
          "id": "ch042.p14.evidence.l02",
          "speaker": "岛上老人",
          "text": "我们先确认回家的路。"
        },
        {
          "id": "ch042.p14.evidence.l03",
          "speaker": "雷索",
          "text": "地契与记忆不能混作一项权利。"
        },
        {
          "id": "ch042.p14.evidence.l04",
          "speaker": "玄璃",
          "text": "所有人都有表达意见的资格。"
        },
        {
          "id": "ch042.p14.evidence.l05",
          "speaker": "伊泽",
          "text": "原始证词留给当事人。"
        },
        {
          "id": "ch042.p14.evidence.l06",
          "speaker": "旁白",
          "text": "争议表与人名表分开放好。"
        }
      ]
    }
  ]
}
