  "choice_followups": [
    {
      "id": "followup.ch007.listen",
      "origin_chapter": "ch007",
      "region": "三誓王都·外廷",
      "when": {
        "required_flag": "story.ch007.done",
        "state_equals": {
          "key": "world.ch007.approach",
          "value": "open_registry"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch007.listen.l01",
          "speaker": "救济员",
          "text": "三国救助名册终于贴上告示墙了，签字的代表也都写了姓名。"
        },
        {
          "id": "followup.ch007.listen.l02",
          "speaker": "岚音",
          "text": "名单可以核对，但病人的详细病情不该随手贴出去。"
        },
        {
          "id": "followup.ch007.listen.l03",
          "speaker": "救济员",
          "text": "我会让求助者单独登记，不能让公开变成另一种伤害。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch007.act",
      "origin_chapter": "ch007",
      "region": "三誓王都·外廷",
      "when": {
        "required_flag": "story.ch007.done",
        "state_equals": {
          "key": "world.ch007.approach",
          "value": "protect_privacy"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch007.act.l01",
          "speaker": "救济员",
          "text": "药已经送到最急需的病房，家属的信息由医师妥善封存。"
        },
        {
          "id": "followup.ch007.act.l02",
          "speaker": "岚音",
          "text": "我们没有逃避追查，只是先保护不愿公开的人。"
        },
        {
          "id": "followup.ch007.act.l03",
          "speaker": "救济员",
          "text": "等他们准备好，我会带着授权的副本再去申请援助。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch008.listen",
      "origin_chapter": "ch008",
      "region": "灰鹰商道",
      "when": {
        "required_flag": "story.ch008.done",
        "state_equals": {
          "key": "world.ch008.approach",
          "value": "evidence_first"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch008.listen.l01",
          "speaker": "车队队长",
          "text": "你们留下的军械编号和运输单已经送到两岸调查员手里。"
        },
        {
          "id": "followup.ch008.listen.l02",
          "speaker": "雷索",
          "text": "要让居民知道谁发了假命令，不能只抓一个背锅的车夫。"
        },
        {
          "id": "followup.ch008.listen.l03",
          "speaker": "车队队长",
          "text": "今天的第一辆粮车终于没有押着囚犯过桥。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch008.act",
      "origin_chapter": "ch008",
      "region": "灰鹰商道",
      "when": {
        "required_flag": "story.ch008.done",
        "state_equals": {
          "key": "world.ch008.approach",
          "value": "rescue_first"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch008.act.l01",
          "speaker": "对岸老妇",
          "text": "我们先把孩子与伤员安置好了，证人也安全抵达。"
        },
        {
          "id": "followup.ch008.act.l02",
          "speaker": "雷索",
          "text": "撤离记录和军械编号都留着，救人不是放过造假的人。"
        },
        {
          "id": "followup.ch008.act.l03",
          "speaker": "老妇",
          "text": "等所有人喝上热汤，我愿说出那夜看见的车牌。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch009.listen",
      "origin_chapter": "ch009",
      "region": "三誓王都·审判厅",
      "when": {
        "required_flag": "story.ch009.done",
        "state_equals": {
          "key": "world.ch009.approach",
          "value": "safe_home"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch009.listen.l01",
          "speaker": "幸存老妇",
          "text": "孙子今晚在邻村住下，终于不必睡在法庭门口。"
        },
        {
          "id": "followup.ch009.listen.l02",
          "speaker": "雷索",
          "text": "证词可以再宣读，人的安全不能等下一次开庭。"
        },
        {
          "id": "followup.ch009.listen.l03",
          "speaker": "老妇",
          "text": "他愿意回来作证，只求先把伤养好。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch009.act",
      "origin_chapter": "ch009",
      "region": "三誓王都·审判厅",
      "when": {
        "required_flag": "story.ch009.done",
        "state_equals": {
          "key": "world.ch009.approach",
          "value": "public_witness"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch009.act.l01",
          "speaker": "法庭书记",
          "text": "法庭公开签了证人保护令，今天连旁听席都能看到副本。"
        },
        {
          "id": "followup.ch009.act.l02",
          "speaker": "雷索",
          "text": "承诺还需有人监督执行，不能只为今日审判做样子。"
        },
        {
          "id": "followup.ch009.act.l03",
          "speaker": "书记",
          "text": "我会记录每次访客接触证人的理由。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch010.listen",
      "origin_chapter": "ch010",
      "region": "三国边境议事站",
      "when": {
        "required_flag": "story.ch010.done",
        "state_equals": {
          "key": "world.ch010.approach",
          "value": "joint_audit"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch010.listen.l01",
          "speaker": "使者",
          "text": "粮车由三方共同点验，份额和人数写在同一张公开表上。"
        },
        {
          "id": "followup.ch010.listen.l02",
          "speaker": "雷索",
          "text": "清点不是争输赢，缺粮的村子必须能提出异议。"
        },
        {
          "id": "followup.ch010.listen.l03",
          "speaker": "使者",
          "text": "三国第一次把“少了多少”交给同一组人回答。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch010.act",
      "origin_chapter": "ch010",
      "region": "三国边境议事站",
      "when": {
        "required_flag": "story.ch010.done",
        "state_equals": {
          "key": "world.ch010.approach",
          "value": "medical_priority"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch010.act.l01",
          "speaker": "医疗队长",
          "text": "孩子们先吃上了饭，救护帐篷里也有清水。"
        },
        {
          "id": "followup.ch010.act.l02",
          "speaker": "岚音",
          "text": "紧急分配留下记录，后续再按实际人口补齐。"
        },
        {
          "id": "followup.ch010.act.l03",
          "speaker": "医疗队长",
          "text": "没有人因缺一枚官印被挡在救护队外。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch011.listen",
      "origin_chapter": "ch011",
      "region": "旧盟约桥",
      "when": {
        "required_flag": "story.ch011.done",
        "state_equals": {
          "key": "world.ch011.approach",
          "value": "orders_first"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch011.listen.l01",
          "speaker": "边境档案员",
          "text": "伪造军令的原稿公开后，两岸士兵终于知道是谁在骗他们。"
        },
        {
          "id": "followup.ch011.listen.l02",
          "speaker": "雷索",
          "text": "别让查出源头变成对普通卫兵报复的借口。"
        },
        {
          "id": "followup.ch011.listen.l03",
          "speaker": "档案员",
          "text": "证据副本各存一份，有人删改也能查出。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch011.act",
      "origin_chapter": "ch011",
      "region": "旧盟约桥",
      "when": {
        "required_flag": "story.ch011.done",
        "state_equals": {
          "key": "world.ch011.approach",
          "value": "bridge_first"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch011.act.l01",
          "speaker": "桥头工兵",
          "text": "桥底的炸药已拆下，居民先撤到了安全的河岸。"
        },
        {
          "id": "followup.ch011.act.l02",
          "speaker": "岚音",
          "text": "被炸伤的人不必等军令调查结束才能治疗。"
        },
        {
          "id": "followup.ch011.act.l03",
          "speaker": "工兵",
          "text": "那份假命令还在，我们会在重开桥前交出去。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch012.listen",
      "origin_chapter": "ch012",
      "region": "律序母灯坛",
      "when": {
        "required_flag": "story.ch012.done",
        "state_equals": {
          "key": "world.ch012.approach",
          "value": "shared_oath"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch012.listen.l01",
          "speaker": "民众代表",
          "text": "王族和百姓都在灯前签了誓词，纸上并排写着各自的责任。"
        },
        {
          "id": "followup.ch012.listen.l02",
          "speaker": "雷索",
          "text": "誓言不是免于追责的冠冕，明天仍可以质询。"
        },
        {
          "id": "followup.ch012.listen.l03",
          "speaker": "民众代表",
          "text": "至少这回我们也有资格在原件上落笔。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch012.act",
      "origin_chapter": "ch012",
      "region": "律序母灯坛",
      "when": {
        "required_flag": "story.ch012.done",
        "state_equals": {
          "key": "world.ch012.approach",
          "value": "public_review"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch012.act.l01",
          "speaker": "质询席书记",
          "text": "第一场公开答询定在下月，三廷必须派能负责的人到场。"
        },
        {
          "id": "followup.ch012.act.l02",
          "speaker": "雷索",
          "text": "若问到难处，别拿王冠说“无需解释”。"
        },
        {
          "id": "followup.ch012.act.l03",
          "speaker": "书记",
          "text": "会议记录会送到各村，不再只留在宫里。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch013.listen",
      "origin_chapter": "ch013",
      "region": "赤炉联邦·七号矿坑",
      "when": {
        "required_flag": "story.ch013.done",
        "state_equals": {
          "key": "world.ch013.approach",
          "value": "rescue"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch013.listen.l01",
          "speaker": "矿工阿锤",
          "text": "最后一个被困的人出来了，井口的工牌还在。"
        },
        {
          "id": "followup.ch013.listen.l02",
          "speaker": "缇珐",
          "text": "现场先别清走，等家属看过再决定哪些证物可交调查。"
        },
        {
          "id": "followup.ch013.listen.l03",
          "speaker": "阿锤",
          "text": "今日有人记住我们回来的时刻，也记住没回来的。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch013.act",
      "origin_chapter": "ch013",
      "region": "赤炉联邦·七号矿坑",
      "when": {
        "required_flag": "story.ch013.done",
        "state_equals": {
          "key": "world.ch013.approach",
          "value": "evidence"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch013.act.l01",
          "speaker": "矿工家属",
          "text": "能源的账本和失踪名单已经收到，我们自己能核对每一页。"
        },
        {
          "id": "followup.ch013.act.l02",
          "speaker": "缇珐",
          "text": "证据不该只存在工厂的保险柜。"
        },
        {
          "id": "followup.ch013.act.l03",
          "speaker": "家属",
          "text": "明天还要找人救援，这两件事我们都不会放下。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch014.listen",
      "origin_chapter": "ch014",
      "region": "赤炉工坊·试验台",
      "when": {
        "required_flag": "story.ch014.done",
        "state_equals": {
          "key": "world.ch014.approach",
          "value": "family_copy"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch014.listen.l01",
          "speaker": "受害者家属",
          "text": "我们和医师各拿到一份机器检验记录，名字没有再被删掉。"
        },
        {
          "id": "followup.ch014.listen.l02",
          "speaker": "缇珐",
          "text": "记录上的故障由我负责解释，不让工程术语遮住发生过的事。"
        },
        {
          "id": "followup.ch014.listen.l03",
          "speaker": "家属",
          "text": "我仍然生气，但至少可以亲手追问。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch014.act",
      "origin_chapter": "ch014",
      "region": "赤炉工坊·试验台",
      "when": {
        "required_flag": "story.ch014.done",
        "state_equals": {
          "key": "world.ch014.approach",
          "value": "medical_seal"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch014.act.l01",
          "speaker": "医师",
          "text": "原始记忆抽取记录封存在医疗证据柜，工厂不能私自取回。"
        },
        {
          "id": "followup.ch014.act.l02",
          "speaker": "岚音",
          "text": "病人的隐私仍由本人决定，封存不是把证据锁到再也查不到。"
        },
        {
          "id": "followup.ch014.act.l03",
          "speaker": "医师",
          "text": "独立检查将按约定日期向当事人报告。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch015.listen",
      "origin_chapter": "ch015",
      "region": "赤炉联邦·百工塔",
      "when": {
        "required_flag": "story.ch015.done",
        "state_equals": {
          "key": "world.ch015.approach",
          "value": "guild"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch015.listen.l01",
          "speaker": "学徒",
          "text": "三家工会共同保管百工图纸，没人能再靠一道门收走所有知识。"
        },
        {
          "id": "followup.ch015.listen.l02",
          "speaker": "缇珐",
          "text": "危险构件应共同监管，基础技艺则要允许学徒理解。"
        },
        {
          "id": "followup.ch015.listen.l03",
          "speaker": "学徒",
          "text": "师傅说下届试炼会考怎样合作修理，而不只考谁砸得快。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch015.act",
      "origin_chapter": "ch015",
      "region": "赤炉联邦·百工塔",
      "when": {
        "required_flag": "story.ch015.done",
        "state_equals": {
          "key": "world.ch015.approach",
          "value": "open_class"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch015.act.l01",
          "speaker": "学徒教师",
          "text": "公开课堂报名的人比我们预计的多，有老矿工也有孩子。"
        },
        {
          "id": "followup.ch015.act.l02",
          "speaker": "缇珐",
          "text": "先教安全和用途，别让新技术又把人当试验品。"
        },
        {
          "id": "followup.ch015.act.l03",
          "speaker": "教师",
          "text": "有人今天第一次自己修好一盏家里的灯。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch016.listen",
