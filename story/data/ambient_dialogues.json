      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch016.act.l01",
          "speaker": "工人代表",
          "text": "停用旧能源的时间表和临时补偿贴出来了，家属能逐项核对。"
        },
        {
          "id": "followup.ch016.act.l02",
          "speaker": "缇珐",
          "text": "这只是开始；不能因贴出一张表就当作赔偿完毕。"
        },
        {
          "id": "followup.ch016.act.l03",
          "speaker": "工人代表",
          "text": "至少下次延期，我们知道该找谁问。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch017.listen",
      "origin_chapter": "ch017",
      "region": "赤炉主炉",
      "when": {
        "required_flag": "story.ch017.done",
        "state_equals": {
          "key": "world.ch017.approach",
          "value": "hospital_backup"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch017.listen.l01",
          "speaker": "医院院长",
          "text": "临时电源撑过了整晚，手术室没有因熔炉事故停摆。"
        },
        {
          "id": "followup.ch017.listen.l02",
          "speaker": "缇珐",
          "text": "我会把供电转接图留给夜班维修工，不让医院只靠我一人。"
        },
        {
          "id": "followup.ch017.listen.l03",
          "speaker": "院长",
          "text": "病人不需要知道谁赢了战斗，只想明天继续接受治疗。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch017.act",
      "origin_chapter": "ch017",
      "region": "赤炉主炉",
      "when": {
        "required_flag": "story.ch017.done",
        "state_equals": {
          "key": "world.ch017.approach",
          "value": "weapon_lock"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch017.act.l01",
          "speaker": "工厂守卫",
          "text": "主炉炮口锁死了，居民撤离车队终于不用绕过火线。"
        },
        {
          "id": "followup.ch017.act.l02",
          "speaker": "雷索",
          "text": "武装解除后也要警戒余热，别让工人现在返岗。"
        },
        {
          "id": "followup.ch017.act.l03",
          "speaker": "守卫",
          "text": "这次轮到我们守住安全出口，而不是执行封门命令。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch018.listen",
      "origin_chapter": "ch018",
      "region": "炉心母灯室",
      "when": {
        "required_flag": "story.ch018.done",
        "state_equals": {
          "key": "world.ch018.approach",
          "value": "victim_oversight"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch018.listen.l01",
          "speaker": "矿工遗属",
          "text": "停工和补偿方案有家属签字，不会再让厂方单独宣布“已处理”。"
        },
        {
          "id": "followup.ch018.listen.l02",
          "speaker": "缇珐",
          "text": "你们发现遗漏，可以要求复核，不用先证明自己足够悲伤。"
        },
        {
          "id": "followup.ch018.listen.l03",
          "speaker": "遗属",
          "text": "我们仍有许多问题，但这回能找得到负责的人。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch018.act",
      "origin_chapter": "ch018",
      "region": "炉心母灯室",
      "when": {
        "required_flag": "story.ch018.done",
        "state_equals": {
          "key": "world.ch018.approach",
          "value": "energy_transparency"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch018.act.l01",
          "speaker": "医院技师",
          "text": "替代能源每项成本和试验风险都写在公告上了。"
        },
        {
          "id": "followup.ch018.act.l02",
          "speaker": "缇珐",
          "text": "性能不够时要说明，不要偷拿人的记忆补电。"
        },
        {
          "id": "followup.ch018.act.l03",
          "speaker": "技师",
          "text": "原来一座城也能在知道代价的情况下决定要不要开灯。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch019.listen",
      "origin_chapter": "ch019",
      "region": "十年前·肃清边村",
      "when": {
        "required_flag": "story.ch019.done",
        "state_equals": {
          "key": "world.ch019.approach",
          "value": "villagers"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch019.listen.l01",
          "speaker": "边村后人",
          "text": "那道没执行的军令留在村里，旁边刻着撤走的居民姓名。"
        },
        {
          "id": "followup.ch019.listen.l02",
          "speaker": "雷索",
          "text": "不要只把违令的人写成英雄，当年被威胁的人也要有声音。"
        },
        {
          "id": "followup.ch019.listen.l03",
          "speaker": "后人",
          "text": "家属还能继续补充自己的见证。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch019.act",
      "origin_chapter": "ch019",
      "region": "十年前·肃清边村",
      "when": {
        "required_flag": "story.ch019.done",
        "state_equals": {
          "key": "world.ch019.approach",
          "value": "witness_soldier"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch019.act.l01",
          "speaker": "老军士",
          "text": "我们共同签了当年抗命的证词，没有人能再说那夜只有一个人看见。"
        },
        {
          "id": "followup.ch019.act.l02",
          "speaker": "雷索",
          "text": "愿意签名不等于免于过去的责任。"
        },
        {
          "id": "followup.ch019.act.l03",
          "speaker": "老军士",
          "text": "这次我准备亲自回答后代的问题。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch020.listen",
      "origin_chapter": "ch020",
      "region": "七年前·无名海",
      "when": {
        "required_flag": "story.ch020.done",
        "state_equals": {
          "key": "world.ch020.approach",
          "value": "keep_log"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch020.listen.l01",
          "speaker": "朔弦",
          "text": "船长原日志完好保存，里面也有我不愿提起的运输记录。"
        },
        {
          "id": "followup.ch020.listen.l02",
          "speaker": "船坞老人",
          "text": "有人看了会生气，你仍打算交出去？"
        },
        {
          "id": "followup.ch020.listen.l03",
          "speaker": "朔弦",
          "text": "是。我得承担它写着我的那几页。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch020.act",
      "origin_chapter": "ch020",
      "region": "七年前·无名海",
      "when": {
        "required_flag": "story.ch020.done",
        "state_equals": {
          "key": "world.ch020.approach",
          "value": "stars_first"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch020.act.l01",
          "speaker": "朔弦",
          "text": "我先描下了能救命的星位，没让大家为了搬整箱旧账本留在险海。"
        },
        {
          "id": "followup.ch020.act.l02",
          "speaker": "老水手",
          "text": "日志的失踪页也别就这样算了。"
        },
        {
          "id": "followup.ch020.act.l03",
          "speaker": "朔弦",
          "text": "我记着，等下一趟安全航行再去找。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch021.listen",
      "origin_chapter": "ch021",
      "region": "十年前·晨露药房",
      "when": {
        "required_flag": "story.ch021.done",
        "state_equals": {
          "key": "world.ch021.approach",
          "value": "need_time"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch021.listen.l01",
          "speaker": "岚音",
          "text": "你说需要时间，我会把完整病历留下，不追问什么时候原谅。"
        },
        {
          "id": "followup.ch021.listen.l02",
          "speaker": "主角",
          "text": "我愿意继续同行，但今晚还无法像从前那样说话。"
        },
        {
          "id": "followup.ch021.listen.l03",
          "speaker": "岚音",
          "text": "我知道。明天的药我照样准备。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch021.act",
      "origin_chapter": "ch021",
      "region": "十年前·晨露药房",
      "when": {
        "required_flag": "story.ch021.done",
        "state_equals": {
          "key": "world.ch021.approach",
          "value": "read_together"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch021.act.l01",
          "speaker": "主角",
          "text": "我们把病历的缺页和澄舟留下的字逐项核对了。"
        },
        {
          "id": "followup.ch021.act.l02",
          "speaker": "岚音",
          "text": "我不会再替你决定哪些线索是你承受不了的。"
        },
        {
          "id": "followup.ch021.act.l03",
          "speaker": "主角",
          "text": "答案还没出来，但至少我们拿的是同一份原件。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch022.listen",
      "origin_chapter": "ch022",
      "region": "三誓王都·灯会",
      "when": {
        "required_flag": "story.ch022.done",
        "state_equals": {
          "key": "world.ch022.approach",
          "value": "anonymous_release"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch022.listen.l01",
          "speaker": "灯会证人",
          "text": "账册公开了，但没有把我的住址和伤病经历贴在街口。"
        },
        {
          "id": "followup.ch022.listen.l02",
          "speaker": "岚音",
          "text": "愿意提供证据的人，不必连同隐私一起交出去。"
        },
        {
          "id": "followup.ch022.listen.l03",
          "speaker": "证人",
          "text": "今年我终于也能走进灯会，而不用躲着看。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch022.act",
      "origin_chapter": "ch022",
      "region": "三誓王都·灯会",
      "when": {
        "required_flag": "story.ch022.done",
        "state_equals": {
          "key": "world.ch022.approach",
          "value": "safe_archive"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch022.act.l01",
          "speaker": "档案员",
          "text": "证人先安全离开王都，原件已经进入独立档案柜。"
        },
        {
          "id": "followup.ch022.act.l02",
          "speaker": "雷索",
          "text": "注意谁有权复制资料，也要留一份交给本人。"
        },
        {
          "id": "followup.ch022.act.l03",
          "speaker": "档案员",
          "text": "等她愿意公开时，证据还在。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch023.listen",
      "origin_chapter": "ch023",
      "region": "王城地下档案室",
      "when": {
        "required_flag": "story.ch023.done",
        "state_equals": {
          "key": "world.ch023.approach",
          "value": "protect_names"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch023.listen.l01",
          "speaker": "档案访客",
          "text": "我们拿到匿名查阅凭证，不用留下每个亲人的真实住址。"
        },
        {
          "id": "followup.ch023.listen.l02",
          "speaker": "岚音",
          "text": "保护身份不是阻止查证，档案仍需有核验来源。"
        },
        {
          "id": "followup.ch023.listen.l03",
          "speaker": "访客",
          "text": "这回没人能凭登记册追到我们的家。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch023.act",
      "origin_chapter": "ch023",
      "region": "王城地下档案室",
      "when": {
        "required_flag": "story.ch023.done",
        "state_equals": {
          "key": "world.ch023.approach",
          "value": "save_original"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch023.act.l01",
          "speaker": "档案员",
          "text": "没有签名的建灯原页保住了，纸背的磨痕也完整留下。"
        },
        {
          "id": "followup.ch023.act.l02",
          "speaker": "主角",
          "text": "不能因为看不到名字就认定它不重要。"
        },
        {
          "id": "followup.ch023.act.l03",
          "speaker": "档案员",
          "text": "后续可以用别的文献交叉比对，不必改写原件。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch024.listen",
      "origin_chapter": "ch024",
      "region": "断层议会遗迹",
      "when": {
        "required_flag": "story.ch024.done",
        "state_equals": {
          "key": "world.ch024.approach",
          "value": "public_hearing"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch024.listen.l01",
          "speaker": "平民代表",
          "text": "第一场守灯听证会公开举办，受影响的工人与家属都能发问。"
        },
        {
          "id": "followup.ch024.listen.l02",
          "speaker": "主角",
          "text": "不必在会上赞成我，我们同样会继续查灯。"
        },
        {
          "id": "followup.ch024.listen.l03",
          "speaker": "代表",
          "text": "这回轮到坐在最下面的人提出问题。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
    {
      "id": "followup.ch024.act",
      "origin_chapter": "ch024",
      "region": "断层议会遗迹",
      "when": {
        "required_flag": "story.ch024.done",
        "state_equals": {
          "key": "world.ch024.approach",
          "value": "families_first"
        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch024.act.l01",
          "speaker": "遗属代表",
          "text": "我们先看过证据，也选好了哪些部分可以公开。"
        },
        {
          "id": "followup.ch024.act.l02",
          "speaker": "岚音",
          "text": "他们有权先得到解释，不该从城里流言得知亲人的经历。"
        },
        {
          "id": "followup.ch024.act.l03",
          "speaker": "代表",
          "text": "等公开给各地时，请把我们提出的补充意见也写上。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    }
  ],
  "camp_interludes": [
    {
      "id": "camp.001",
      "title": "路边留宿",
      "available_after_chapter": "ch008",
      "requires_flags": [
        "story.ch008.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.001.l01",
          "speaker": "岚音",
          "text": "饭锅里还有一点粥，谁没吃晚饭？"
        },
        {
          "id": "camp.001.l02",
          "speaker": "雷索",
          "text": "先给护粮的车夫。他今天一天都没坐下。"
        },
        {
          "id": "camp.001.l03",
          "speaker": "朔弦",
          "text": "你们两个总把自己的份让出去，我只好再添水了。"
        },
        {
          "id": "camp.001.l04",
          "speaker": "主角",
          "text": "水加太多，明天就成汤了。"
        }
      ]
    },
    {
      "id": "camp.002",
      "title": "审判前夜",
      "available_after_chapter": "ch009",
      "requires_flags": [
        "story.ch009.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.002.l01",
          "speaker": "雷索",
          "text": "我知道明天可能会输。"
        },
        {
          "id": "camp.002.l02",
          "speaker": "岚音",
          "text": "那你为什么还站到这里？"
        },
        {
          "id": "camp.002.l03",
          "speaker": "雷索",
          "text": "因为如果我不说，活下来的人还要替我说。"
        },
        {
          "id": "camp.002.l04",
          "speaker": "主角",
          "text": "那明天我们一起把话说完整。"
        }
      ]
    },
    {
      "id": "camp.003",
      "title": "三国小食",
      "available_after_chapter": "ch012",
      "requires_flags": [
        "story.ch012.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.003.l01",
          "speaker": "朔弦",
          "text": "三种烤饼放在同一桌上，谁都说自己的最好。"
        },
        {
          "id": "camp.003.l02",
          "speaker": "雷索",
          "text": "中间那种更耐放，行军时合适。"
        },
        {
          "id": "camp.003.l03",
          "speaker": "岚音",
          "text": "你评价食物时就不能先说味道吗？"
        },
        {
          "id": "camp.003.l04",
          "speaker": "雷索",
          "text": "……好吃。这样行吗？"
        }
      ]
    },
    {
      "id": "camp.004",
      "title": "赤炉的夜",
      "available_after_chapter": "ch013",
      "requires_flags": [
        "story.ch013.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.004.l01",
          "speaker": "缇珐",
          "text": "城里的人睡着，炉子却必须继续烧。"
        },
        {
          "id": "camp.004.l02",
          "speaker": "朔弦",
          "text": "你也必须一直干活？"
        },
        {
          "id": "camp.004.l03",
          "speaker": "缇珐",
          "text": "有人这样要求，我已经习惯了。"
        },
        {
          "id": "camp.004.l04",
          "speaker": "岚音",
          "text": "习惯不代表合理。今晚轮到你休息。"
        }
      ]
    },
    {
      "id": "camp.005",
      "title": "蓝围巾",
      "available_after_chapter": "ch014",
      "requires_flags": [
        "story.ch014.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.005.l01",
          "speaker": "缇珐",
          "text": "我对机器的记忆比对人清楚，这算不算很糟？"
        },
        {
          "id": "camp.005.l02",
          "speaker": "主角",
          "text": "从现在起，可以试着先记住人的名字。"
        },
        {
          "id": "camp.005.l03",
          "speaker": "缇珐",
          "text": "那个矿工的孩子叫小石头。我记住了。"
        },
        {
          "id": "camp.005.l04",
          "speaker": "岚音",
          "text": "他有真正的名字。明天我们去问他。"
        }
      ]
    },
    {
      "id": "camp.006",
      "title": "搬运煤袋",
      "available_after_chapter": "ch016",
      "requires_flags": [
        "story.ch016.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.006.l01",
          "speaker": "朔弦",
          "text": "我这辈子最后一次搬煤，真的。"
        },
        {
          "id": "camp.006.l02",
          "speaker": "雷索",
          "text": "半个时辰前你也是这样说的。"
        },
        {
          "id": "camp.006.l03",
          "speaker": "缇珐",
          "text": "你们把煤堆在通风口，我还得重搬。"
        },
        {
          "id": "camp.006.l04",
          "speaker": "主角",
          "text": "那今晚先把人和煤都摆对位置。"
        }
      ]
    },
    {
      "id": "camp.007",
      "title": "炉城的第一顿饭",
      "available_after_chapter": "ch018",
      "requires_flags": [
        "story.ch018.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.007.l01",
          "speaker": "缇珐",
          "text": "我总觉得机器会在我们吃饭时坏掉。"
        },
        {
          "id": "camp.007.l02",
          "speaker": "岚音",
          "text": "它若真坏了，我们吃完才有力气修。"
        },
        {
          "id": "camp.007.l03",
          "speaker": "朔弦",
          "text": "这句我要刻在工作台上。"
        },
        {
          "id": "camp.007.l04",
          "speaker": "雷索",
          "text": "别刻。饭菜会凉。"
        }
      ]
    },
    {
      "id": "camp.008",
      "title": "旧披风",
      "available_after_chapter": "ch019",
      "requires_flags": [
        "story.ch019.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.008.l01",
          "speaker": "雷索",
          "text": "很多年后，那孩子把披风还给了我。"
        },
        {
          "id": "camp.008.l02",
          "speaker": "岚音",
          "text": "你收下了吗？"
        },
        {
          "id": "camp.008.l03",
          "speaker": "雷索",
          "text": "收下了。然后又送给了一个怕冷的孩子。"
        },
        {
          "id": "camp.008.l04",
          "speaker": "主角",
          "text": "看来那件披风比你走过更远的路。"
        }
      ]
    },
    {
      "id": "camp.009",
      "title": "无人知晓的岛",
      "available_after_chapter": "ch020",
      "requires_flags": [
        "story.ch020.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.009.l01",
          "speaker": "朔弦",
          "text": "我记得故乡的树歪向左边。"
        },
        {
          "id": "camp.009.l02",
          "speaker": "岚音",
          "text": "也许多年后会歪向右边呢。"
        },
        {
          "id": "camp.009.l03",
          "speaker": "朔弦",
          "text": "那我也认得。树长歪了，家还是家。"
        },
        {
          "id": "camp.009.l04",
          "speaker": "主角",
          "text": "等到了那座岛，你可以慢慢看。"
        }
      ]
    },
    {
      "id": "camp.010",
      "title": "病历",
      "available_after_chapter": "ch021",
      "requires_flags": [
        "story.ch021.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.010.l01",
          "speaker": "岚音",
          "text": "你要是想一个人待会儿，我就在营火那边。"
        },
        {
          "id": "camp.010.l02",
          "speaker": "主角",
          "text": "不用，我只是不知道该从哪一页看起。"
        },
        {
          "id": "camp.010.l03",
          "speaker": "岚音",
          "text": "从你愿意看的那一页。我们不赶时间。"
        },
        {
          "id": "camp.010.l04",
          "speaker": "雷索",
          "text": "今晚谁都不该催你。"
        }
      ]
    },
    {
      "id": "camp.011",
      "title": "比剑还锋利的东西",
      "available_after_chapter": "ch023",
      "requires_flags": [
        "story.ch023.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.011.l01",
          "speaker": "雷索",
          "text": "以前我总认为，伤害人的是刀。"
        },
        {
          "id": "camp.011.l02",
          "speaker": "朔弦",
          "text": "改掉一行档案，也能让一个人无家可归。"
        },
        {
          "id": "camp.011.l03",
          "speaker": "岚音",
          "text": "医院也是，擦掉病历就像擦掉病人。"
        },
        {
          "id": "camp.011.l04",
          "speaker": "主角",
          "text": "所以该留下的证据，一页也别丢。"
        }
      ]
    },
    {
      "id": "camp.012",
      "title": "海风将至",
      "available_after_chapter": "ch024",
      "requires_flags": [
        "story.ch024.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.012.l01",
          "speaker": "朔弦",
          "text": "听说海歌港有一艘旧船还没人肯买。"
        },
        {
          "id": "camp.012.l02",
          "speaker": "雷索",
          "text": "为什么？"
        },
        {
          "id": "camp.012.l03",
          "speaker": "朔弦",
          "text": "漏水、破帆、还有船主欠了不少钱。"
        },
        {
          "id": "camp.012.l04",
          "speaker": "岚音",
          "text": "听起来非常适合你。"
        }
      ]
    },
    {
      "id": "camp.013",
      "title": "逐星号的晾衣绳",
      "available_after_chapter": "ch026",
      "requires_flags": [
        "story.ch026.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.013.l01",
          "speaker": "朔弦",
          "text": "谁把药草挂到了船头？"
        },
        {
          "id": "camp.013.l02",
          "speaker": "岚音",
          "text": "需要海风晾干。你不是说今天风向最好吗？"
        },
        {
          "id": "camp.013.l03",
          "speaker": "朔弦",
          "text": "我说的是航海，不是晾衣服。"
        },
        {
          "id": "camp.013.l04",
          "speaker": "主角",
          "text": "现在至少知道哪边风大了。"
        }
      ]
    },
    {
      "id": "camp.014",
      "title": "风航灯下",
      "available_after_chapter": "ch030",
      "requires_flags": [
        "story.ch030.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.014.l01",
          "speaker": "伊泽",
          "text": "一盏灯竟能照出这么多条回家的航路。"
        },
        {
          "id": "camp.014.l02",
          "speaker": "朔弦",
          "text": "因为大家愿意把航路告诉别人。"
        },
        {
          "id": "camp.014.l03",
          "speaker": "岚音",
          "text": "如果有人从来没有家呢？"
        },
        {
          "id": "camp.014.l04",
          "speaker": "伊泽",
          "text": "那我们就先写一首关于找到落脚之处的歌。"
        }
      ]
    },
    {
      "id": "camp.015",
      "title": "现实的雨",
      "available_after_chapter": "ch036",
      "requires_flags": [
        "story.ch036.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.015.l01",
          "speaker": "玄璃",
          "text": "现实里的雨会把鞋子弄湿，真麻烦。"
        },
        {
          "id": "camp.015.l02",
          "speaker": "岚音",
          "text": "你也可以抱怨它，这很正常。"
        },
        {
          "id": "camp.015.l03",
          "speaker": "玄璃",
          "text": "梦里的雨从不让我冷。"
        },
        {
          "id": "camp.015.l04",
          "speaker": "主角",
          "text": "所以我们才需要在雨停后烤火。"
        }
      ]
    },
    {
      "id": "camp.016",
      "title": "给诺依讲故事",
      "available_after_chapter": "ch042",
      "requires_flags": [
        "story.ch042.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.016.l01",
          "speaker": "诺依",
          "text": "世界上真的有从地图上掉下来的岛吗？"
        },
        {
          "id": "camp.016.l02",
          "speaker": "朔弦",
          "text": "有，掉下来时还差点砸中我。"
        },
        {
          "id": "camp.016.l03",
          "speaker": "岚音",
          "text": "别吓他，岛不是那样掉的。"
        },
        {
          "id": "camp.016.l04",
          "speaker": "主角",
          "text": "先吃饭。等吃完我再把故事讲完整。"
        }
      ]
    },
    {
      "id": "camp.017",
      "title": "撤离营火",
      "available_after_chapter": "ch048",
      "requires_flags": [
        "story.ch048.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.017.l01",
          "speaker": "雷索",
          "text": "最后一辆马车已经上路。"
        },
        {
          "id": "camp.017.l02",
          "speaker": "岚音",
          "text": "还有人没找到，但我们不能再把孩子留在这里。"
        },
        {
          "id": "camp.017.l03",
          "speaker": "主角",
          "text": "我明白。"
        },
        {
          "id": "camp.017.l04",
          "speaker": "朔弦",
          "text": "别看我。我也不知道这次该说什么。"
        }
      ]
    },
    {
      "id": "camp.018",
      "title": "旧照片",
      "available_after_chapter": "ch049",
      "requires_flags": [
        "story.ch049.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.018.l01",
          "speaker": "诺依",
          "text": "他们说你年轻时连饭都顾不上吃。"
        },
        {
          "id": "camp.018.l02",
          "speaker": "主角",
          "text": "那只是朔弦把自己的份藏起来了。"
        },
        {
          "id": "camp.018.l03",
          "speaker": "诺依",
          "text": "所以传说里有一半是他编的？"
        },
        {
          "id": "camp.018.l04",
          "speaker": "主角",
          "text": "不止一半。"
        }
      ]
    },
    {
      "id": "camp.019",
      "title": "旧灯塔旁",
      "available_after_chapter": "ch053",
      "requires_flags": [
        "story.ch053.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.019.l01",
          "speaker": "诺依",
          "text": "有人不愿意原谅你。"
        },
        {
          "id": "camp.019.l02",
          "speaker": "主角",
          "text": "他有权这样想。"
        },
        {
          "id": "camp.019.l03",
          "speaker": "诺依",
          "text": "那你还要帮这个村子吗？"
        },
        {
          "id": "camp.019.l04",
          "speaker": "主角",
          "text": "要。帮忙不是换一句原谅。"
        }
      ]
    },
    {
      "id": "camp.020",
      "title": "维莎的手记",
      "available_after_chapter": "ch058",
      "requires_flags": [
        "story.ch058.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.020.l01",
          "speaker": "维莎",
          "text": "我的手记只写数字，不写姓名。"
        },
        {
          "id": "camp.020.l02",
          "speaker": "缇珐",
          "text": "从今天起，先学会写名字。"
        },
        {
          "id": "camp.020.l03",
          "speaker": "维莎",
          "text": "我怕自己写错。"
        },
        {
          "id": "camp.020.l04",
          "speaker": "岚音",
          "text": "写错可以改。什么都不写才是真的把人丢下。"
        }
      ]
    },
    {
      "id": "camp.021",
      "title": "自由城夜市",
      "available_after_chapter": "ch060",
      "requires_flags": [
        "story.ch060.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.021.l01",
          "speaker": "朔弦",
          "text": "以前我们走到哪儿都要先找旅馆。"
        },
        {
          "id": "camp.021.l02",
          "speaker": "岚音",
          "text": "现在这里也有一间是我们一起修的。"
        },
        {
          "id": "camp.021.l03",
          "speaker": "主角",
          "text": "以后有人路过时，就能在这里歇脚。"
        },
        {
          "id": "camp.021.l04",
          "speaker": "诺依",
          "text": "那我来写欢迎牌。"
        }
      ]
    },
    {
      "id": "camp.022",
      "title": "天轨窗口",
      "available_after_chapter": "ch066",
      "requires_flags": [
        "story.ch066.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.022.l01",
          "speaker": "玄璃",
          "text": "那边的星星，和映世里的并不一样。"
        },
        {
          "id": "camp.022.l02",
          "speaker": "维莎",
          "text": "因为这里的未来没有全部固定下来。"
        },
        {
          "id": "camp.022.l03",
          "speaker": "诺依",
          "text": "原来天空也可以让人走错路。"
        },
        {
          "id": "camp.022.l04",
          "speaker": "主角",
          "text": "走错了还能回头，这样就够了。"
        }
      ]
    },
    {
      "id": "camp.023",
      "title": "最终决战之前",
      "available_after_chapter": "ch071",
      "requires_flags": [
        "story.ch071.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.023.l01",
          "speaker": "雷索",
          "text": "每个人都记得自己为什么来到这里吗？"
        },
        {
          "id": "camp.023.l02",
          "speaker": "朔弦",
          "text": "我当然记得。只是有点紧张。"
        },
        {
          "id": "camp.023.l03",
          "speaker": "岚音",
          "text": "紧张也可以说出来。"
        },
        {
          "id": "camp.023.l04",
          "speaker": "主角",
          "text": "那我先说。我很怕，但不会一个人进去。"
        }
      ]
    }
  ]
}
