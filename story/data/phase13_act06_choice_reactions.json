      "independent_route": false,
      "dialogue": [
        {
          "id": "ch031.p13.choice.listen.l01",
          "speaker": "花贩",
          "text": "你们可以告诉我如何确认日期，但别替我把女儿的信拆开。"
        },
        {
          "id": "ch031.p13.choice.listen.l02",
          "speaker": "岚音",
          "text": "我们把选择写清楚，由你决定要不要继续问。"
        },
        {
          "id": "ch031.p13.choice.listen.l03",
          "speaker": "主角",
          "text": "不愿立刻离开今天，也仍有接受帮助的权利。"
        }
      ]
    },
    {
      "id": "ch031.p13.choice.act",
      "chapter_id": "ch031",
      "after_choice_id": "ch031.choice",
      "choice_option_id": "act",
      "condition": {
        "ch031.approach": "care",
        "world.ch031.approach": "care"
      },
      "insertion": "after_choice_commit_before_encounter",
      "optional": true,
      "independent_route": false,
      "dialogue": [
        {
          "id": "ch031.p13.choice.act.l01",
          "speaker": "值夜护士",
          "text": "我愿在街口设个地方，给那些记不起昨天的人休息。"
        },
        {
          "id": "ch031.p13.choice.act.l02",
          "speaker": "伊泽",
          "text": "我会把重复的钟声记下来，不让病人必须自己证明一切。"
        },
        {
          "id": "ch031.p13.choice.act.l03",
          "speaker": "主角",
          "text": "医疗援助不是强制醒来的另一种命令。"
        }
      ]
    },
    {
      "id": "ch032.p13.choice.listen",
      "chapter_id": "ch032",
      "after_choice_id": "ch032.choice",
      "choice_option_id": "listen",
      "condition": {
        "ch032.approach": "family",
        "world.ch032.approach": "family"
      },
      "insertion": "after_choice_commit_before_encounter",
      "optional": true,
      "independent_route": false,
      "dialogue": [
        {
          "id": "ch032.p13.choice.listen.l01",
          "speaker": "姨妈",
          "text": "我愿先听孩子讲梦里那顿饭，不要求他立刻忘记。"
        },
        {
          "id": "ch032.p13.choice.listen.l02",
          "speaker": "孩子",
          "text": "如果我今天不回去，明天还能再见你吗？"
        },
        {
          "id": "ch032.p13.choice.listen.l03",
          "speaker": "玄璃",
          "text": "出口会留下，决定可以重新商量。"
        }
      ]
    },
    {
      "id": "ch032.p13.choice.act",
      "chapter_id": "ch032",
      "after_choice_id": "ch032.choice",
      "choice_option_id": "act",
      "condition": {
        "ch032.approach": "anchor",
