{
  "schema": "starlit.story.phase17.life_branch_arcs.v1",
  "status": "authored_branch_arcs_not_runtime_bound",
  "batch": "06",
  "quests": [
    {
      "id": "sq_life_16",
      "late_chapter": "ch044",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "分段醒转表",
            "dialogue": [
              {
                "id": "sq_life_16.p17.a.followup.l01",
                "speaker": "钟匠家属",
                "text": "他每天只愿醒一小会儿，先别强迫去钟铺。"
              },
              {
                "id": "sq_life_16.p17.a.followup.l02",
                "speaker": "岚音",
                "text": "记录本人选择的时长，身体不适就暂停。"
              },
              {
                "id": "sq_life_16.p17.a.followup.l03",
                "speaker": "钟匠",
                "text": "钟还没修好，但我想先看看窗外的树。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "钟表铺开门半日",
            "dialogue": [
              {
                "id": "sq_life_16.p17.a.community.l01",
                "speaker": "邻居",
                "text": "今天店只开半日，也有人想来修表。"
              },
              {
                "id": "sq_life_16.p17.a.community.l02",
                "speaker": "钟匠",
                "text": "我不能接太多活，下午要回去休息。"
              },
              {
                "id": "sq_life_16.p17.a.community.l03",
                "speaker": "玄璃",
                "text": "停工不是失败，明天再选要做什么。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "晚餐不再迟到",
            "dialogue": [
              {
                "id": "sq_life_16.p17.a.revisit.l01",
                "speaker": "钟匠",
                "text": "今晚我在钟响前回家，没把最后一分钟藏在工作里。"
              },
              {
                "id": "sq_life_16.p17.a.revisit.l02",
                "speaker": "家属",
                "text": "吃饭时不必谈治疗进度，你说今天看见的雨就好。"
              },
              {
                "id": "sq_life_16.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "那只走得太慢的钟还在修，但一家人一起吃了晚餐。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "一家人的日常表",
            "dialogue": [
              {
                "id": "sq_life_16.p17.b.followup.l01",
                "speaker": "钟匠家属",
                "text": "今天我们先一起买菜，不要求他把错过的日子补回来。"
              },
              {
                "id": "sq_life_16.p17.b.followup.l02",
                "speaker": "钟匠",
                "text": "我记不全过去了，但认识回家的路。"
              },
              {
                "id": "sq_life_16.p17.b.followup.l03",
                "speaker": "岚音",
                "text": "照护计划由他自己点头，不是家属替他决定所有事。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "家属陪伴轮值",
            "dialogue": [
              {
                "id": "sq_life_16.p17.b.community.l01",
                "speaker": "邻居",
                "text": "我能陪他散步半小时，之后要回家。"
              },
              {
                "id": "sq_life_16.p17.b.community.l02",
                "speaker": "钟匠家属",
                "text": "我们轮班，也给陪伴的人安排休息。"
              },
              {
                "id": "sq_life_16.p17.b.community.l03",
                "speaker": "玄璃",
                "text": "梦室的门仍从里面打开，愿意休息时可自己提出。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "下一次周末",
            "dialogue": [
              {
                "id": "sq_life_16.p17.b.revisit.l01",
                "speaker": "钟匠",
                "text": "这一周我错过了一顿饭，也和家人一起吃了三顿。"
              },
              {
                "id": "sq_life_16.p17.b.revisit.l02",
                "speaker": "家属",
                "text": "不用算成赢了几次，我们还可以慢慢过。"
              },
              {
                "id": "sq_life_16.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "钟表铺留下营业时段，钟匠仍能自主选择醒着的日子。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_17",
      "late_chapter": "ch049",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "新身份登记栏",
            "dialogue": [
              {
                "id": "sq_life_17.p17.a.followup.l01",
                "speaker": "玄璃",
                "text": "出生地我写映世，不需要你替我签字。"
              },
              {
                "id": "sq_life_17.p17.a.followup.l02",
                "speaker": "档案员",
                "text": "旧表没有这栏，我会保留修改记录。"
              },
              {
                "id": "sq_life_17.p17.a.followup.l03",
                "speaker": "岚音",
                "text": "其他映世居民也应该能申请，不是单为玄璃开后门。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "登记窗口测试",
            "dialogue": [
              {
                "id": "sq_life_17.p17.a.community.l01",
                "speaker": "映世居民",
                "text": "我的住址在两界之间，系统却强迫选一个。"
              },
              {
                "id": "sq_life_17.p17.a.community.l02",
                "speaker": "玄璃",
                "text": "允许填临时联系点，再由本人更正。"
              },
              {
                "id": "sq_life_17.p17.a.community.l03",
                "speaker": "档案员",
                "text": "没有纸质证明的人也能获得受理编号。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "映世居民第一张证",
            "dialogue": [
              {
                "id": "sq_life_17.p17.a.revisit.l01",
                "speaker": "映世居民",
                "text": "证件印好了，但我不想让名字出现在观光公告上。"
              },
              {
                "id": "sq_life_17.p17.a.revisit.l02",
                "speaker": "玄璃",
                "text": "拥有身份证明不等于必须公开个人生活。"
              },
              {
                "id": "sq_life_17.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "档案馆门口换上了现世与映世都读得懂的指引。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "身份咨询席",
            "dialogue": [
              {
                "id": "sq_life_17.p17.b.followup.l01",
                "speaker": "玄璃",
                "text": "先把问题一项项写出来，让申请者自己回答。"
              },
              {
                "id": "sq_life_17.p17.b.followup.l02",
                "speaker": "档案员",
                "text": "临时回执可以当场领取，不需保证永久同住某界。"
              },
              {
                "id": "sq_life_17.p17.b.followup.l03",
                "speaker": "维权居民",
                "text": "我想知道怎样投诉拒收，而不是等待谁替我说话。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "申诉受理示范",
            "dialogue": [
              {
                "id": "sq_life_17.p17.b.community.l01",
                "speaker": "映世居民",
                "text": "窗口说我没有生辰地点，我申请复核。"
              },
              {
                "id": "sq_life_17.p17.b.community.l02",
                "speaker": "玄璃",
                "text": "申请表写的是我自己的名字，请直接对我回答。"
              },
              {
                "id": "sq_life_17.p17.b.community.l03",
                "speaker": "档案员",
                "text": "处理时限和投诉渠道张贴在门边。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "长期咨询日",
            "dialogue": [
              {
                "id": "sq_life_17.p17.b.revisit.l01",
                "speaker": "映世居民",
                "text": "我的申请还在审查，但现在知道能找谁。"
              },
              {
                "id": "sq_life_17.p17.b.revisit.l02",
                "speaker": "玄璃",
                "text": "制度可以慢慢改，不能叫申请者无限期等下去。"
              },
              {
                "id": "sq_life_17.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "咨询桌留下轮值席位，身份不再完全取决于一张旧表。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_18",
      "late_chapter": "ch050",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "记录第一场真雨",
            "dialogue": [
              {
                "id": "sq_life_18.p17.a.followup.l01",
                "speaker": "玄璃",
                "text": "雨落下来会有土味，和花庭设定的香气不同。"
              },
              {
                "id": "sq_life_18.p17.a.followup.l02",
                "speaker": "岚音",
                "text": "一开始会冷，想停就回屋，别为了体验硬撑。"
              },
              {
                "id": "sq_life_18.p17.a.followup.l03",
                "speaker": "映世孩子",
                "text": "我想把声音记下来，明天再比较。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "雨声与幻雨",
            "dialogue": [
              {
                "id": "sq_life_18.p17.a.community.l01",
                "speaker": "玄璃",
                "text": "幻雨每次敲窗相同，真实雨会忽快忽慢。"
              },
              {
                "id": "sq_life_18.p17.a.community.l02",
                "speaker": "孩子",
                "text": "今天我写下三种不一样的雨声。"
              },
              {
                "id": "sq_life_18.p17.a.community.l03",
                "speaker": "伊泽",
                "text": "听觉记录留给自愿参与的人，不必所有人写同一段。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "风停以后",
            "dialogue": [
              {
                "id": "sq_life_18.p17.a.revisit.l01",
                "speaker": "玄璃",
                "text": "今天没有下雨，我也高兴能在晴天走出去。"
              },
              {
                "id": "sq_life_18.p17.a.revisit.l02",
                "speaker": "孩子",
                "text": "雨本来就不会天天按我们希望来。"
              },
              {
                "id": "sq_life_18.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "花庭多了一本普通天气簿，空白日期也有位置。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "映世居民雨夜邀请",
            "dialogue": [
              {
                "id": "sq_life_18.p17.b.followup.l01",
                "speaker": "玄璃",
                "text": "愿意的人来，有人怕雷声就不要催他。"
              },
              {
                "id": "sq_life_18.p17.b.followup.l02",
                "speaker": "护理师",
                "text": "出口和毛巾准备好了，不把夜雨当挑战测试。"
              },
              {
                "id": "sq_life_18.p17.b.followup.l03",
                "speaker": "映世居民",
                "text": "我想先站在屋檐下听。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "雨夜安全屋",
            "dialogue": [
              {
                "id": "sq_life_18.p17.b.community.l01",
                "speaker": "映世孩子",
                "text": "打雷了，我能回梦室休息吗？"
              },
              {
                "id": "sq_life_18.p17.b.community.l02",
                "speaker": "玄璃",
                "text": "当然可以，愿意醒着或暂时回去都应被尊重。"
              },
              {
                "id": "sq_life_18.p17.b.community.l03",
                "speaker": "岚音",
                "text": "屋檐下留了灯和饮水，没有任何人必须淋湿。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "第二次邀请",
            "dialogue": [
              {
                "id": "sq_life_18.p17.b.revisit.l01",
                "speaker": "映世居民",
                "text": "这次我愿走到院子里，下次也可能不愿。"
              },
              {
                "id": "sq_life_18.p17.b.revisit.l02",
                "speaker": "玄璃",
                "text": "没有统一的毕业日，我们都可以慢慢体验。"
              },
              {
                "id": "sq_life_18.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "花庭与现实雨夜之间保留一道由居民自己打开的门。"
              }
            ]
          }
        ]
      }
    }
  ]
}
