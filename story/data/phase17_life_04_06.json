{
  "schema": "starlit.story.phase17.life_branch_arcs.v1",
  "status": "authored_branch_arcs_not_runtime_bound",
  "batch": "02",
  "quests": [
    {
      "id": "sq_life_04",
      "late_chapter": "ch012",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "双边求救旗",
            "dialogue": [
              {
                "id": "sq_life_04.p17.a.followup.l01",
                "speaker": "旗手",
                "text": "这面旗在我方求救，在对岸原来表示封锁。"
              },
              {
                "id": "sq_life_04.p17.a.followup.l02",
                "speaker": "邻国医师",
                "text": "我们先约定共同手势，不把它用于军事命令。"
              },
              {
                "id": "sq_life_04.p17.a.followup.l03",
                "speaker": "雷索",
                "text": "两边值班人互相确认后才放行。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "雾天通行演习",
            "dialogue": [
              {
                "id": "sq_life_04.p17.a.community.l01",
                "speaker": "学员",
                "text": "雾里看不见旗色，我改用约定钟声。"
              },
              {
                "id": "sq_life_04.p17.a.community.l02",
                "speaker": "医师",
                "text": "演习不能拖延真正送来的急救病人。"
              },
              {
                "id": "sq_life_04.p17.a.community.l03",
                "speaker": "旗手",
                "text": "旧手册留下，解释为何需要这项修改。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "边关救护日",
            "dialogue": [
              {
                "id": "sq_life_04.p17.a.revisit.l01",
                "speaker": "边境医师",
                "text": "两边终于听懂同一套急救信号。"
              },
              {
                "id": "sq_life_04.p17.a.revisit.l02",
                "speaker": "雷索",
                "text": "这个约定必须公开，不能再变军中秘密。"
              },
              {
                "id": "sq_life_04.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "关卡两侧挂着一致的救护指示。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "旗语双语教材",
            "dialogue": [
              {
                "id": "sq_life_04.p17.b.followup.l01",
                "speaker": "两国学员",
                "text": "同一手势的旧解释分开记，别只留下胜利者说法。"
              },
              {
                "id": "sq_life_04.p17.b.followup.l02",
                "speaker": "旗手",
                "text": "被调换的页码一起存档。"
              },
              {
                "id": "sq_life_04.p17.b.followup.l03",
                "speaker": "雷索",
                "text": "手册由两侧共同署名。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "手势互译练习",
            "dialogue": [
              {
                "id": "sq_life_04.p17.b.community.l01",
                "speaker": "教师",
                "text": "有争议的动作暂不用于救人。"
              },
              {
                "id": "sq_life_04.p17.b.community.l02",
                "speaker": "学员",
                "text": "夜里看不见旗，我们还要练灯号。"
              },
              {
                "id": "sq_life_04.p17.b.community.l03",
                "speaker": "医师",
                "text": "不确定时先重复确认。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "新一届旗手",
            "dialogue": [
              {
                "id": "sq_life_04.p17.b.revisit.l01",
                "speaker": "旗手",
                "text": "新版手册加了更正联系人。"
              },
              {
                "id": "sq_life_04.p17.b.revisit.l02",
                "speaker": "两国学员",
                "text": "下次有人发现问题，也能修改。"
              },
              {
                "id": "sq_life_04.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "旧军用暗号逐渐变成公众都能读懂的求救语言。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_05",
      "late_chapter": "ch014",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "旧鞋归还家属",
            "dialogue": [
              {
                "id": "sq_life_05.p17.a.followup.l01",
                "speaker": "鞋匠",
                "text": "鞋后跟磨破，是长期搬粮留下的痕迹。"
              },
              {
                "id": "sq_life_05.p17.a.followup.l02",
                "speaker": "搬运工后人",
                "text": "先告诉祖母，不要突然把鞋送到展馆。"
              },
              {
                "id": "sq_life_05.p17.a.followup.l03",
                "speaker": "雷索",
                "text": "原主人不是王室，也值得被认真记下。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "补丁细节",
            "dialogue": [
              {
                "id": "sq_life_05.p17.a.community.l01",
                "speaker": "搬运工后人",
                "text": "补丁是祖母亲手缝的，她最懂哪处易破。"
              },
              {
                "id": "sq_life_05.p17.a.community.l02",
                "speaker": "鞋匠",
                "text": "不能为陈列好看换掉真实补丁。"
              },
              {
                "id": "sq_life_05.p17.a.community.l03",
                "speaker": "主角",
                "text": "把鞋和难民送粮账并列说明。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "王都送粮史展",
            "dialogue": [
              {
                "id": "sq_life_05.p17.a.revisit.l01",
                "speaker": "搬运工后人",
                "text": "我愿让孩子来看，不公开祖母家门牌。"
              },
              {
                "id": "sq_life_05.p17.a.revisit.l02",
                "speaker": "鞋匠",
                "text": "展牌写回真正主人名字。"
              },
              {
                "id": "sq_life_05.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "看展的人开始谈起当年普通搬运工的路。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "更正旧牌",
            "dialogue": [
              {
                "id": "sq_life_05.p17.b.followup.l01",
                "speaker": "鞋匠",
                "text": "旧牌写国王穿过，新的说明写清发现错误的证据。"
              },
              {
                "id": "sq_life_05.p17.b.followup.l02",
                "speaker": "史馆员",
                "text": "错误发生的年份也要保留。"
              },
              {
                "id": "sq_life_05.p17.b.followup.l03",
                "speaker": "后人",
                "text": "别把这次修改写成又一次宫廷恩赐。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "公开修正日",
            "dialogue": [
              {
                "id": "sq_life_05.p17.b.community.l01",
                "speaker": "城中教师",
                "text": "学生能对照旧标签和鞋底磨损。"
              },
              {
                "id": "sq_life_05.p17.b.community.l02",
                "speaker": "鞋匠",
                "text": "修补工具可以看，原鞋不能随手触摸。"
              },
              {
                "id": "sq_life_05.p17.b.community.l03",
                "speaker": "雷索",
                "text": "历史不必靠王室身份才能引起关心。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "永久勘误栏",
            "dialogue": [
              {
                "id": "sq_life_05.p17.b.revisit.l01",
                "speaker": "史馆员",
                "text": "新证据出现，展牌以后还可再次更正。"
              },
              {
                "id": "sq_life_05.p17.b.revisit.l02",
                "speaker": "后人",
                "text": "承认过去写错，不丢人。"
              },
              {
                "id": "sq_life_05.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "这双旧鞋连同错误记载一道走进真正的历史。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_06",
      "late_chapter": "ch016",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "三名作者",
            "dialogue": [
              {
                "id": "sq_life_06.p17.a.followup.l01",
                "speaker": "唱诗教师",
                "text": "三位老人分别写过的段落都要署名。"
              },
              {
                "id": "sq_life_06.p17.a.followup.l02",
                "speaker": "边村老人",
                "text": "别把我写成第一作者，大家当年一起唱。"
              },
              {
                "id": "sq_life_06.p17.a.followup.l03",
                "speaker": "孩子",
                "text": "原来曲子一直有人往下接。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "三国排练",
            "dialogue": [
              {
                "id": "sq_life_06.p17.a.community.l01",
                "speaker": "孩子",
                "text": "三段节拍都不一样，怎么合在一起？"
              },
              {
                "id": "sq_life_06.p17.a.community.l02",
                "speaker": "伊泽",
                "text": "先学会听别人唱完，不必磨成一个拍子。"
              },
              {
                "id": "sq_life_06.p17.a.community.l03",
                "speaker": "唱诗教师",
                "text": "累了可以示意休息。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "春日边境演出",
            "dialogue": [
              {
                "id": "sq_life_06.p17.a.revisit.l01",
                "speaker": "边村老人",
                "text": "三个村的孩子同台，没有谁抢着宣布赢。"
              },
              {
                "id": "sq_life_06.p17.a.revisit.l02",
                "speaker": "伊泽",
                "text": "署名以后还可以增补新段。"
              },
              {
                "id": "sq_life_06.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "歌声沿两条边界散去，节拍仍有不同。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "孩子写节目单",
            "dialogue": [
              {
                "id": "sq_life_06.p17.b.followup.l01",
                "speaker": "教师",
                "text": "你们自己决定轮唱方式，不用模仿上一代。"
              },
              {
                "id": "sq_life_06.p17.b.followup.l02",
                "speaker": "孩子",
                "text": "想先分别唱三段，再一起唱新结尾。"
              },
              {
                "id": "sq_life_06.p17.b.followup.l03",
                "speaker": "伊泽",
                "text": "先让没发言的人也有时间说。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "幕后的绘画者",
            "dialogue": [
              {
                "id": "sq_life_06.p17.b.community.l01",
                "speaker": "不爱唱歌的孩子",
                "text": "我只想画节目单，不想站在台前。"
              },
              {
                "id": "sq_life_06.p17.b.community.l02",
                "speaker": "教师",
                "text": "当然，演出也需要画画的人。"
              },
              {
                "id": "sq_life_06.p17.b.community.l03",
                "speaker": "孩子",
                "text": "我来画三色音符，不分谁更重要。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "新一年的曲谱",
            "dialogue": [
              {
                "id": "sq_life_06.p17.b.revisit.l01",
                "speaker": "教师",
                "text": "孩子们创作了自己的前奏。"
              },
              {
                "id": "sq_life_06.p17.b.revisit.l02",
                "speaker": "伊泽",
                "text": "保留旧曲，也不要求一直照旧唱。"
              },
              {
                "id": "sq_life_06.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "边境教堂有了更多声音，连安静的人也有位置。"
              }
            ]
          }
        ]
      }
    }
  ]
}
