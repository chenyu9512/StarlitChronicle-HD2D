        "story.ch024.done"
      ],
      "chapter_start_flag": "ch025.started",
      "chapter_complete_flag": "story.ch025.done",
      "lead_character": "朔弦",
      "summary": "在海歌港·旧船坞，筹集木材、修复船体并挑选船员。港长要扣押旧船抵债，即便债务早已还清。最终，玩家用旧债收据换得船籍，远航船「逐星号」起航。",
      "production_status": "scripted_blocking_v1",
      "recommended_level": [
        30,
        34
      ],
      "boss": null,
      "scenes": [
        {
          "id": "ch025.opening",
          "title": "到达：海歌港·旧船坞",
          "trigger": {
            "type": "chapter_enter",
            "region": "海歌港·旧船坞"
          },
          "dialogue": [
            {
              "id": "ch025.opening.l01",
              "speaker": "旁白",
              "text": "【海歌港·旧船坞】空气中藏着异样的气息。"
            },
            {
              "id": "ch025.opening.l02",
              "speaker": "朔弦",
              "text": "船不是自由的证明，愿意上船的人才是。"
            },
            {
              "id": "ch025.opening.l03",
              "speaker": "主角",
              "text": "先把眼前的事弄清楚。筹集木材、修复船体并挑选船员。"
            },
            {
              "id": "ch025.opening.l04",
              "speaker": "朔弦",
              "text": "别忘了，沿途的人也有自己的故事。"
            }
          ],
          "objectives": [
            {
              "type": "reach",
              "target": "海歌港·旧船坞"
            },
            {
              "type": "interact",
              "target": "ch025.key_npc"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch025.started",
              "value": true
            }
          ]
        },
        {
          "id": "ch025.investigate",
          "title": "调查线索",
          "trigger": {
            "type": "interact",
            "target": "ch025.clue"
          },
          "dialogue": [
            {
              "id": "ch025.investigate.l01",
              "speaker": "旁白",
              "text": "众人在海歌港·旧船坞找到了一处被忽视的痕迹。"
            },
            {
              "id": "ch025.investigate.l02",
              "speaker": "朔弦",
              "text": "废弃船舱内刻有澄舟的修船标记。"
            },
            {
              "id": "ch025.investigate.l03",
              "speaker": "主角",
              "text": "先别急着下结论。还有谁能证实这件事？"
            },
            {
              "id": "ch025.investigate.l04",
              "speaker": "旁白",
              "text": "日志、物件与目击证言彼此印证，事件终于露出轮廓。"
            }
          ],
          "objectives": [
            {
              "type": "inspect",
              "target": "ch025.clue"
            },
            {
              "type": "speak",
              "target": "ch025.witness"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch025.evidence",
              "value": true
            }
          ]
        },
        {
          "id": "ch025.crisis",
          "title": "真相与冲突",
          "trigger": {
            "type": "interact",
            "target": "ch025.crisis",
            "requires_flags": [
              "ch025.evidence"
            ]
          },
          "dialogue": [
            {
              "id": "ch025.crisis.l01",
              "speaker": "旁白",
              "text": "当最后一份证据摆上桌面，原本平静的局面终于被打破。"
            },
            {
              "id": "ch025.crisis.l02",
              "speaker": "朔弦",
              "text": "港长要扣押旧船抵债，即便债务早已还清。"
            },
            {
              "id": "ch025.crisis.l03",
              "speaker": "主角",
              "text": "不能只顾眼前的胜负。谁会因为我们的决定付出代价？"
            },
            {
              "id": "ch025.crisis.l04",
              "speaker": "朔弦",
              "text": "这一次由你决定如何开口。我会一起承担后果。"
            }
          ],
          "objectives": [
            {
              "type": "decide",
              "target": "ch025.choice"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch025.decision_made",
              "value": true
            }
          ],
          "choice": {
            "id": "ch025.choice",
            "prompt": "面对眼前的矛盾，你打算怎样行动？",
            "options": [
              {
                "id": "listen",
                "label": "先听当事人的解释",
                "sets": {
                  "ch025.approach": "listen"
                }
              },
              {
                "id": "act",
                "label": "先保护可能受伤的人",
                "sets": {
                  "ch025.approach": "act"
                }
              }
            ]
          },
          "encounter": null
        },
        {
          "id": "ch025.resolve",
          "title": "事件落幕",
          "trigger": {
            "type": "scene_after",
            "requires_flags": [
              "ch025.decision_made"
            ]
          },
          "dialogue": [
            {
              "id": "ch025.resolve.l01",
              "speaker": "旁白",
              "text": "风声渐弱，人们终于有机会面对自己刚才不愿承认的事。"
            },
            {
              "id": "ch025.resolve.l02",
              "speaker": "朔弦",
              "text": "玩家用旧债收据换得船籍，远航船「逐星号」起航。"
            },
            {
              "id": "ch025.resolve.l03",
              "speaker": "主角",
              "text": "总有些事，不能只写成一行冒险记录。"
            },
            {
              "id": "ch025.resolve.l04",
              "speaker": "旁白",
              "text": "【任务完成】我们的第一艘船。新的道路正在展开。"
            }
          ],
          "objectives": [
            {
              "type": "finish_chapter",
              "target": "ch025"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "story.ch025.done",
              "value": true
            },
