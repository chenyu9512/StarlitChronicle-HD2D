      "dialogue": [
        {
          "id": "coda.p18.leiso.b.a.l01",
          "speaker": "旁白",
          "text": "无灯世界的边境没有永久安全线，雷索和普通居民一起检查避难道路。"
        },
        {
          "id": "coda.p18.leiso.b.a.l02",
          "speaker": "雷索",
          "text": "现在没有灯会替我们指定敌人，也不能由我来替所有人判谁有罪。"
        },
        {
          "id": "coda.p18.leiso.b.a.l03",
          "speaker": "旁白",
          "text": "救援队轮值维护警报站，无武装者也有同等保障。"
        }
      ]
    },
