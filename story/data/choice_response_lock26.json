{
  "schema": "starlit.campaign.choice-responses.v1",
  "status": "editorial_candidate_not_final_lock",
  "replies": {
    "ch001.crisis": {
      "a": [
        {
          "id": "ch001.crisis.lock26.a.l01",
          "speaker": "村长",
          "text": "收据背面还有第二次钟响的时间，我当时确实听见了。"
        },
        {
          "id": "ch001.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "主角将收据举到光下，淡去的数字缓缓浮现。"
        }
      ],
      "b": [
        {
          "id": "ch001.crisis.lock26.b.l01",
          "speaker": "村长",
          "text": "让我坐一会儿。那天我一直不敢开门。"
        },
        {
          "id": "ch001.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "主角拉开椅子，没有急着推过去纸笔。"
        }
      ]
    },
    "ch002.crisis": {
      "a": [
        {
          "id": "ch002.crisis.lock26.a.l01",
          "speaker": "岚音",
          "text": "我先抹去病人的姓名，再请港口查这些病历。"
        },
        {
          "id": "ch002.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "匿名报告贴上墙，家属手里仍留着撤回授权的纸条。"
        }
      ],
      "b": [
        {
          "id": "ch002.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "病历先归医务室保管，谁查阅都得说明原因。"
        },
        {
          "id": "ch002.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "小汐望着封好的档案袋，主动报出自己的船名。"
        }
      ]
    },
    "ch003.crisis": {
      "a": [
        {
          "id": "ch003.crisis.lock26.a.l01",
          "speaker": "朔弦",
          "text": "先让他们退到潮线外，我不值得谁替我赌命。"
        },
        {
          "id": "ch003.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "旧阀停转，守卫眼里的红光逐排熄灭。"
        }
      ],
      "b": [
        {
          "id": "ch003.crisis.lock26.b.l01",
          "speaker": "朔弦",
          "text": "那串刻字我认得。试一试，让我自己来。"
        },
        {
          "id": "ch003.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "他伸手贴近石门，船徽与记忆里的歪树重合。"
        }
      ]
    },
    "ch004.crisis": {
      "a": [
        {
          "id": "ch004.crisis.lock26.a.l01",
          "speaker": "朔弦",
          "text": "货是我运的，就由我把事情讲清楚。"
        },
        {
          "id": "ch004.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "他将货单摊在酒馆中央，周围的喧哗渐渐停了。"
        }
      ],
      "b": [
        {
          "id": "ch004.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "后厨还有孩子，先别让人堵住那扇门。"
        },
        {
          "id": "ch004.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "最后一个客人退到后巷，朔弦才松开顶门的长凳。"
        }
      ]
    },
    "ch005.crisis": {
      "a": [
        {
          "id": "ch005.crisis.lock26.a.l01",
          "speaker": "港务官",
          "text": "我派人盯着星锁，要是它转向岸边就撤。"
        },
        {
          "id": "ch005.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "海兽身上传来细弱的金属哀鸣。"
        }
      ],
      "b": [
        {
          "id": "ch005.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "老渔夫还在船上！帮我把他接过来。"
        },
        {
          "id": "ch005.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "最后一艘渔船离开礁区，海兽不再朝岸边挣扎。"
        }
      ]
    },
    "ch006.crisis": {
      "a": [
        {
          "id": "ch006.crisis.lock26.a.l01",
          "speaker": "朔弦",
          "text": "我先说一条回家的路，剩下的让他们接上。"
        },
        {
          "id": "ch006.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "居民轮流报出自家门前最后一盏小灯的位置。"
        }
      ],
      "b": [
        {
          "id": "ch006.crisis.lock26.b.l01",
          "speaker": "朔弦",
          "text": "航海日志都在，失踪者的路线也不能划掉。"
        },
        {
          "id": "ch006.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "船簿在灯塔下摊开，潮歌灯朝那些未完的航路亮起。"
        }
      ]
    },
    "ch007.crisis": {
      "a": [
        {
          "id": "ch007.crisis.lock26.a.l01",
          "speaker": "雷索",
          "text": "名单可以公开，但每个人都该知道由谁保护。"
        },
        {
          "id": "ch007.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "救济官把签名册分给三地代表，不许任何一国独自带走。"
        }
      ],
      "b": [
        {
          "id": "ch007.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "药必须先送到。宫里问责就来问我。"
        },
        {
          "id": "ch007.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "没有旗帜的救护车在夜色中穿过关卡。"
        }
      ]
    },
    "ch008.crisis": {
      "a": [
        {
          "id": "ch008.crisis.lock26.a.l01",
          "speaker": "雷索",
          "text": "让军械编号来说话，不要拿怒火代替证据。"
        },
        {
          "id": "ch008.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "两岸的士兵看见同一批被伪造的编号。"
        }
      ],
      "b": [
        {
          "id": "ch008.crisis.lock26.b.l01",
          "speaker": "朔弦",
          "text": "我带村民从河滩撤，船总比喊话可靠。"
        },
        {
          "id": "ch008.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "最后的孩子登上小船时，桥上的弩弦终于松开。"
        }
      ]
    },
    "ch009.crisis": {
      "a": [
        {
          "id": "ch009.crisis.lock26.a.l01",
          "speaker": "雷索",
          "text": "请先送走证人家属，我宁肯再背一天罪名。"
        },
        {
          "id": "ch009.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "证人席暂时空着，护卫转而守在居民巷口。"
        }
      ],
      "b": [
        {
          "id": "ch009.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "一纸承诺不够，我要看到守卫与救援药箱。"
        },
        {
          "id": "ch009.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "法官第一次把保护措施与时限写进庭审记录。"
        }
      ]
    },
    "ch010.crisis": {
      "a": [
        {
          "id": "ch010.crisis.lock26.a.l01",
          "speaker": "朔弦",
          "text": "按人数分粮就得数清每个人，不是数旗帜。"
        },
        {
          "id": "ch010.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "三个印章盖在同一张粮单上，谁也不能擅自涂改。"
        }
      ],
      "b": [
        {
          "id": "ch010.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "等不到明早的病人先上车，账可以随后查。"
        },
        {
          "id": "ch010.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "哨卡为医疗车打开栅栏，通行记录留下了签名。"
        }
      ]
    },
    "ch011.crisis": {
      "a": [
        {
          "id": "ch011.crisis.lock26.a.l01",
          "speaker": "雷索",
          "text": "把军令贴出来，士兵该知道是谁命令他们开枪。"
        },
        {
          "id": "ch011.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "第一排士兵看完原件，默默竖起了长矛。"
        }
      ],
      "b": [
        {
          "id": "ch011.crisis.lock26.b.l01",
          "speaker": "朔弦",
          "text": "先把孩子带远，桥下的引线可等不了人争辩。"
        },
        {
          "id": "ch011.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "炸药袋被拖出桥墩，绷紧的桥索轻轻晃动。"
        }
      ]
    },
    "ch012.crisis": {
      "a": [
        {
          "id": "ch012.crisis.lock26.a.l01",
          "speaker": "雷索",
          "text": "王冠能作证，但平民也该坐在灯前。"
        },
        {
          "id": "ch012.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "灯坛下多放了几张木椅，再无人藏在帘幕后。"
        }
      ],
      "b": [
        {
          "id": "ch012.crisis.lock26.b.l01",
          "speaker": "维莎",
          "text": "要是不准后来的人质询，这誓言早晚又会成锁。"
        },
        {
          "id": "ch012.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "公开质询的日期与三枚王印并列刻在灯座上。"
        }
      ]
    },
    "ch013.crisis": {
      "a": [
        {
          "id": "ch013.crisis.lock26.a.l01",
          "speaker": "岚音",
          "text": "救人等不了档案签字，我先下井。"
        },
        {
          "id": "ch013.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "家属握住升降绳，工牌上的空白名字暂时没被盖章。"
        }
      ],
      "b": [
        {
          "id": "ch013.crisis.lock26.b.l01",
          "speaker": "缇珐",
          "text": "矿石交家属共同封存，谁也别暗中换掉。"
        },
        {
          "id": "ch013.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "闪光样本装入玻璃瓶，被划掉的工号重新写回登记簿。"
        }
      ]
    },
    "ch014.crisis": {
      "a": [
        {
          "id": "ch014.crisis.lock26.a.l01",
          "speaker": "缇珐",
          "text": "机器里的声音属于谁，要请亲人来认。"
        },
        {
          "id": "ch014.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "家属围在旧机器旁，不再将故障声称作噪音。"
        }
      ],
      "b": [
        {
          "id": "ch014.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "先保全原机，等证人安全再决定公布时机。"
        },
        {
          "id": "ch014.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "拆机工具收进柜子，两把不同的锁同时合上。"
        }
      ]
    },
    "ch015.crisis": {
      "a": [
        {
          "id": "ch015.crisis.lock26.a.l01",
          "speaker": "缇珐",
          "text": "图纸交给公会共同保管，但不能再关进塔里。"
        },
        {
          "id": "ch015.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "第一张教学图挂在塔外，路过的工人驻足看了很久。"
        }
      ],
      "b": [
        {
          "id": "ch015.crisis.lock26.b.l01",
          "speaker": "缇珐",
          "text": "先教怎样安全停机，再教怎样点火。"
        },
        {
          "id": "ch015.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "初学者的桌上摆满旧零件，不再要求效忠宣誓。"
        }
      ]
    },
    "ch016.crisis": {
      "a": [
        {
          "id": "ch016.crisis.lock26.a.l01",
          "speaker": "雷索",
          "text": "医院不断电，矿工的名字也必须一个不少。"
        },
        {
          "id": "ch016.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "名册贴到安置区外，一位老妇终于找到丈夫的工号。"
        }
      ],
      "b": [
        {
          "id": "ch016.crisis.lock26.b.l01",
          "speaker": "缇珐",
          "text": "替代供能的日期我来签，迟一天就公开一天。"
        },
        {
          "id": "ch016.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "临时燃料车驶入巷口，封条由住户亲手拆开。"
        }
      ]
    },
    "ch017.crisis": {
      "a": [
        {
          "id": "ch017.crisis.lock26.a.l01",
          "speaker": "岚音",
          "text": "病房还有三分钟，照我的倒数切换电源。"
        },
        {
          "id": "ch017.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "最后一张病床接上备用线，缇珐才抓住断路柄。"
        }
      ],
      "b": [
        {
          "id": "ch017.crisis.lock26.b.l01",
          "speaker": "雷索",
          "text": "先让炮口转离居民区，我守住主炉这面。"
        },
        {
          "id": "ch017.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "炮管被铁链扯偏，碎玻璃没有落进市集。"
        }
      ]
    },
    "ch018.crisis": {
      "a": [
        {
          "id": "ch018.crisis.lock26.a.l01",
          "speaker": "缇珐",
          "text": "矿工知道停炉的代价，他们也得有表决权。"
        },
        {
          "id": "ch018.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "补偿单上写满疑问，没人催促家属签字。"
        }
      ],
      "b": [
        {
          "id": "ch018.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "医院的暖炉要独立供能，我逐间检查。"
        },
        {
          "id": "ch018.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "供能图上出现数条绕开主炉的新线路，细小却可靠。"
        }
      ]
    },
    "ch019.crisis": {
      "a": [
        {
          "id": "ch019.crisis.lock26.a.l01",
          "speaker": "年轻雷索",
          "text": "军令留给村里，以后谁说他们自愿撤离都能查。"
        },
        {
          "id": "ch019.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "一名军士在泥墙上誊写完整命令。"
        }
      ],
      "b": [
        {
          "id": "ch019.crisis.lock26.b.l01",
          "speaker": "年轻雷索",
          "text": "抗命的是我，签名也该由我自己来。"
        },
        {
          "id": "ch019.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "几个军士并肩按下指印，再无人接过放火令。"
        }
      ]
    },
    "ch020.crisis": {
      "a": [
        {
          "id": "ch020.crisis.lock26.a.l01",
          "speaker": "年轻朔弦",
          "text": "日记里有出卖船员的证据，不能留给船长。"
        },
        {
          "id": "ch020.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "湿透的船簿绑在腰间，浪声盖过他逃跑的脚步。"
        }
      ],
      "b": [
        {
          "id": "ch020.crisis.lock26.b.l01",
          "speaker": "年轻朔弦",
          "text": "先记住那三颗星。活下来才能找回整张图。"
        },
        {
          "id": "ch020.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "小水手在帆布上点出星位，快艇灯光逼近船尾。"
        }
      ]
    },
    "ch021.crisis": {
      "a": [
        {
          "id": "ch021.crisis.lock26.a.l01",
          "speaker": "岚音",
          "text": "你可以生气，我欠的是全部经过，不是一句道歉。"
        },
        {
          "id": "ch021.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "病历留在营火边，没人替主角翻到末页。"
        }
      ],
      "b": [
        {
          "id": "ch021.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "我陪你一页页查，错了哪处就重说哪处。"
        },
        {
          "id": "ch021.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "主角圈出最早的日期，纸角还留着当年药房的味道。"
        }
      ]
    },
    "ch022.crisis": {
      "a": [
        {
          "id": "ch022.crisis.lock26.a.l01",
          "speaker": "朔弦",
          "text": "公开账册之前先遮去受害者住址。"
        },
        {
          "id": "ch022.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "厅里人人看见交易编号，却再也认不出被拍卖者身份。"
        }
      ],
      "b": [
        {
          "id": "ch022.crisis.lock26.b.l01",
          "speaker": "雷索",
          "text": "先让证人活着出去，档案馆的门我守。"
        },
        {
          "id": "ch022.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "宫廷乐师从后门离开，未唱完的曲子停在半拍。"
        }
      ]
    },
    "ch023.crisis": {
      "a": [
        {
          "id": "ch023.crisis.lock26.a.l01",
          "speaker": "主角",
          "text": "熟人的名字要救，空缺的名字也必须留着。"
        },
        {
          "id": "ch023.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "访客名单被抄成两份，一份送给在外等候的家属。"
        }
      ],
      "b": [
        {
          "id": "ch023.crisis.lock26.b.l01",
          "speaker": "朔弦",
          "text": "无落款的原页先收好，它可能比答案更重要。"
        },
        {
          "id": "ch023.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "纸角的旧灯纹被原样封存，没有重新描画。"
        }
      ]
    },
    "ch024.crisis": {
      "a": [
        {
          "id": "ch024.crisis.lock26.a.l01",
          "speaker": "雷索",
          "text": "让家属知道签令的人是谁，也让所有人看全文。"
        },
        {
          "id": "ch024.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "听证会没有英雄席，只有排得很长的普通木椅。"
        }
      ],
      "b": [
        {
          "id": "ch024.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "名单先送到家属手里，别让他们靠流言听见噩耗。"
        },
        {
          "id": "ch024.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "信使挨家敲门，公告因此比预定迟了半日。"
        }
      ]
    },
    "ch025.crisis": {
      "a": [
        {
          "id": "ch025.crisis.lock26.a.l01",
          "speaker": "朔弦",
          "text": "账就在这里，船籍不能只靠港长一句人情。"
        },
        {
          "id": "ch025.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "旧债流水贴在船坞，工匠终于敢逐项质问。"
        }
      ],
      "b": [
        {
          "id": "ch025.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "先付工资，不能让修船的人空手回家。"
        },
        {
          "id": "ch025.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "第一笔工钱从新船账里支出，木槌声重新响起。"
        }
      ]
    },
    "ch026.crisis": {
      "a": [
        {
          "id": "ch026.crisis.lock26.a.l01",
          "speaker": "伊泽",
          "text": "先问收信人愿不愿拆封，海风没法替他作答。"
        },
        {
          "id": "ch026.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "信被安静放在桌上，谁也没抢先念出称呼。"
        }
      ],
      "b": [
        {
          "id": "ch026.crisis.lock26.b.l01",
          "speaker": "朔弦",
          "text": "我去找寄件人的脚印，不能替他们安排重逢。"
        },
        {
          "id": "ch026.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "旧邮戳与残航图分开放好，墨迹尚未完全干透。"
        }
      ]
    },
    "ch027.crisis": {
      "a": [
        {
          "id": "ch027.crisis.lock26.a.l01",
          "speaker": "伊泽",
          "text": "留下和离开的人都写上，谁也不比谁更勇敢。"
        },
        {
          "id": "ch027.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "潜水钟里的册子记下撤离船与守城塔的编号。"
        }
      ],
      "b": [
        {
          "id": "ch027.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "先交后人核对，别把读错的名字刻成石碑。"
        },
        {
          "id": "ch027.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "老人轻声纠正祖母的双姓，海水从纸边滑落。"
        }
      ]
    },
    "ch028.crisis": {
      "a": [
        {
          "id": "ch028.crisis.lock26.a.l01",
          "speaker": "伊泽",
          "text": "先让海边人退开，我的歌不该再害别人。"
        },
        {
          "id": "ch028.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "他压低歌声，礁石上的微光渐渐熄灭。"
        }
      ],
      "b": [
        {
          "id": "ch028.crisis.lock26.b.l01",
          "speaker": "伊泽",
          "text": "一人接一句吧，我不想独自背下整首歌。"
        },
        {
          "id": "ch028.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "三段残谱上了不同的船，海面传来断续的应答。"
        }
      ]
    },
    "ch029.crisis": {
      "a": [
        {
          "id": "ch029.crisis.lock26.a.l01",
          "speaker": "朔弦",
          "text": "淡水先给他们，没有力气的人拿航图也走不了。"
        },
        {
          "id": "ch029.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "商船孩子抱住水囊，风帆依旧垂着。"
        }
      ],
      "b": [
        {
          "id": "ch029.crisis.lock26.b.l01",
          "speaker": "朔弦",
          "text": "六座航标大家一起守，不必独占这阵风。"
        },
        {
          "id": "ch029.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "几艘船先后升起窄帆，静海里出现相连的航迹。"
        }
      ]
    },
    "ch030.crisis": {
      "a": [
        {
          "id": "ch030.crisis.lock26.a.l01",
          "speaker": "朔弦",
          "text": "求救的灯不能收费，否则只是换了一个海盗。"
        },
        {
          "id": "ch030.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "小船灯先亮，远处渔船随后发回信号。"
        }
      ],
      "b": [
        {
          "id": "ch030.crisis.lock26.b.l01",
          "speaker": "伊泽",
          "text": "谁添油、谁查账，得比海图还清楚。"
        },
        {
          "id": "ch030.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "船主们将维护费用记进同一本公开航簿。"
        }
      ]
    },
    "ch031.crisis": {
      "a": [
        {
          "id": "ch031.crisis.lock26.a.l01",
          "speaker": "玄璃",
          "text": "逐户询问，不想醒的人也要知道门还在。"
        },
        {
          "id": "ch031.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "镜眠街第一次出现不同答复，但屋门没被强行推开。"
        }
      ],
      "b": [
        {
          "id": "ch031.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "先让病人有地方休息，真相不能靠惊吓证明。"
        },
        {
          "id": "ch031.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "医护站开在钟楼下，值夜者写上真正的今日日期。"
        }
      ]
    },
    "ch032.crisis": {
      "a": [
        {
          "id": "ch032.crisis.lock26.a.l01",
          "speaker": "玄璃",
          "text": "让孩子见到亲人，也让他说得出不愿回去。"
        },
        {
          "id": "ch032.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "镜面两头摆着同样的木椅，无人催促他走向哪边。"
        }
      ],
      "b": [
        {
          "id": "ch032.crisis.lock26.b.l01",
          "speaker": "玄璃",
          "text": "先造一扇两面都能开启的门，再谈回家。"
        },
        {
          "id": "ch032.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "镜锚拉环被安在孩子伸手就能够到的地方。"
        }
      ]
    },
    "ch033.crisis": {
      "a": [
        {
          "id": "ch033.crisis.lock26.a.l01",
          "speaker": "岚音",
          "text": "我也想过另一种生活，想过不代表就得离开。"
        },
        {
          "id": "ch033.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "队友逐个说出梦里见过的人，没有急着争论。"
        }
      ],
      "b": [
        {
          "id": "ch033.crisis.lock26.b.l01",
          "speaker": "雷索",
          "text": "不想讲就坐着吧，火还暖和。"
        },
        {
          "id": "ch033.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "营地多留一张空毯，给今晚不愿独处的人。"
        }
      ]
    },
    "ch034.crisis": {
      "a": [
        {
          "id": "ch034.crisis.lock26.a.l01",
          "speaker": "玄璃",
          "text": "名字由我自己写，你们只要别让它被擦去。"
        },
        {
          "id": "ch034.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "她拿起笔，终于在旧登记簿的空栏落下第一笔。"
        }
      ],
      "b": [
        {
          "id": "ch034.crisis.lock26.b.l01",
          "speaker": "维莎",
          "text": "先让回收命令承认错误，再谈是否合法。"
        },
        {
          "id": "ch034.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "判定框一行行熄灭，观众席第一次有人为玄璃站起身。"
        }
      ]
    },
    "ch035.crisis": {
      "a": [
        {
          "id": "ch035.crisis.lock26.a.l01",
          "speaker": "岚音",
          "text": "先救最难受的人，不能拿他们证明政策正确。"
        },
        {
          "id": "ch035.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "病房灯逐间调暗，值班表改为轮流监护。"
        }
      ],
      "b": [
        {
          "id": "ch035.crisis.lock26.b.l01",
          "speaker": "玄璃",
          "text": "退出权写在房门外，睡着也不能失去申诉权。"
        },
        {
          "id": "ch035.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "第一位愿意留下的老人签下下一次复询日期。"
        }
      ]
    },
    "ch036.crisis": {
      "a": [
        {
          "id": "ch036.crisis.lock26.a.l01",
          "speaker": "玄璃",
          "text": "先开门，谁想做梦也必须知道自己能醒。"
        },
        {
          "id": "ch036.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "封闭梦室的门锁逐个松开，厅里传来迟疑的脚步。"
        }
      ],
      "b": [
        {
          "id": "ch036.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "疗法可以留，替病人做主的命令不能留。"
        },
        {
          "id": "ch036.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "强制治疗印章由医师和居民一起从灯台取下。"
        }
      ]
    },
    "ch037.crisis": {
      "a": [
        {
          "id": "ch037.crisis.lock26.a.l01",
          "speaker": "朔弦",
          "text": "航图上是别人的家，不能未经同意随便公开。"
        },
        {
          "id": "ch037.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "那棵歪树被标作路标，村落位置暂时留白。"
        }
      ],
      "b": [
        {
          "id": "ch037.crisis.lock26.b.l01",
          "speaker": "朔弦",
          "text": "救援船得知道怎么进港，住户地址就别画出来。"
        },
        {
          "id": "ch037.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "公开航图只画避风湾，码头后巷仍属于岛民。"
        }
      ]
    },
    "ch038.crisis": {
      "a": [
        {
          "id": "ch038.crisis.lock26.a.l01",
          "speaker": "岚音",
          "text": "告诉他们档案存在，不等于把过去塞回手里。"
        },
        {
          "id": "ch038.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "阅览室打开了，第一天只有两个人走进去。"
        }
      ],
      "b": [
        {
          "id": "ch038.crisis.lock26.b.l01",
          "speaker": "玄璃",
          "text": "先让家人慢慢说，醒来不是一场比赛。"
        },
        {
          "id": "ch038.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "旧城照片摆进疗养间，每张背面都留有空白。"
        }
      ]
    },
    "ch039.crisis": {
      "a": [
        {
          "id": "ch039.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "请把知道的事实都告诉我，我自己决定还找什么。"
        },
        {
          "id": "ch039.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "搜救图留下未确认的点，没有草率写下终止。"
        }
      ],
      "b": [
        {
          "id": "ch039.crisis.lock26.b.l01",
          "speaker": "诺依",
          "text": "妈妈说海边有棵树，我们能先完成约定吗？"
        },
        {
          "id": "ch039.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "主角把这事写在手灯内侧，让男孩自己握着。"
        }
      ]
    },
    "ch040.crisis": {
      "a": [
        {
          "id": "ch040.crisis.lock26.a.l01",
          "speaker": "雷索",
          "text": "不能靠删去别人的证词来证明自己是对的。"
        },
        {
          "id": "ch040.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "矛盾的两份证词并列展示，火光照出各自的涂改。"
        }
      ],
      "b": [
        {
          "id": "ch040.crisis.lock26.b.l01",
          "speaker": "维莎",
          "text": "每一方说完后，标明他们当年不知道的部分。"
        },
        {
          "id": "ch040.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "档案边出现不同颜色的注释，谁也没拿最后一支笔。"
        }
      ]
    },
    "ch041.crisis": {
      "a": [
        {
          "id": "ch041.crisis.lock26.a.l01",
          "speaker": "缇珐",
          "text": "图纸让地方工匠看，别只交给我一个人。"
        },
        {
          "id": "ch041.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "可逆接线图送进各地工坊，首处风险被红笔圈住。"
        }
      ],
      "b": [
        {
          "id": "ch041.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "医院先备好替代能源，试验一定要能停。"
        },
        {
          "id": "ch041.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "队伍写下退出条件，没有一条被宣布永远有效。"
        }
      ]
    },
    "ch042.crisis": {
      "a": [
        {
          "id": "ch042.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "先记姓名，每个人都该知道自己漏在哪页。"
        },
        {
          "id": "ch042.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "新旧族群交换名册，灯坛下队列缓缓向前。"
        }
      ],
      "b": [
        {
          "id": "ch042.crisis.lock26.b.l01",
          "speaker": "玄璃",
          "text": "不愿公开就先不公开，让当事人决定谁可听见。"
        },
        {
          "id": "ch042.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "私密见证封入档案盒，只有持有人能开锁。"
        }
      ]
    },
    "ch043.crisis": {
      "a": [
        {
          "id": "ch043.crisis.lock26.a.l01",
          "speaker": "缇珐",
          "text": "六灯正在替谁供能，所有城市现在都该知道。"
        },
        {
          "id": "ch043.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "警示传遍各地，城门外的人重新清点粮药。"
        }
      ],
      "b": [
        {
          "id": "ch043.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "让我先送到断电预案，真相迟半日也不会消失。"
        },
        {
          "id": "ch043.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "急救室熄去非必要的灯，只留床边照明。"
        }
      ]
    },
    "ch044.crisis": {
      "a": [
        {
          "id": "ch044.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "把死者的代价说清楚，不能只说自由多好。"
        },
        {
          "id": "ch044.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "人群没有鼓掌，街角有人第一次公开质问主角。"
        }
      ],
      "b": [
        {
          "id": "ch044.crisis.lock26.b.l01",
          "speaker": "雷索",
          "text": "先隔开推搡的人，争论也得让大家平安回家。"
        },
        {
          "id": "ch044.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "广场两边各留代表，卫兵收起朝向居民的兵器。"
        }
      ]
    },
    "ch045.crisis": {
      "a": [
        {
          "id": "ch045.crisis.lock26.a.l01",
          "speaker": "岚音",
          "text": "赞同永昼的人也会流血，我的药箱不问立场。"
        },
        {
          "id": "ch045.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "两个阵营的伤者坐在同一条长椅上，仍不肯对视。"
        }
      ],
      "b": [
        {
          "id": "ch045.crisis.lock26.b.l01",
          "speaker": "雷索",
          "text": "如果我们的人先动手，就由我们来阻止。"
        },
        {
          "id": "ch045.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "驱逐令当场撤下，避难街重新允许双方通行。"
        }
      ]
    },
    "ch046.crisis": {
      "a": [
        {
          "id": "ch046.crisis.lock26.a.l01",
          "speaker": "岚音",
          "text": "护盾先照住病房，活下来的人还需要找路。"
        },
        {
          "id": "ch046.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "病房没有断电，城郊却一寸寸暗下去。"
        }
      ],
      "b": [
        {
          "id": "ch046.crisis.lock26.b.l01",
          "speaker": "朔弦",
          "text": "我打开西侧船路，船多走一趟就多救一些人。"
        },
        {
          "id": "ch046.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "护盾边缘渐渐崩开，撤离灯却一盏接一盏亮起。"
        }
      ]
    },
    "ch047.crisis": {
      "a": [
        {
          "id": "ch047.crisis.lock26.a.l01",
          "speaker": "岚音",
          "text": "东门担架走不了太远，让我带人留在这里。"
        },
        {
          "id": "ch047.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "她留下最后一副绑带，转身走进烟雾。"
        }
      ],
      "b": [
        {
          "id": "ch047.crisis.lock26.b.l01",
          "speaker": "雷索",
          "text": "南门由我打开，孩子先走，西门得留给他们。"
        },
        {
          "id": "ch047.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "三支队伍奔向不同方向，灯塔只剩远方一个小点。"
        }
      ]
    },
    "ch048.crisis": {
      "a": [
        {
          "id": "ch048.crisis.lock26.a.l01",
          "speaker": "朔弦",
          "text": "把救援名单带走，别让后人只听英雄讲谁获救。"
        },
        {
          "id": "ch048.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "湿透的名册被送上末班船，也记着无法登船的人。"
        }
      ],
      "b": [
        {
          "id": "ch048.crisis.lock26.b.l01",
          "speaker": "缇珐",
          "text": "备用灯芯交给医师和水手，坏了才有人能修。"
        },
        {
          "id": "ch048.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "船舱里传递一盏盏手灯，岸上巨灯却再也照不远。"
        }
      ]
    },
    "ch049.crisis": {
      "a": [
        {
          "id": "ch049.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "获救的要写，失去亲人的也不能被删去。"
        },
        {
          "id": "ch049.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "邮站名册比传说更重，年轻队伍沉默了许久。"
        }
      ],
      "b": [
        {
          "id": "ch049.crisis.lock26.b.l01",
          "speaker": "诺依",
          "text": "先救眼前的人，争论英雄可以等他们安全。"
        },
        {
          "id": "ch049.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "年轻旅人递来清水，第一次没再嘲笑旧队伍。"
        }
      ]
    },
    "ch050.crisis": {
      "a": [
        {
          "id": "ch050.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "救命不能靠一次破例，下一位病人也要有门。"
        },
        {
          "id": "ch050.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "他摊开临时通行证，请求写下永久复查日期。"
        }
      ],
      "b": [
        {
          "id": "ch050.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "送药的人要留记录，别让病历成新一道围墙。"
        },
        {
          "id": "ch050.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "医师共同签名，药袋越过街心那条旧线。"
        }
      ]
    },
    "ch051.crisis": {
      "a": [
        {
          "id": "ch051.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "我带来的是有退路的新地图，不是英雄旧旗。"
        },
        {
          "id": "ch051.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "主角先看粮车和水渠的方向，才慢慢接过计划。"
        }
      ],
      "b": [
        {
          "id": "ch051.crisis.lock26.b.l01",
          "speaker": "诺依",
          "text": "手灯放在门外，想走时你自己拿。"
        },
        {
          "id": "ch051.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "农庄窗台上的灯亮了一夜，没人敲门催他。"
        }
      ]
    },
    "ch052.crisis": {
      "a": [
        {
          "id": "ch052.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "路线让我安排，不放心的人现在就来指出。"
        },
        {
          "id": "ch052.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "旧队友先后走到地图前，沉默地改动风险记号。"
        }
      ],
      "b": [
        {
          "id": "ch052.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "领队轮着做，今晚先听我的休息安排。"
        },
        {
          "id": "ch052.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "驿站墙上出现新值守表，没有英雄专用的一行。"
        }
      ]
    },
    "ch053.crisis": {
      "a": [
        {
          "id": "ch053.crisis.lock26.a.l01",
          "speaker": "主角",
          "text": "不求他们原谅，先修好没人能安全走过的桥。"
        },
        {
          "id": "ch053.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "村民让出一条路，却没收回昨日的责备。"
        }
      ],
      "b": [
        {
          "id": "ch053.crisis.lock26.b.l01",
          "speaker": "诺依",
          "text": "修复顺序交村民投票，我们只负责兑现。"
        },
        {
          "id": "ch053.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "投票箱放在灯塔脚下，主角最后才投下票。"
        }
      ]
    },
    "ch054.crisis": {
      "a": [
        {
          "id": "ch054.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "我来分工，也请大家指出我的失误。"
        },
        {
          "id": "ch054.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "主角退到救援队后方，不再替他喊命令。"
        }
      ],
      "b": [
        {
          "id": "ch054.crisis.lock26.b.l01",
          "speaker": "雷索",
          "text": "谁懂绞盘谁就来指挥，军衔不能耽误救人。"
        },
        {
          "id": "ch054.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "工匠接过信号旗，路线避开坍塌的地基。"
        }
      ]
    },
    "ch055.crisis": {
      "a": [
        {
          "id": "ch055.crisis.lock26.a.l01",
          "speaker": "岚音",
          "text": "先让冻着的人有房住，协议要写清归还办法。"
        },
        {
          "id": "ch055.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "老妇把钥匙暂借给难民，约好修缮后再商量。"
        }
      ],
      "b": [
        {
          "id": "ch055.crisis.lock26.b.l01",
          "speaker": "维莎",
          "text": "资金去向先贴出来，不住这里的人也能查。"
        },
        {
          "id": "ch055.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "新门牌背面写明使用期限，旧主人的姓名没有消失。"
        }
      ]
    },
    "ch056.crisis": {
      "a": [
        {
          "id": "ch056.crisis.lock26.a.l01",
          "speaker": "雷索",
          "text": "收费和撤退权都写在门口，公会不是私兵。"
        },
        {
          "id": "ch056.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "首张委托书明确写着冒险者有权拒绝不公命令。"
        }
      ],
      "b": [
        {
          "id": "ch056.crisis.lock26.b.l01",
          "speaker": "诺依",
          "text": "请居民坐进监督席，他们更懂街道缺什么。"
        },
        {
          "id": "ch056.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "大厅撤去佣兵旗，换上一张可以自由入座的长桌。"
        }
      ]
    },
    "ch057.crisis": {
      "a": [
        {
          "id": "ch057.crisis.lock26.a.l01",
          "speaker": "伊泽",
          "text": "节日轮流办吧，每一种歌都要有自己的夜晚。"
        },
        {
          "id": "ch057.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "广场木牌列出不同节庆，给尚未商定的人留了空白。"
        }
      ],
      "b": [
        {
          "id": "ch057.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "爱热闹的人能跳舞，怕吵的人也要有去处。"
        },
        {
          "id": "ch057.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "安静的小巷通向灯会，孩子替邻居挂起柔光纸灯。"
        }
      ]
    },
    "ch058.crisis": {
      "a": [
        {
          "id": "ch058.crisis.lock26.a.l01",
          "speaker": "维莎",
          "text": "证据先保好，再让受伤的人亲眼听我说明。"
        },
        {
          "id": "ch058.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "她把自己的签章放在档案盒上，没请队伍代为辩护。"
        }
      ],
      "b": [
        {
          "id": "ch058.crisis.lock26.b.l01",
          "speaker": "维莎",
          "text": "先去见受害者代表，他们有权质疑每个数字。"
        },
        {
          "id": "ch058.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "听证厅前排留出空席，席位姓名由家属自己填。"
        }
      ]
    },
    "ch059.crisis": {
      "a": [
        {
          "id": "ch059.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "不拿武器的人也是城里的人，不能因此没粮吃。"
        },
        {
          "id": "ch059.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "送餐者与守城者的姓名写在同一本互助册上。"
        }
      ],
      "b": [
        {
          "id": "ch059.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "先问大家愿做什么，别把医疗队也当征兵表。"
        },
        {
          "id": "ch059.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "志愿者领取不同袖章，没有队伍通往强制登记处。"
        }
      ]
    },
    "ch060.crisis": {
      "a": [
        {
          "id": "ch060.crisis.lock26.a.l01",
          "speaker": "维莎",
          "text": "各户自愿接入，也要能随时关闭自家的灯。"
        },
        {
          "id": "ch060.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "第一处节点亮起时，屋主亲手试了独立开关。"
        }
      ],
      "b": [
        {
          "id": "ch060.crisis.lock26.b.l01",
          "speaker": "缇珐",
          "text": "先单独试医院节点，故障时救人比保指标重要。"
        },
        {
          "id": "ch060.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "备用节点在黑暗里发亮，与中央巨灯之间不再有链条。"
        }
      ]
    },
    "ch061.crisis": {
      "a": [
        {
          "id": "ch061.crisis.lock26.a.l01",
          "speaker": "朔弦",
          "text": "返航补给点先建好，我不想再添失踪船员。"
        },
        {
          "id": "ch061.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "尾舱放入两份返航图，分别交给不同水手。"
        }
      ],
      "b": [
        {
          "id": "ch061.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "医护舱的门必须从里头打开，再高的天也一样。"
        },
        {
          "id": "ch061.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "轻巧药箱替换装饰甲板，船终于能顺利升空。"
        }
      ]
    },
    "ch062.crisis": {
      "a": [
        {
          "id": "ch062.crisis.lock26.a.l01",
          "speaker": "维莎",
          "text": "报告要标明未知处，错误不能再被藏起来。"
        },
        {
          "id": "ch062.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "七份原件交给不同见证者，自动指令停在最后一行。"
        }
      ],
      "b": [
        {
          "id": "ch062.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "先留住病患的姓名，再切断旧系统。"
        },
        {
          "id": "ch062.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "医疗记录完整导出，没有一个人被标成可忽略异常。"
        }
      ]
    },
    "ch063.crisis": {
      "a": [
        {
          "id": "ch063.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "未来的那格留白吧，了解父亲不等于重复他的路。"
        },
        {
          "id": "ch063.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "主角将年表末格留空，许久没有写下日期。"
        }
      ],
      "b": [
        {
          "id": "ch063.crisis.lock26.b.l01",
          "speaker": "主角",
          "text": "研究事实可以公开，但不能替澄舟写一封道歉。"
        },
        {
          "id": "ch063.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "旧工作台上的留言完整抄下，封套只写他的姓名。"
        }
      ]
    },
    "ch064.crisis": {
      "a": [
        {
          "id": "ch064.crisis.lock26.a.l01",
          "speaker": "玄璃",
          "text": "开放未来不能靠新总开关，让我们逐区确认。"
        },
        {
          "id": "ch064.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "七地分别收到退出说明，停住的计时针重新摆动。"
        }
      ],
      "b": [
        {
          "id": "ch064.crisis.lock26.b.l01",
          "speaker": "缇珐",
          "text": "把控制权分出去，以后连我也得申请权限。"
        },
        {
          "id": "ch064.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "唯一的签名栏变成七个并列窗口。"
        }
      ]
    },
    "ch065.crisis": {
      "a": [
        {
          "id": "ch065.crisis.lock26.a.l01",
          "speaker": "雷索",
          "text": "要记罪也要记善，但记下不等于赦免。"
        },
        {
          "id": "ch065.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "议会桌上留下七份互相争执的卷宗，没有被烧毁。"
        }
      ],
      "b": [
        {
          "id": "ch065.crisis.lock26.b.l01",
          "speaker": "维莎",
          "text": "来源和责任写清楚，后人有权不同意结论。"
        },
        {
          "id": "ch065.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "旁听者第一次提出与七守门者不同的证词。"
        }
      ]
    },
    "ch066.crisis": {
      "a": [
        {
          "id": "ch066.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "把七地的声音都带上，最后的门不该只认英雄。"
        },
        {
          "id": "ch066.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "天桥终点出现相连灯光，却仍保持各自的亮暗。"
        }
      ],
      "b": [
        {
          "id": "ch066.crisis.lock26.b.l01",
          "speaker": "玄璃",
          "text": "先问门后居民是否愿意开，我们有返航坐标。"
        },
        {
          "id": "ch066.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "终门沉默一阵，另一侧的回应灯慢慢亮了。"
        }
      ]
    },
    "ch067.crisis": {
      "a": [
        {
          "id": "ch067.crisis.lock26.a.l01",
          "speaker": "玄璃",
          "text": "要说清离开的损失，也说明留下的人可以反悔。"
        },
        {
          "id": "ch067.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "园丁剪下第一朵枯花，没人责怪他让春日结束。"
        }
      ],
      "b": [
        {
          "id": "ch067.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "不能强迫他们快乐，也不能强迫他们离开。"
        },
        {
          "id": "ch067.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "一户关门休息，另一户让孩子先看门外的云。"
        }
      ]
    },
    "ch068.crisis": {
      "a": [
        {
          "id": "ch068.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "他们曾来过就值得记住，不必将这一刻永远留下。"
        },
        {
          "id": "ch068.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "长廊的幻影缓缓点头，留下未说完的告别。"
        }
      ],
      "b": [
        {
          "id": "ch068.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "先和伙伴讲讲吧，并非所有人都准备好了。"
        },
        {
          "id": "ch068.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "队伍等到最后一人走出长廊，没有催促。"
        }
      ]
    },
    "ch069.crisis": {
      "a": [
        {
          "id": "ch069.crisis.lock26.a.l01",
          "speaker": "维莎",
          "text": "把真相交给居民，藏了代价的选择不叫同意。"
        },
        {
          "id": "ch069.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "居民在卷册中读到未出生孩子的空白姓名。"
        }
      ],
      "b": [
        {
          "id": "ch069.crisis.lock26.b.l01",
          "speaker": "岚音",
          "text": "留下的人也需要照护，出口不该变成惩罚。"
        },
        {
          "id": "ch069.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "城市画出两条同样明亮的路，尚未决定的人仍能停留。"
        }
      ]
    },
    "ch070.crisis": {
      "a": [
        {
          "id": "ch070.crisis.lock26.a.l01",
          "speaker": "雷索",
          "text": "把反对意见留在纪要里，不许只存胜者的话。"
        },
        {
          "id": "ch070.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "七地没有齐声鼓掌，却共同签下公开日期。"
        }
      ],
      "b": [
        {
          "id": "ch070.crisis.lock26.b.l01",
          "speaker": "诺依",
          "text": "先写谁承担失败的后果，不能把风险推给孩子。"
        },
        {
          "id": "ch070.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "各地代表在城名后写下责任，也留出了修改位置。"
        }
      ]
    },
    "ch071.crisis": {
      "a": [
        {
          "id": "ch071.crisis.lock26.a.l01",
          "speaker": "主角",
          "text": "我不能保证人人幸福，你也不能因此替所有人关门。"
        },
        {
          "id": "ch071.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "旧日幻象浮现裂缝，伙伴的声音从深处传来。"
        }
      ],
      "b": [
        {
          "id": "ch071.crisis.lock26.b.l01",
          "speaker": "诺依",
          "text": "我们会犯错，也会阻止彼此犯错，不必你一人承担。"
        },
        {
          "id": "ch071.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "终幕殿外响起不同的钟声，没有一声命令别的停止。"
        }
      ]
    },
    "ch072.crisis": {
      "a": [
        {
          "id": "ch072.crisis.lock26.a.l01",
          "speaker": "诺依",
          "text": "让见证者先说担忧，责任该写给还要生活的人。"
        },
        {
          "id": "ch072.crisis.lock26.a.l02",
          "speaker": "旁白",
          "text": "记录台展开最后一张空白纸，没有预先写好的结论。"
        }
      ],
      "b": [
        {
          "id": "ch072.crisis.lock26.b.l01",
          "speaker": "主角",
          "text": "我会向下一代解释道路，却不要求他们服从我们。"
        },
        {
          "id": "ch072.crisis.lock26.b.l02",
          "speaker": "旁白",
          "text": "诺依提起手灯，望向海岸上正要出门的人。"
        }
      ]
    }
  }
}
