        "story.ch012.done"
      ],
      "chapter_start_flag": "ch013.started",
      "chapter_complete_flag": "story.ch013.done",
      "lead_character": "缇珐",
      "summary": "在赤炉联邦·七号矿坑，调查矿工消失与星矿异常发光。矿工家属在名单中发现自己的姓名已经被划去。最终，众人救出幸存者，携带矿石样本前往工匠总署。",
      "production_status": "scripted_blocking_v1",
      "recommended_level": [
        15,
        19
      ],
      "boss": "噬忆矿螳",
      "scenes": [
        {
          "id": "ch013.opening",
          "title": "到达：赤炉联邦·七号矿坑",
          "trigger": {
            "type": "chapter_enter",
            "region": "赤炉联邦·七号矿坑"
          },
          "dialogue": [
            {
              "id": "ch013.opening.l01",
              "speaker": "旁白",
              "text": "【赤炉联邦·七号矿坑】空气中藏着异样的气息。"
            },
            {
              "id": "ch013.opening.l02",
              "speaker": "缇珐",
              "text": "别碰那颗石头，它亮得像太阳，温度却低得像尸体。"
            },
            {
              "id": "ch013.opening.l03",
              "speaker": "主角",
              "text": "先把眼前的事弄清楚。调查矿工消失与星矿异常发光。"
            },
            {
              "id": "ch013.opening.l04",
              "speaker": "缇珐",
              "text": "别忘了，沿途的人也有自己的故事。"
            }
          ],
          "objectives": [
            {
              "type": "reach",
              "target": "赤炉联邦·七号矿坑"
            },
            {
              "type": "interact",
              "target": "ch013.key_npc"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch013.started",
              "value": true
            }
          ]
        },
        {
          "id": "ch013.investigate",
          "title": "调查线索",
          "trigger": {
            "type": "interact",
            "target": "ch013.clue"
          },
          "dialogue": [
            {
              "id": "ch013.investigate.l01",
              "speaker": "旁白",
              "text": "众人在赤炉联邦·七号矿坑找到了一处被忽视的痕迹。"
            },
            {
              "id": "ch013.investigate.l02",
              "speaker": "缇珐",
              "text": "矿井产量在停工时仍持续增长，账册记录着不存在的班次。"
            },
            {
              "id": "ch013.investigate.l03",
              "speaker": "主角",
              "text": "先别急着下结论。还有谁能证实这件事？"
            },
            {
              "id": "ch013.investigate.l04",
              "speaker": "旁白",
              "text": "日志、物件与目击证言彼此印证，事件终于露出轮廓。"
            }
          ],
          "objectives": [
            {
              "type": "inspect",
              "target": "ch013.clue"
            },
            {
              "type": "speak",
              "target": "ch013.witness"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch013.evidence",
              "value": true
            }
          ]
        },
        {
          "id": "ch013.crisis",
          "title": "真相与冲突",
          "trigger": {
            "type": "interact",
            "target": "ch013.crisis",
            "requires_flags": [
              "ch013.evidence"
            ]
          },
          "dialogue": [
            {
              "id": "ch013.crisis.l01",
              "speaker": "旁白",
              "text": "当最后一份证据摆上桌面，原本平静的局面终于被打破。"
            },
            {
              "id": "ch013.crisis.l02",
              "speaker": "缇珐",
              "text": "矿工家属在名单中发现自己的姓名已经被划去。"
            },
            {
              "id": "ch013.crisis.l03",
              "speaker": "主角",
              "text": "不能只顾眼前的胜负。谁会因为我们的决定付出代价？"
            },
            {
              "id": "ch013.crisis.l04",
              "speaker": "缇珐",
              "text": "这一次由你决定如何开口。我会一起承担后果。"
            }
          ],
          "objectives": [
            {
              "type": "decide",
              "target": "ch013.choice"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch013.decision_made",
              "value": true
            }
          ],
          "choice": {
            "id": "ch013.choice",
            "prompt": "面对眼前的矛盾，你打算怎样行动？",
            "options": [
              {
                "id": "listen",
                "label": "先听当事人的解释",
                "sets": {
                  "ch013.approach": "listen"
                }
              },
              {
                "id": "act",
                "label": "先保护可能受伤的人",
                "sets": {
                  "ch013.approach": "act"
                }
              }
            ]
          },
          "encounter": {
            "enemy_id": "boss.ch013",
            "display_name": "噬忆矿螳",
            "win_flag": "ch013.battle_won",
            "recommended_level": 18
          }
        },
        {
          "id": "ch013.resolve",
          "title": "事件落幕",
          "trigger": {
            "type": "scene_after",
            "requires_flags": [
              "ch013.battle_won"
            ]
          },
          "dialogue": [
            {
              "id": "ch013.resolve.l01",
              "speaker": "旁白",
              "text": "风声渐弱，人们终于有机会面对自己刚才不愿承认的事。"
            },
            {
              "id": "ch013.resolve.l02",
              "speaker": "缇珐",
              "text": "众人救出幸存者，携带矿石样本前往工匠总署。"
            },
            {
              "id": "ch013.resolve.l03",
              "speaker": "主角",
              "text": "总有些事，不能只写成一行冒险记录。"
            },
            {
              "id": "ch013.resolve.l04",
              "speaker": "旁白",
              "text": "【任务完成】矿坑里的第二个太阳。新的道路正在展开。"
            }
          ],
          "objectives": [
            {
              "type": "finish_chapter",
              "target": "ch013"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "story.ch013.done",
