{
  "schema": "starlit.story.phase17.life_branch_arcs.v1",
  "status": "authored_branch_arcs_not_runtime_bound",
  "batch": "04",
  "quests": [
    {
      "id": "sq_life_10",
      "late_chapter": "ch043",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "披风留在边村",
            "dialogue": [
              {
                "id": "sq_life_10.p17.a.followup.l01",
                "speaker": "雷索",
                "text": "披风是村民为我留的，今后由村里保管。"
              },
              {
                "id": "sq_life_10.p17.a.followup.l02",
                "speaker": "老农",
                "text": "内衬缝着救出的人名，不用拿它宣扬一个人的勇敢。"
              },
              {
                "id": "sq_life_10.p17.a.followup.l03",
                "speaker": "村童",
                "text": "我想听那条救命沟是怎么挖开的。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "披风的布料修补",
            "dialogue": [
              {
                "id": "sq_life_10.p17.a.community.l01",
                "speaker": "裁缝",
                "text": "破口我只加支撑，不拆原来的名字。"
              },
              {
                "id": "sq_life_10.p17.a.community.l02",
                "speaker": "老农",
                "text": "有些家属还不愿公开名字，先用封布盖住。"
              },
              {
                "id": "sq_life_10.p17.a.community.l03",
                "speaker": "雷索",
                "text": "这件衣服能破，记录不必跟着消失。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "多年后的救援课",
            "dialogue": [
              {
                "id": "sq_life_10.p17.a.revisit.l01",
                "speaker": "村童",
                "text": "我们学会了挖浅排水沟，不会乱进洪水里。"
              },
              {
                "id": "sq_life_10.p17.a.revisit.l02",
                "speaker": "雷索",
                "text": "这比穿我的旧披风有用，先学会求援。"
              },
              {
                "id": "sq_life_10.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "村史室保留披风，门外贴着新的防灾图。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "征求各户同意",
            "dialogue": [
              {
                "id": "sq_life_10.p17.b.followup.l01",
                "speaker": "老农",
                "text": "先去问名字写在披风上的家庭。"
              },
              {
                "id": "sq_life_10.p17.b.followup.l02",
                "speaker": "雷索",
                "text": "没同意的名字暂时遮住，不能为了巡展图方便。"
              },
              {
                "id": "sq_life_10.p17.b.followup.l03",
                "speaker": "裁缝",
                "text": "我做一层可拆内衬保护旧针脚。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "流动展的第一站",
            "dialogue": [
              {
                "id": "sq_life_10.p17.b.community.l01",
                "speaker": "远村少年",
                "text": "原来救人的不是一名将军，还有帮忙搬石头的村民。"
              },
              {
                "id": "sq_life_10.p17.b.community.l02",
                "speaker": "雷索",
                "text": "把救援名单、当地水路和安全须知一起展。"
              },
              {
                "id": "sq_life_10.p17.b.community.l03",
                "speaker": "志愿者",
                "text": "每站撤展由本地记录员签收。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "披风回到村里",
            "dialogue": [
              {
                "id": "sq_life_10.p17.b.revisit.l01",
                "speaker": "老农",
                "text": "巡展结束了，披风仍完整回来了。"
              },
              {
                "id": "sq_life_10.p17.b.revisit.l02",
                "speaker": "雷索",
                "text": "下次出借要重新问家属，不能一次同意就永久授权。"
              },
              {
                "id": "sq_life_10.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "各地留下自己的防洪笔记，披风没有成为军旗。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_11",
      "late_chapter": "ch025",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "节庆寻人点",
            "dialogue": [
              {
                "id": "sq_life_11.p17.a.followup.l01",
                "speaker": "女童",
                "text": "我的围巾还没找回来，妈妈说先到这里等。"
              },
              {
                "id": "sq_life_11.p17.a.followup.l02",
                "speaker": "志愿者",
                "text": "我们用形状标记失物，不让孩子独自在人群里跑。"
              },
              {
                "id": "sq_life_11.p17.a.followup.l03",
                "speaker": "岚音",
                "text": "寻人点靠近医务棚，能先让迷路的人喝水。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "找回红围巾",
            "dialogue": [
              {
                "id": "sq_life_11.p17.a.community.l01",
                "speaker": "摊贩",
                "text": "围巾是在灯笼架后捡到的，我没有拿去卖。"
              },
              {
                "id": "sq_life_11.p17.a.community.l02",
                "speaker": "女童",
                "text": "那颗歪星星是妈妈缝的。"
              },
              {
                "id": "sq_life_11.p17.a.community.l03",
                "speaker": "志愿者",
                "text": "先核对监护人，再把失物交回。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "下一次白夜祭",
            "dialogue": [
              {
                "id": "sq_life_11.p17.a.revisit.l01",
                "speaker": "女童",
                "text": "现在我知道和妈妈走散就去那面红旗下面。"
              },
              {
                "id": "sq_life_11.p17.a.revisit.l02",
                "speaker": "志愿者",
                "text": "寻人处也会照顾听不见广播的孩子。"
              },
              {
                "id": "sq_life_11.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "红围巾在灯市里轻轻飘动，寻人点仍有人值守。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "核对歪星针脚",
            "dialogue": [
              {
                "id": "sq_life_11.p17.b.followup.l01",
                "speaker": "母亲",
                "text": "星星有一角缝歪了，是我修补过的。"
              },
              {
                "id": "sq_life_11.p17.b.followup.l02",
                "speaker": "摊贩",
                "text": "可以在摊位旁核对，我不把孩子领到陌生地方。"
              },
              {
                "id": "sq_life_11.p17.b.followup.l03",
                "speaker": "女童",
                "text": "我来指给你们看那根蓝线。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "母女约定见面地",
            "dialogue": [
              {
                "id": "sq_life_11.p17.b.community.l01",
                "speaker": "母亲",
                "text": "以后若走散，先在钟楼边的医务棚等。"
              },
              {
                "id": "sq_life_11.p17.b.community.l02",
                "speaker": "女童",
                "text": "我会先向值勤的人求助，不独自追商贩。"
              },
              {
                "id": "sq_life_11.p17.b.community.l03",
                "speaker": "岚音",
                "text": "大人也应记清地点，不能只要求孩子记住。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "记得的那颗星",
            "dialogue": [
              {
                "id": "sq_life_11.p17.b.revisit.l01",
                "speaker": "女童",
                "text": "围巾又戴上啦，我也知道该去哪里找妈妈。"
              },
              {
                "id": "sq_life_11.p17.b.revisit.l02",
                "speaker": "母亲",
                "text": "我们练习过，不是因为不相信你。"
              },
              {
                "id": "sq_life_11.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "摊贩将认领流程写好，灯市不再只靠运气找人。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_12",
      "late_chapter": "ch027",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "证人自己念",
            "dialogue": [
              {
                "id": "sq_life_12.p17.a.followup.l01",
                "speaker": "宫廷乐师",
                "text": "只有一首歌的时间，我先留出沉默给证人。"
              },
              {
                "id": "sq_life_12.p17.a.followup.l02",
                "speaker": "证人",
                "text": "只念经确认的部分，我不愿公开姓名。"
              },
              {
                "id": "sq_life_12.p17.a.followup.l03",
                "speaker": "伊泽",
                "text": "乐器压低，让听众听清字句。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "舞台护送",
            "dialogue": [
              {
                "id": "sq_life_12.p17.a.community.l01",
                "speaker": "后台助手",
                "text": "出入口通畅，证人想离开时有人陪同。"
              },
              {
                "id": "sq_life_12.p17.a.community.l02",
                "speaker": "证人",
                "text": "我讲到这里就够了，剩下的交给档案员。"
              },
              {
                "id": "sq_life_12.p17.a.community.l03",
                "speaker": "宫廷乐师",
                "text": "演出不因你暂停就算失败。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "演出后的证据箱",
            "dialogue": [
              {
                "id": "sq_life_12.p17.a.revisit.l01",
                "speaker": "观众",
                "text": "我记住的不是独唱，而是那段真实的日期。"
              },
              {
                "id": "sq_life_12.p17.a.revisit.l02",
                "speaker": "证人",
                "text": "证据已安全入档，今后仍能申请更正。"
              },
              {
                "id": "sq_life_12.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "乐师下一次只唱歌，不要求每场都有人受伤才能动人。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "代读授权书",
            "dialogue": [
              {
                "id": "sq_life_12.p17.b.followup.l01",
                "speaker": "档案员",
                "text": "我只读证人允许公开的段落。"
              },
              {
                "id": "sq_life_12.p17.b.followup.l02",
                "speaker": "宫廷乐师",
                "text": "曲子可以短一点，别为了高潮加上没说过的话。"
              },
              {
                "id": "sq_life_12.p17.b.followup.l03",
                "speaker": "证人",
                "text": "我坐在幕后听，觉得不合适可以示意停。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "歌词与原件区分",
            "dialogue": [
              {
                "id": "sq_life_12.p17.b.community.l01",
                "speaker": "档案员",
                "text": "书面证词保留原句，歌曲中的意象注明为改写。"
              },
              {
                "id": "sq_life_12.p17.b.community.l02",
                "speaker": "伊泽",
                "text": "不能让观众把押韵当作事实证明。"
              },
              {
                "id": "sq_life_12.p17.b.community.l03",
                "speaker": "宫廷乐师",
                "text": "演完请大家去档案处查询，不必追问证人的私事。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "新的后台惯例",
            "dialogue": [
              {
                "id": "sq_life_12.p17.b.revisit.l01",
                "speaker": "证人",
                "text": "下次我愿自己讲，也可能不愿，没有人替我承诺。"
              },
              {
                "id": "sq_life_12.p17.b.revisit.l02",
                "speaker": "档案员",
                "text": "代读流程与保密条款都能重新申请。"
              },
              {
                "id": "sq_life_12.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "舞台留下选择上台或不上台的权利，证词得以继续被听见。"
              }
            ]
          }
        ]
      }
    }
  ]
}
