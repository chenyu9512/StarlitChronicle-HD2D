      "insertion": "after_choice_commit_before_encounter",
      "optional": true,
      "independent_route": false,
      "dialogue": [
        {
          "id": "ch034.p13.choice.act.l01",
          "speaker": "缇珐",
          "text": "回收规则里没有自主退出栏，这是规则的缺陷。"
        },
        {
          "id": "ch034.p13.choice.act.l02",
          "speaker": "玄璃",
          "text": "我的名字和去处要由我自己填写。"
        },
        {
          "id": "ch034.p13.choice.act.l03",
          "speaker": "主角",
          "text": "登记先保障安全，身份以后也可以自主更改。"
        }
      ]
    },
    {
