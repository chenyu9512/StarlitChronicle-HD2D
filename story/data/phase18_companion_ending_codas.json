        {
          "id": "coda.p18.leiso.c.a.l01",
          "speaker": "旁白",
          "text": "分散灯网下旧军团的权力被地方议事会重新审视，雷索交回最后一枚纪念徽章。"
        },
        {
          "id": "coda.p18.leiso.c.a.l02",
          "speaker": "雷索",
          "text": "我留给他们的是能说不的制度，不是一把要代代继承的剑。"
        },
        {
          "id": "coda.p18.leiso.c.a.l03",
          "speaker": "旁白",
          "text": "守夜志愿者与救护员共同监督，轮值名单由居民修订。"
        }
      ]
    },
