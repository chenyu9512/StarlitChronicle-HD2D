      "runtime_registered": false,
      "dialogue": [
        {
          "id": "coda.p18.leiso.a.a.l01",
          "speaker": "旁白",
          "text": "新七灯秩序的城防队没有为雷索恢复世袭官位，而请他参与公开训练。"
        },
        {
          "id": "coda.p18.leiso.a.a.l02",
          "speaker": "雷索",
          "text": "秩序若不能被质疑，就会再次把手中的剑对准居民。"
        },
        {
          "id": "coda.p18.leiso.a.a.l03",
          "speaker": "旁白",
          "text": "志愿防卫与护理、修桥共享席位，守夜册不再只记战斗功劳。"
        }
      ]
    },
