      "dialogue": [
        {
          "id": "coda.p18.lanyin.c.a.l01",
          "speaker": "旁白",
          "text": "十二社区互相借调医师和药箱，岚音第一次不必守在主灯中枢。"
        },
        {
          "id": "coda.p18.lanyin.c.a.l02",
          "speaker": "岚音",
          "text": "最好的灯不是永远不灭的一盏，是有人熄灯休息时别处还能亮。"
        },
        {
          "id": "coda.p18.lanyin.c.a.l03",
          "speaker": "旁白",
          "text": "联合医馆以公开轮休表和患者告知维持各地接诊。"
        }
      ]
    },
