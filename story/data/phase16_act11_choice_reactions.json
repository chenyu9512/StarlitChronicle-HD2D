      "once_only": true,
      "dialogue": [
        {
          "id": "ch064.p16.choice.protect.l01",
          "speaker": "缇珐",
          "text": "本地控制权先交给能负责维护的人，中央不再一键锁住所有节点。"
        },
        {
          "id": "ch064.p16.choice.protect.l02",
          "speaker": "雷索",
          "text": "每处需要独立求援与停机，不能只依靠主角回头救。"
        },
        {
          "id": "ch064.p16.choice.protect.l03",
          "speaker": "诺依",
          "text": "任何居民都可以质问我们正在做的决定。"
        }
      ]
    },
