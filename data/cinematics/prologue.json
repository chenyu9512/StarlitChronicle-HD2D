{
  "schema": "starlit.cinematic.timeline.v1",
  "version": 1,
  "minimum_control": {
    "seen_skip": true,
    "save_checkpoint": true,
    "restore_after_skip": true
  },
  "beats": {
    "cold_open": {
      "title": "被遗忘的星光",
      "sub": "一段尚未发生的记忆",
      "image": "res://assets/art/backdrops/coast/tide_lighthouse.png",
      "tone": "omen",
      "lines": [
        [
          "未知的声音",
          "若有一天，连名字也从世界上消失……"
        ],
        [
          "未知的声音",
          "还会有人记得，回家的那条路吗？"
        ],
        [
          "旁白",
          "很久以前，海边有一座点亮归航灯火的小村庄。"
        ]
      ]
    },
    "prologue_0": {
      "title": "灯祭清晨",
      "sub": "十年前 · 晨露村",
      "image": "res://assets/art/backdrops/coast/chengzhou_house.png",
      "tone": "warm",
      "lines": [
        [
          "旁白",
          "窗外的海风带着盐味，屋檐下挂着一串细小的星灯。"
        ],
        [
          "澄舟",
          "别睡了。等会儿还要一起去搭灯架。"
        ]
      ]
    },
    "prologue_1": {
      "title": "药草篮与约定",
      "sub": "晨露村 · 花田",
      "image": "res://assets/art/backdrops/coast/morning_dew_village.png",
      "tone": "warm",
      "lines": [
        [
          "岚音",
          "等一下！我还要把药送去药房呢。"
        ],
        [
          "旁白",
          "灯祭还未开始，两个人已经有了一件必须一起完成的小事。"
        ]
      ]
    },
    "prologue_2": {
      "title": "热闹的星灯祭",
      "sub": "晨露村 · 星灯祭场",
      "image": "res://assets/art/backdrops/coast/morning_dew_village.png",
      "tone": "festival",
      "lines": [
        [
          "旁白",
          "摊位的香气、人们的谈笑和海潮声，汇成一年之中最热闹的傍晚。"
        ]
      ]
    },
    "prologue_3": {
      "title": "古老的约定",
      "sub": "晨露村 · 旧石碑",
      "image": "res://assets/art/backdrops/coast/tide_lighthouse.png",
      "tone": "mystery",
      "lines": [
        [
          "守灯人",
          "只要有人念出名字，归家的路便不至于完全消失。"
        ]
      ]
    },
    "prologue_4": {
      "title": "登上潮风灯塔",
      "sub": "落日将近",
      "image": "res://assets/art/backdrops/coast/tide_lighthouse.png",
      "tone": "mystery",
      "lines": [
        [
          "澄舟",
          "握紧栏杆。勇敢不是不害怕，而是知道自己为何要站在这里。"
        ]
      ]
    },
    "prologue_5": {
      "title": "黑色流星",
      "sub": "星落之夜 · 所有灯火熄灭",
      "image": "res://assets/art/backdrops/coast/tide_lighthouse.png",
      "tone": "danger",
      "lines": [
        [
          "旁白",
          "一颗不发光的流星划破天空。海面上的归航灯，一盏接一盏熄灭。"
        ],
        [
          "陌生的声音",
          "第七盏灯……终于找到你了。"
        ]
      ]
    },
    "prologue_6": {
      "title": "灯灭之后",
      "sub": "晨露村 · 海边石阶",
      "image": "res://assets/art/backdrops/coast/tide_lighthouse.png",
      "tone": "danger",
      "lines": [
        [
          "岚音",
          "快走！海雾追上来了！"
        ],
        [
          "旁白",
          "澄舟留在灯塔门后。那扇门，再也没有打开。"
        ]
      ]
    },
    "prologue_7": {
      "title": "无人记得的人",
      "sub": "晨露村 · 次日清晨",
      "image": "res://assets/art/backdrops/coast/chengzhou_house.png",
      "tone": "grief",
      "lines": [
        [
          "村长",
          "孩子……村里从来没有这个人。"
        ],
        [
          "旁白",
          "桌下却有一张署着澄舟名字的旧收据。"
        ]
      ]
    },
    "prologue_8": {
      "title": "十年之后",
      "sub": "晨露村 · 澄舟旧屋",
      "image": "res://assets/art/backdrops/coast/chengzhou_house.png",
      "tone": "hope",
      "lines": [
        [
          "旁白",
          "同一扇窗，同一阵潮风，空着的椅子却再没有人坐。"
        ],
        [
          "岚音",
          "这次一起去查清楚。别把我丢在后面。"
        ]
      ]
    }
  }
}
