                  "side.cq_lanyin_06.approach": "b"
                }
              }
            ]
          }
        },
        {
          "id": "cq_lanyin_06.resolution",
          "objective": "向当事人确认结果",
          "dialogue": [
            {
              "id": "cq_lanyin_06.3.l01",
              "speaker": "旁白",
              "text": "医馆实行轮班与紧急分诊。"
            },
            {
              "id": "cq_lanyin_06.3.l02",
              "speaker": "年轻医师",
              "text": "昨夜我睡了整晚，醒来第一次没有急着认错。"
            },
            {
              "id": "cq_lanyin_06.3.l03",
              "speaker": "岚音",
              "text": "我也按新制度休息，不把自己当作例外。"
            }
          ],
          "effects": [
