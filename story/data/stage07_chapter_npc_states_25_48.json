        "completed": {
          "id": "ch042.npc.complete",
          "speaker": "旧族代表",
          "text": "有些事情我们仍谈不拢。至少现在可以坐下来谈。",
          "conditions": {
            "required_flags": [
              "story.ch042.done"
            ]
          },
          "source_dialogue_id": "ch042.resolve.l02"
        }
