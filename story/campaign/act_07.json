          "dialogue": [
            {
              "id": "ch037.resolve.l01",
              "speaker": "旁白",
              "text": "风暴暂时平息，有些问题却仍在等待回答。"
            },
            {
              "id": "ch037.resolve.l02",
              "speaker": "朔弦",
              "text": "第一座失落岛屿重现，朔弦终于看见儿时码头上的歪树。"
            },
            {
              "id": "ch037.resolve.l03",
              "speaker": "主角",
              "text": "把这段经历记下来。不要让它再被抹去。"
            },
            {
              "id": "ch037.resolve.l04",
              "speaker": "旁白",
              "text": "【任务完成】地图上的空白。"
            }
