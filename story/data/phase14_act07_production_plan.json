  "major_setpiece_design": {
    "homecoming_and_navigation": {
      "chapters": [
        "ch037"
      ],
      "status": "design_only",
      "goals": [
        "可公开的公共救援航道",
        "岛民对私人住址的保护",
        "朔弦归乡后与新住户协商"
      ],
      "guard": "使用当下持有的航路证据，不自动获得任何一张未完成的失落航页"
    },
    "civic_memory_registry": {
      "chapters": [
        "ch038",
        "ch042"
      ],
      "status": "design_only",
      "goals": [
        "分开民间证词、产权争议和事实核对",
        "本人选择公开、缓查或保密",
        "未来允许更正与增补"
      ],
      "guard": "历史争论无需只剩一种官方正确版本"
    },
    "nois_rescue_and_ticket": {
      "chapters": [
        "ch039"
      ],
      "status": "design_only",
      "goals": [
        "救援绳、支撑架、排水管路线",
        "母亲姓名旧车票与围裙补线",
        "儿童夜间照护与后续搜救交接"
      ],
      "guard": "诺依是儿童非战斗成员，救出部分幸存者不代表母亲已经找到；车票贯穿到第54章"
    },
    "twin_accounts": {
      "chapters": [
        "ch040"
      ],
      "status": "design_only",
      "goals": [
        "两份城门内外亲历证词同屏",
        "不可重写的历史与多种解释",
        "允许后代修订注释"
      ],
      "guard": "岁影回廊只可见证过去不能无成本改变过去"
    },
    "root_three_doors": {
      "chapters": [
        "ch041"
      ],
      "status": "design_only",
      "doors": [
        {
          "id": "past_protected",
          "note": "被保护的村庄"
        },
        {
          "id": "past_erased",
          "note": "被忘记的村庄"
        },
        {
          "id": "future_blank",
          "note": "不填写唯一未来"
        }
      ],
      "goals": [
        "检视三门与根网备用电路",
        "将图纸交由本地工匠审查",
        "支持可逆试点及居民叫停机制"
      ],
      "guard": "只有第60章可建立完整分散灯网并设立world.distributed_network"
    }
  },
  "notes": "未来地图/引擎动作制作规格；12场事件可跳过，12组选项反应仅在原选项写入后播放一次。不得称为已可玩。"
