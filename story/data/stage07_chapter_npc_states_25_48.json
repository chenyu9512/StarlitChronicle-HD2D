    },
    {
      "id": "ch041",
      "title": "根系之下",
      "location": "旧洲·地脉树海",
      "npc_states": {
        "before": {
          "id": "ch041.npc.before",
          "speaker": "玄璃",
          "text": "这里每条根都通向一种被排除的未来。",
