        {
          "id": "coda.p18.nuoyi.b.a.l01",
          "speaker": "旁白",
          "text": "无灯之晨一次漫长的撤离后，诺依发现年轻队员已经自己画好返城路线。"
        },
        {
          "id": "coda.p18.nuoyi.b.a.l02",
          "speaker": "诺依",
          "text": "我无需站在所有人的最前面，才知道当年那个人没有白救我。"
        },
        {
          "id": "coda.p18.nuoyi.b.a.l03",
          "speaker": "旁白",
          "text": "救援灯不再属于某位英雄，坏掉也有人知道怎样替换。"
        }
      ]
    },
