    {
      "id": "ch042",
      "title": "被世界记起的人们",
      "location": "根忆母灯坛",
      "npc_states": {
        "before": {
          "id": "ch042.npc.before",
          "speaker": "伊泽",
          "text": "请大家把愿意留下的名字告诉我们。",
