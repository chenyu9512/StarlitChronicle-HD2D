{
  "schema": "starlit.story.companion_quests.v1",
  "status": "text_only_not_bound",
  "characters": {
    "lanyin": "岚音",
    "leiso": "雷索"
  },
  "quests": [
    {
      "id": "cq_lanyin_01",
      "title": "未完成的病历",
      "type": "companion",
      "lead": "岚音",
      "lead_id": "lanyin",
      "region": "白砂港临时医务室",
      "npc": "水手小汐",
      "premise": "病患拥有两份名字不同的病签。",
      "required_chapter": "ch003",
      "required_flags": [
        "story.ch003.done"
      ],
      "completion_flag": "side.cq_lanyin_01.done",
      "stages": [
        {
          "id": "cq_lanyin_01.meet",
          "objective": "与水手小汐交谈",
          "dialogue": [
            {
              "id": "cq_lanyin_01.0.l01",
              "speaker": "小汐",
              "text": "我现在只认得这个名字。"
            },
            {
              "id": "cq_lanyin_01.0.l02",
              "speaker": "岚音",
              "text": "先别急着证明哪份才是真的。"
            },
            {
              "id": "cq_lanyin_01.0.l03",
              "speaker": "主角",
              "text": "你希望我们怎样称呼你？"
            }
          ],
          "effects": []
        },
        {
          "id": "cq_lanyin_01.investigate",
          "objective": "调查白砂港临时医务室的关键线索",
          "dialogue": [
            {
              "id": "cq_lanyin_01.1.l01",
              "speaker": "护士",
              "text": "他怕写明失忆就再不能上船。"
            },
            {
              "id": "cq_lanyin_01.1.l02",
              "speaker": "岚音",
              "text": "隐瞒病情会害他在海上得不到及时救治。"
            },
            {
              "id": "cq_lanyin_01.1.l03",
              "speaker": "小汐",
              "text": "我不想被一张纸决定以后只能留在岸上。"
            }
          ],
          "effects": []
        },
        {
          "id": "cq_lanyin_01.choice",
          "objective": "决定怎样应对出现的冲突",
          "dialogue": [
            {
              "id": "cq_lanyin_01.2.l01",
              "speaker": "岚音",
              "text": "医疗记录和船员资格应当分开。"
            },
            {
              "id": "cq_lanyin_01.2.l02",
              "speaker": "主角",
              "text": "先尊重他的隐私，再安排专业复诊。"
            },
            {
              "id": "cq_lanyin_01.2.l03",
              "speaker": "小汐",
              "text": "如果我愿意治疗，你们也愿意听我说想回海上的理由吗？"
            }
          ],
          "effects": [],
          "choice": {
            "id": "cq_lanyin_01.choice",
            "prompt": "你准备怎样处理？",
            "options": [
              {
                "id": "a",
                "label": "病人自主决定信息披露",
                "sets": {
                  "side.cq_lanyin_01.approach": "a"
                }
              },
              {
                "id": "b",
                "label": "建立匿名病历与转岗援助",
                "sets": {
                  "side.cq_lanyin_01.approach": "b"
                }
              }
            ]
          }
        },
        {
          "id": "cq_lanyin_01.resolution",
          "objective": "向当事人确认结果",
          "dialogue": [
            {
              "id": "cq_lanyin_01.3.l01",
              "speaker": "护士",
              "text": "新病历注明治疗需求，但不向船主公开无关的私人记忆。"
            },
            {
              "id": "cq_lanyin_01.3.l02",
              "speaker": "小汐",
              "text": "谢谢你们没有先宣布我已经不能航海。"
            },
            {
              "id": "cq_lanyin_01.3.l03",
              "speaker": "岚音",
              "text": "我得学会先问病人，而不是替病人做决定。"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "side.cq_lanyin_01.done",
              "value": true
            }
          ]
        }
      ],
      "ending_variation": {
        "a": "病人自主决定信息披露",
        "b": "建立匿名病历与转岗援助"
      },
      "post_completion": {
        "speaker": "岚音",
        "text": "我们还会在下一段路上继续讨论这件事。"
      },
      "story_reward_flag": "bond.lanyin.01",
      "status": "authored_text_not_runtime_bound"
    },
    {
      "id": "cq_lanyin_02",
      "title": "蓝围巾之外",
      "type": "companion",
      "lead": "岚音",
      "lead_id": "lanyin",
      "region": "赤炉工坊医务所",
      "npc": "矿工孩子",
      "premise": "孩子保存了失忆父亲的录音，却不想每次见面都播放。",
      "required_chapter": "ch014",
      "required_flags": [
        "story.ch014.done",
        "side.cq_lanyin_01.done"
      ],
      "completion_flag": "side.cq_lanyin_02.done",
      "stages": [
        {
          "id": "cq_lanyin_02.meet",
          "objective": "与矿工孩子交谈",
          "dialogue": [
            {
              "id": "cq_lanyin_02.0.l01",
              "speaker": "孩子",
              "text": "大家都让我放录音给爸爸听。"
            },
            {
              "id": "cq_lanyin_02.0.l02",
              "speaker": "岚音",
              "text": "你想让他听吗？"
            },
            {
              "id": "cq_lanyin_02.0.l03",
              "speaker": "孩子",
              "text": "我想先跟他一起吃一次饭。"
            }
          ],
          "effects": []
        },
        {
          "id": "cq_lanyin_02.investigate",
          "objective": "调查赤炉工坊医务所的关键线索",
          "dialogue": [
            {
              "id": "cq_lanyin_02.1.l01",
              "speaker": "缇珐",
              "text": "装置可以重复声音，却不能还回原来的日子。"
            },
            {
              "id": "cq_lanyin_02.1.l02",
              "speaker": "岚音",
              "text": "他现在可能会重新认识自己的孩子。"
            },
            {
              "id": "cq_lanyin_02.1.l03",
              "speaker": "孩子",
              "text": "如果他不记得过去，我们还能有新的回忆吗？"
            }
          ],
          "effects": []
        },
        {
          "id": "cq_lanyin_02.choice",
          "objective": "决定怎样应对出现的冲突",
          "dialogue": [
            {
              "id": "cq_lanyin_02.2.l01",
              "speaker": "主角",
              "text": "让家属知道治疗方法和风险。"
            },
            {
              "id": "cq_lanyin_02.2.l02",
              "speaker": "岚音",
              "text": "不要把认回旧名字当成唯一目标。"
            },
            {
              "id": "cq_lanyin_02.2.l03",
              "speaker": "孩子",
              "text": "我想教爸爸重新煮那道汤。"
            }
          ],
          "effects": [],
          "choice": {
            "id": "cq_lanyin_02.choice",
            "prompt": "你准备怎样处理？",
            "options": [
              {
                "id": "a",
                "label": "以日常陪伴为治疗核心",
                "sets": {
                  "side.cq_lanyin_02.approach": "a"
                }
              },
              {
                "id": "b",
                "label": "先由医师评估录音辅助疗法",
                "sets": {
                  "side.cq_lanyin_02.approach": "b"
                }
              }
            ]
          }
        },
        {
          "id": "cq_lanyin_02.resolution",
          "objective": "向当事人确认结果",
          "dialogue": [
            {
              "id": "cq_lanyin_02.3.l01",
              "speaker": "矿工",
              "text": "我记不得蓝围巾是哪天买的，却记得今天的汤很烫。"
            },
            {
              "id": "cq_lanyin_02.3.l02",
              "speaker": "孩子",
              "text": "那下次我放凉一点。"
            },
            {
              "id": "cq_lanyin_02.3.l03",
              "speaker": "岚音",
              "text": "这也是他们重新共同拥有的一天。"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "side.cq_lanyin_02.done",
              "value": true
            }
          ]
        }
      ],
      "ending_variation": {
        "a": "以日常陪伴为治疗核心",
        "b": "先由医师评估录音辅助疗法"
      },
      "post_completion": {
        "speaker": "岚音",
        "text": "我们还会在下一段路上继续讨论这件事。"
      },
      "story_reward_flag": "bond.lanyin.02",
      "status": "authored_text_not_runtime_bound"
    },
    {
      "id": "cq_lanyin_03",
      "title": "第二份嘱托",
      "type": "companion",
      "lead": "岚音",
      "lead_id": "lanyin",
      "region": "晨露村药房后屋",
      "npc": "岚音母亲",
      "premise": "藏匿的病历副本附有澄舟一段未交出的原话。",
      "required_chapter": "ch021",
      "required_flags": [
        "story.ch021.done",
        "side.cq_lanyin_02.done"
      ],
      "completion_flag": "side.cq_lanyin_03.done",
      "stages": [
        {
          "id": "cq_lanyin_03.meet",
          "objective": "与岚音母亲交谈",
          "dialogue": [
            {
              "id": "cq_lanyin_03.0.l01",
              "speaker": "岚音母亲",
              "text": "那年我也劝她不要说。"
            },
            {
              "id": "cq_lanyin_03.0.l02",
              "speaker": "岚音",
              "text": "但最后选择隐瞒的是我。"
            },
            {
              "id": "cq_lanyin_03.0.l03",
              "speaker": "主角",
              "text": "我想读完整的原话。"
            }
          ],
          "effects": []
        },
        {
          "id": "cq_lanyin_03.investigate",
          "objective": "调查晨露村药房后屋的关键线索",
          "dialogue": [
            {
              "id": "cq_lanyin_03.1.l01",
              "speaker": "主角",
              "text": "澄舟写着“保护不等于替他选择”。"
            },
            {
              "id": "cq_lanyin_03.1.l02",
              "speaker": "岚音",
              "text": "我竟只记住了前半句。"
            },
            {
              "id": "cq_lanyin_03.1.l03",
              "speaker": "岚音母亲",
              "text": "害怕也不能让我们免于解释。"
            }
          ],
          "effects": []
        },
        {
          "id": "cq_lanyin_03.choice",
          "objective": "决定怎样应对出现的冲突",
          "dialogue": [
            {
              "id": "cq_lanyin_03.2.l01",
              "speaker": "岚音",
              "text": "我不要求你现在说没关系。"
            },
            {
              "id": "cq_lanyin_03.2.l02",
              "speaker": "主角",
              "text": "我能理解当年的担心，也仍会难过。"
            },
            {
              "id": "cq_lanyin_03.2.l03",
              "speaker": "岚音母亲",
              "text": "把全部证据交给他吧，别再让我们替他决定。"
            }
          ],
          "effects": [],
          "choice": {
            "id": "cq_lanyin_03.choice",
            "prompt": "你准备怎样处理？",
            "options": [
              {
                "id": "a",
                "label": "由主角独自阅读完整嘱托",
                "sets": {
                  "side.cq_lanyin_03.approach": "a"
                }
              },
              {
                "id": "b",
                "label": "让当事人共同核对证词",
                "sets": {
                  "side.cq_lanyin_03.approach": "b"
                }
              }
            ]
          }
        },
        {
          "id": "cq_lanyin_03.resolution",
          "objective": "向当事人确认结果",
          "dialogue": [
            {
              "id": "cq_lanyin_03.3.l01",
              "speaker": "旁白",
              "text": "旧抽屉里终于不再藏着唯一的副本。"
            },
            {
              "id": "cq_lanyin_03.3.l02",
              "speaker": "主角",
              "text": "我会自己保管原件。"
            },
            {
              "id": "cq_lanyin_03.3.l03",
              "speaker": "岚音",
              "text": "以后有了新线索，先告诉你，再一起想办法。"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "side.cq_lanyin_03.done",
              "value": true
            }
          ]
        }
      ],
      "ending_variation": {
        "a": "由主角独自阅读完整嘱托",
        "b": "让当事人共同核对证词"
      },
      "post_completion": {
        "speaker": "岚音",
        "text": "我们还会在下一段路上继续讨论这件事。"
      },
      "story_reward_flag": "bond.lanyin.03",
      "status": "authored_text_not_runtime_bound"
    },
    {
      "id": "cq_lanyin_04",
      "title": "醒来后的半杯茶",
      "type": "companion",
      "lead": "岚音",
      "lead_id": "lanyin",
      "region": "镜眠王都疗养院",
      "npc": "照护员",
      "premise": "老人每日给已故伴侣保留半杯茶，医官要求收走杯子。",
      "required_chapter": "ch035",
      "required_flags": [
        "story.ch035.done",
        "side.cq_lanyin_03.done"
      ],
      "completion_flag": "side.cq_lanyin_04.done",
      "stages": [
        {
          "id": "cq_lanyin_04.meet",
          "objective": "与照护员交谈",
          "dialogue": [
            {
              "id": "cq_lanyin_04.0.l01",
              "speaker": "照护员",
              "text": "他总把另一只杯子放到空椅旁。"
            },
            {
              "id": "cq_lanyin_04.0.l02",
              "speaker": "岚音",
              "text": "先问问他为何这样做。"
            },
            {
              "id": "cq_lanyin_04.0.l03",
              "speaker": "老人",
              "text": "她以前嫌茶烫，我会等到她说能喝。"
            }
          ],
          "effects": []
        },
        {
          "id": "cq_lanyin_04.investigate",
          "objective": "调查镜眠王都疗养院的关键线索",
          "dialogue": [
            {
              "id": "cq_lanyin_04.1.l01",
              "speaker": "岚音",
              "text": "老人知道伴侣已经去世。"
            },
            {
              "id": "cq_lanyin_04.1.l02",
              "speaker": "玄璃",
              "text": "想念她不意味着不会醒来。"
            },
            {
              "id": "cq_lanyin_04.1.l03",
              "speaker": "老人",
              "text": "我只是希望醒来的时候，也有地方放这份思念。"
            }
          ],
          "effects": []
        },
        {
          "id": "cq_lanyin_04.choice",
          "objective": "决定怎样应对出现的冲突",
          "dialogue": [
            {
              "id": "cq_lanyin_04.2.l01",
              "speaker": "照护员",
              "text": "医生说他必须尽快戒掉这个习惯。"
            },
            {
              "id": "cq_lanyin_04.2.l02",
              "speaker": "岚音",
              "text": "疗法可以调整，不能用强制驱逐悲伤。"
            },
            {
              "id": "cq_lanyin_04.2.l03",
              "speaker": "主角",
              "text": "让他自己选择陪伴形式，并安排复诊。"
            }
          ],
          "effects": [],
          "choice": {
            "id": "cq_lanyin_04.choice",
            "prompt": "你准备怎样处理？",
            "options": [
              {
                "id": "a",
                "label": "允许保留纪念仪式",
                "sets": {
                  "side.cq_lanyin_04.approach": "a"
                }
              },
              {
                "id": "b",
                "label": "建立循序醒转与陪伴计划",
                "sets": {
                  "side.cq_lanyin_04.approach": "b"
                }
              }
            ]
          }
        },
        {
          "id": "cq_lanyin_04.resolution",
          "objective": "向当事人确认结果",
          "dialogue": [
            {
              "id": "cq_lanyin_04.3.l01",
              "speaker": "老人",
              "text": "今天喝完了两杯茶，还想明天再散步。"
            },
            {
              "id": "cq_lanyin_04.3.l02",
              "speaker": "玄璃",
              "text": "真实的风会吹凉茶，也会吹走一些闷气。"
            },
            {
              "id": "cq_lanyin_04.3.l03",
              "speaker": "岚音",
              "text": "治疗不是把人变成从来不难过的人。"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "side.cq_lanyin_04.done",
              "value": true
            }
          ]
        }
      ],
      "ending_variation": {
        "a": "允许保留纪念仪式",
        "b": "建立循序醒转与陪伴计划"
      },
      "post_completion": {
        "speaker": "岚音",
        "text": "我们还会在下一段路上继续讨论这件事。"
      },
      "story_reward_flag": "bond.lanyin.04",
      "status": "authored_text_not_runtime_bound"
    },
    {
      "id": "cq_lanyin_05",
      "title": "没有英雄的碑文",
      "type": "companion",
      "lead": "岚音",
      "lead_id": "lanyin",
      "region": "晨露村旧码头",
      "npc": "石匠",
      "premise": "失踪者家属反对将黑星之夜的纪念碑写成英雄颂。",
      "required_chapter": "ch053",
      "required_flags": [
        "story.ch053.done",
        "side.cq_lanyin_04.done"
      ],
      "completion_flag": "side.cq_lanyin_05.done",
      "stages": [
        {
          "id": "cq_lanyin_05.meet",
          "objective": "与石匠交谈",
          "dialogue": [
            {
              "id": "cq_lanyin_05.0.l01",
              "speaker": "石匠",
              "text": "有人写谢谢，有人写为什么他没回来。"
            },
            {
              "id": "cq_lanyin_05.0.l02",
              "speaker": "岚音",
              "text": "两个声音都该有位置。"
            },
            {
              "id": "cq_lanyin_05.0.l03",
              "speaker": "主角",
              "text": "我不该替他们定碑文。"
            }
          ],
          "effects": []
        },
        {
          "id": "cq_lanyin_05.investigate",
          "objective": "调查晨露村旧码头的关键线索",
          "dialogue": [
            {
              "id": "cq_lanyin_05.1.l01",
              "speaker": "老家属",
              "text": "我儿子只是爱吃汤面，别把他刻成士兵。"
            },
            {
              "id": "cq_lanyin_05.1.l02",
              "speaker": "诺依",
              "text": "我记得他在撤离船上帮过别人。"
            },
            {
              "id": "cq_lanyin_05.1.l03",
              "speaker": "岚音",
              "text": "这些日常比统一的赞歌更重要。"
            }
          ],
          "effects": []
        },
        {
          "id": "cq_lanyin_05.choice",
          "objective": "决定怎样应对出现的冲突",
          "dialogue": [
            {
              "id": "cq_lanyin_05.2.l01",
              "speaker": "村长",
              "text": "用统一悼词才不会争吵。"
            },
            {
              "id": "cq_lanyin_05.2.l02",
              "speaker": "主角",
