      "required_flags": [
        "story.ch006.done"
      ],
      "chapter_start_flag": "ch007.started",
      "chapter_complete_flag": "story.ch007.done",
      "lead_character": "雷索",
      "summary": "在三誓王都·外廷，向三国递交海难情报并获得调查许可。大臣要求玩家隐瞒边境难民，才肯开放王城档案。最终，主角拒绝伪造证词，循商道秘密进入边境。",
      "production_status": "scripted_blocking_v1",
      "recommended_level": [
        8,
        12
      ],
      "boss": null,
      "scenes": [
        {
          "id": "ch007.opening",
          "title": "到达：三誓王都·外廷",
          "trigger": {
            "type": "chapter_enter",
            "region": "三誓王都·外廷"
          },
          "dialogue": [
            {
              "id": "ch007.opening.l01",
              "speaker": "旁白",
              "text": "【三誓王都·外廷】空气中藏着异样的气息。"
            },
            {
              "id": "ch007.opening.l02",
              "speaker": "雷索",
              "text": "这张通行证在三国都不算数，和平比战争更需要耐心。"
            },
            {
              "id": "ch007.opening.l03",
              "speaker": "主角",
              "text": "先把眼前的事弄清楚。向三国递交海难情报并获得调查许可。"
            },
            {
              "id": "ch007.opening.l04",
              "speaker": "雷索",
              "text": "别忘了，沿途的人也有自己的故事。"
            }
          ],
          "objectives": [
            {
              "type": "reach",
              "target": "三誓王都·外廷"
            },
            {
              "type": "interact",
              "target": "ch007.key_npc"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch007.started",
              "value": true
            }
          ]
        },
        {
          "id": "ch007.investigate",
          "title": "调查线索",
          "trigger": {
            "type": "interact",
            "target": "ch007.clue"
          },
          "dialogue": [
            {
              "id": "ch007.investigate.l01",
              "speaker": "旁白",
              "text": "众人在三誓王都·外廷找到了一处被忽视的痕迹。"
            },
            {
              "id": "ch007.investigate.l02",
              "speaker": "雷索",
              "text": "三份外交函盖着同一个不应存在的秘密印章。"
            },
            {
              "id": "ch007.investigate.l03",
              "speaker": "主角",
              "text": "先别急着下结论。还有谁能证实这件事？"
            },
            {
              "id": "ch007.investigate.l04",
              "speaker": "旁白",
              "text": "日志、物件与目击证言彼此印证，事件终于露出轮廓。"
            }
          ],
          "objectives": [
            {
              "type": "inspect",
              "target": "ch007.clue"
            },
            {
              "type": "speak",
              "target": "ch007.witness"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch007.evidence",
              "value": true
            }
          ]
        },
        {
          "id": "ch007.crisis",
          "title": "真相与冲突",
          "trigger": {
            "type": "interact",
            "target": "ch007.crisis",
            "requires_flags": [
              "ch007.evidence"
            ]
          },
          "dialogue": [
            {
              "id": "ch007.crisis.l01",
              "speaker": "旁白",
              "text": "当最后一份证据摆上桌面，原本平静的局面终于被打破。"
            },
            {
              "id": "ch007.crisis.l02",
              "speaker": "雷索",
              "text": "大臣要求玩家隐瞒边境难民，才肯开放王城档案。"
            },
            {
              "id": "ch007.crisis.l03",
              "speaker": "主角",
              "text": "不能只顾眼前的胜负。谁会因为我们的决定付出代价？"
            },
            {
              "id": "ch007.crisis.l04",
              "speaker": "雷索",
              "text": "这一次由你决定如何开口。我会一起承担后果。"
            }
          ],
          "objectives": [
            {
              "type": "decide",
              "target": "ch007.choice"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch007.decision_made",
              "value": true
            }
          ],
          "choice": {
            "id": "ch007.choice",
            "prompt": "面对眼前的矛盾，你打算怎样行动？",
            "options": [
              {
                "id": "listen",
                "label": "先听当事人的解释",
                "sets": {
                  "ch007.approach": "listen"
                }
              },
              {
                "id": "act",
                "label": "先保护可能受伤的人",
                "sets": {
                  "ch007.approach": "act"
                }
              }
            ]
          },
          "encounter": null
        },
        {
          "id": "ch007.resolve",
          "title": "事件落幕",
          "trigger": {
            "type": "scene_after",
            "requires_flags": [
              "ch007.decision_made"
            ]
          },
          "dialogue": [
            {
              "id": "ch007.resolve.l01",
              "speaker": "旁白",
              "text": "风声渐弱，人们终于有机会面对自己刚才不愿承认的事。"
            },
            {
              "id": "ch007.resolve.l02",
              "speaker": "雷索",
              "text": "主角拒绝伪造证词，循商道秘密进入边境。"
            },
            {
              "id": "ch007.resolve.l03",
              "speaker": "主角",
              "text": "总有些事，不能只写成一行冒险记录。"
            },
            {
              "id": "ch007.resolve.l04",
              "speaker": "旁白",
              "text": "【任务完成】被拒绝的使者。新的道路正在展开。"
            }
          ],
          "objectives": [
            {
              "type": "finish_chapter",
              "target": "ch007"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "story.ch007.done",
              "value": true
            },
            {
              "type": "grant",
              "xp": 380,
              "gold": 138
            }
          ]
        }
