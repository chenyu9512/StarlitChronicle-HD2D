  "title": "白砂海岸",
  "theme": "从故乡出发，调查海雾失忆并点亮潮歌灯。",
  "progression_unlock": "tide_lantern",
  "chapters": [
    {
      "id": "ch001",
      "number": 1,
      "act": 1,
      "chapter_number": 1,
      "title": "不曾寄出的信",
      "location": "晨露村·澄舟旧屋",
      "required_flags": [
        "story.prologue_done"
      ],
      "chapter_start_flag": "ch001.started",
      "chapter_complete_flag": "story.ch001.done",
      "lead_character": "岚音",
      "summary": "在晨露村·澄舟旧屋，检查养父留下的旧箱和潮湿地图。村长声称从未听过澄舟，屋内却藏着村长亲笔的旧收据。最终，主角收起信件，决定到白砂港寻找落款上的航船。",
      "production_status": "scripted_blocking_v1",
      "recommended_level": [
        1,
        5
      ],
      "boss": null,
      "scenes": [
        {
          "id": "ch001.opening",
          "title": "到达：晨露村·澄舟旧屋",
          "trigger": {
            "type": "chapter_enter",
            "region": "晨露村·澄舟旧屋"
          },
          "dialogue": [
            {
              "id": "ch001.opening.l01",
              "speaker": "旁白",
              "text": "【晨露村·澄舟旧屋】空气中藏着异样的气息。"
            },
            {
              "id": "ch001.opening.l02",
              "speaker": "岚音",
              "text": "这封信封了十年，封口却像昨天才干。"
            },
            {
              "id": "ch001.opening.l03",
              "speaker": "主角",
              "text": "先把眼前的事弄清楚。检查养父留下的旧箱和潮湿地图。"
            },
            {
              "id": "ch001.opening.l04",
              "speaker": "岚音",
              "text": "别忘了，沿途的人也有自己的故事。"
            }
          ],
          "objectives": [
            {
              "type": "reach",
              "target": "晨露村·澄舟旧屋"
            },
            {
              "type": "interact",
              "target": "ch001.key_npc"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch001.started",
              "value": true
            }
          ]
        },
        {
          "id": "ch001.investigate",
          "title": "调查线索",
          "trigger": {
            "type": "interact",
            "target": "ch001.clue"
          },
          "dialogue": [
            {
              "id": "ch001.investigate.l01",
              "speaker": "旁白",
              "text": "众人在晨露村·澄舟旧屋找到了一处被忽视的痕迹。"
            },
            {
              "id": "ch001.investigate.l02",
              "speaker": "岚音",
              "text": "收件人写着“第七位守灯人”，背面沾着海盐。"
            },
            {
              "id": "ch001.investigate.l03",
              "speaker": "主角",
              "text": "先别急着下结论。还有谁能证实这件事？"
            },
            {
              "id": "ch001.investigate.l04",
              "speaker": "旁白",
              "text": "日志、物件与目击证言彼此印证，事件终于露出轮廓。"
            }
          ],
          "objectives": [
            {
              "type": "inspect",
              "target": "ch001.clue"
            },
            {
              "type": "speak",
              "target": "ch001.witness"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch001.evidence",
              "value": true
            }
          ]
        },
        {
          "id": "ch001.crisis",
          "title": "真相与冲突",
          "trigger": {
            "type": "interact",
            "target": "ch001.crisis",
            "requires_flags": [
              "ch001.evidence"
            ]
          },
          "dialogue": [
            {
              "id": "ch001.crisis.l01",
              "speaker": "旁白",
              "text": "当最后一份证据摆上桌面，原本平静的局面终于被打破。"
            },
            {
              "id": "ch001.crisis.l02",
              "speaker": "岚音",
              "text": "村长声称从未听过澄舟，屋内却藏着村长亲笔的旧收据。"
            },
            {
              "id": "ch001.crisis.l03",
              "speaker": "主角",
              "text": "不能只顾眼前的胜负。谁会因为我们的决定付出代价？"
            },
            {
              "id": "ch001.crisis.l04",
              "speaker": "岚音",
              "text": "这一次由你决定如何开口。我会一起承担后果。"
            }
          ],
          "objectives": [
            {
              "type": "decide",
              "target": "ch001.choice"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch001.decision_made",
              "value": true
            }
          ],
          "choice": {
            "id": "ch001.choice",
            "prompt": "面对眼前的矛盾，你打算怎样行动？",
            "options": [
              {
                "id": "listen",
                "label": "先听当事人的解释",
                "sets": {
                  "ch001.approach": "listen"
                }
              },
              {
                "id": "act",
                "label": "先保护可能受伤的人",
                "sets": {
                  "ch001.approach": "act"
                }
              }
            ]
          },
          "encounter": null
        },
        {
          "id": "ch001.resolve",
          "title": "事件落幕",
          "trigger": {
            "type": "scene_after",
            "requires_flags": [
              "ch001.decision_made"
            ]
          },
          "dialogue": [
            {
              "id": "ch001.resolve.l01",
              "speaker": "旁白",
              "text": "风声渐弱，人们终于有机会面对自己刚才不愿承认的事。"
            },
            {
              "id": "ch001.resolve.l02",
              "speaker": "岚音",
              "text": "主角收起信件，决定到白砂港寻找落款上的航船。"
            },
            {
              "id": "ch001.resolve.l03",
              "speaker": "主角",
              "text": "总有些事，不能只写成一行冒险记录。"
            },
            {
              "id": "ch001.resolve.l04",
              "speaker": "旁白",
              "text": "【任务完成】不曾寄出的信。新的道路正在展开。"
            }
          ],
          "objectives": [
            {
              "type": "finish_chapter",
              "target": "ch001"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "story.ch001.done",
              "value": true
            },
            {
              "type": "grant",
              "xp": 140,
              "gold": 54
            }
          ]
        }
      ],
      "npc_reactions": [
        {
          "condition": "ch001.started",
          "speaker": "路人",
          "text": "最近发生的事，你们也听说了吗？"
        },
        {
          "condition": "story.ch001.done",
          "speaker": "路人",
          "text": "听说你们在晨露村·澄舟旧屋帮了大忙。至少我们今天能安心一些。"
        }
      ],
