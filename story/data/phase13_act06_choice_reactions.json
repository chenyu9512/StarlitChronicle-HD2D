      "optional": true,
      "independent_route": false,
      "dialogue": [
        {
          "id": "ch034.p13.choice.listen.l01",
          "speaker": "玄璃",
          "text": "我自己说：不要回收我。我想离开这座剧场。"
        },
        {
          "id": "ch034.p13.choice.listen.l02",
          "speaker": "岚音",
          "text": "我们负责确保她能完整说完，不替她填答案。"
        },
        {
          "id": "ch034.p13.choice.listen.l03",
          "speaker": "主角",
          "text": "她的拒绝必须被记录为有效选择。"
        }
      ]
    },
    {
      "id": "ch034.p13.choice.act",
      "chapter_id": "ch034",
      "after_choice_id": "ch034.choice",
      "choice_option_id": "act",
      "condition": {
        "ch034.approach": "register",
        "world.ch034.approach": "register"
