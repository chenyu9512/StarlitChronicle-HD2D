  "investigations": [
    {
      "id": "inspect_books_main",
      "source_visual_id": "books_main",
      "kind": "bookshelf",
      "name": "旧航路借阅簿",
      "cell": [
        23,
        17
      ],
      "first_text": "扉页夹着十年前的潮歌灯祭客房账，最后一行只写着‘还会回来’。",
      "repeat_text": "旧账的纸边已磨得发亮，屋主仍每月为它换防潮纸。",
      "after_text": "页脚添上了新的归航签名，老板终于不用给那张空床留整夜的灯。",
      "owner_absent_text": "房客的姓名属于私人记录，先别翻得太深。",
      "owner_present_text": "屋主同意你仔细查看「旧航路借阅簿」，但提醒不要把家用物品带走。",
      "after_flag": "story.ch001.done",
      "privacy": "observe_only",
      "reward": null,
      "art_status": "existing_visual_only_d_input_pending"
    },
    {
      "id": "inspect_coastal_wayfinding",
      "source_visual_id": "coastal_wayfinding",
      "kind": "tideway_chart",
      "name": "逆潮避险图",
      "cell": [
        42,
        15
      ],
      "first_text": "这张海图不是标最近的路，而是用红线标了潮水最凶的一刻。",
      "repeat_text": "你认得红线的意思：潮位越低也不意味着海洞安全。",
      "after_text": "海图旁补上了近期修好的灯标，靠岸的路线比过去清楚。",
      "owner_absent_text": "图角标着‘店主授权查阅’，船客可公开看这张避险图。",
      "owner_present_text": "屋主同意你仔细查看「逆潮避险图」，但提醒不要把家用物品带走。",
      "after_flag": "story.ch001.done",
      "privacy": "observe_only",
      "reward": null,
      "art_status": "existing_visual_only_d_input_pending"
    },
    {
      "id": "inspect_guest_bed",
      "source_visual_id": "guest_bed",
      "kind": "bed",
      "name": "补丁旅床",
      "cell": [
        52,
        15
      ],
      "first_text": "被角的蓝布来自渔网旧帆；枕头下压着一张没有署名的潮汐小纸条。",
      "repeat_text": "床架虽然吱响，床单却重新晒过。",
      "after_text": "主人在床边放了一双干净的草鞋，为被雨困住的人准备。",
      "owner_absent_text": "有人还住在这里；未经许可不要翻动床铺。",
      "owner_present_text": "屋主同意你仔细查看「补丁旅床」，但提醒不要把家用物品带走。",
      "after_flag": "story.ch001.done",
      "privacy": "observe_only",
      "reward": null,
      "art_status": "existing_visual_only_d_input_pending"
    },
    {
      "id": "inspect_north_fireplace",
      "source_visual_id": "north_fireplace",
      "kind": "fireplace",
      "name": "盐草壁炉",
      "cell": [
        38,
        15
      ],
      "first_text": "石缝里是客栈老板捡来的贝壳，每年灯祭前会重新擦亮。",
      "repeat_text": "炉灰里还有早上烤饼留下的一点甜香。",
      "after_text": "炉边添了张座椅，等候失散亲人的旅客不必站在门外。",
      "owner_absent_text": "火还没灭，站近些暖暖手就好。",
      "owner_present_text": "屋主同意你仔细查看「盐草壁炉」，但提醒不要把家用物品带走。",
      "after_flag": "story.ch001.done",
      "privacy": "observe_only",
      "reward": null,
      "art_status": "existing_visual_only_d_input_pending"
    },
    {
      "id": "inspect_travel_supplies",
      "source_visual_id": "travel_supplies",
      "kind": "travelers_shelf",
      "name": "备用干粮架",
      "cell": [
        22,
        17
      ],
      "first_text": "架上写着‘受困船客可以先领热水’，旁边一格专门留给孩子。",
      "repeat_text": "桶上的绳结表示已经清点过两遍。",
      "after_text": "多了一本义工值班簿，救助物资的去向都公开可查。",
      "owner_absent_text": "老板不在，不能自行拿走有主的物资。",
      "owner_present_text": "屋主同意你仔细查看「备用干粮架」，但提醒不要把家用物品带走。",
      "after_flag": "story.ch001.done",
      "privacy": "observe_only",
      "reward": null,
      "art_status": "existing_visual_only_d_input_pending"
    },
    {
      "id": "inspect_lobby_lantern",
      "source_visual_id": "lobby_lantern",
      "kind": "lantern",
      "name": "晚归人的灯",
      "cell": [
        32,
        28
      ],
      "first_text": "这盏灯的玻璃有裂纹，仍在门口照亮濡湿的鞋印。",
      "repeat_text": "灯心修过，亮光比初来时稳。",
      "after_text": "更多人回港后在灯柱刻了感谢的小记号。",
      "owner_absent_text": "灯已点好，留给下一位旅客吧。",
      "owner_present_text": "屋主同意你仔细查看「晚归人的灯」，但提醒不要把家用物品带走。",
