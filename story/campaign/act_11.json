            "options": [
              {
                "id": "hear",
                "label": "先取得更多证词",
                "sets": {
                  "ch061.approach": "hear"
                }
              },
              {
                "id": "protect",
                "label": "先保护受威胁的人",
                "sets": {
                  "ch061.approach": "protect"
                }
              }
            ]
