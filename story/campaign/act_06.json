          "title": "调查线索",
          "trigger": {
            "type": "interact",
            "target": "ch031.clue"
          },
          "dialogue": [
            {
              "id": "ch031.investigate.l01",
              "speaker": "旁白",
              "text": "众人在镜眠王都·日轮街找到了一处被忽视的痕迹。"
            },
            {
              "id": "ch031.investigate.l02",
              "speaker": "玄璃",
              "text": "街上日历永远停在花祭当天，花却一直新开。"
            },
            {
              "id": "ch031.investigate.l03",
              "speaker": "主角",
              "text": "先别急着下结论。还有谁能证实这件事？"
            },
            {
              "id": "ch031.investigate.l04",
              "speaker": "旁白",
              "text": "日志、物件与目击证言彼此印证，事件终于露出轮廓。"
            }
          ],
          "objectives": [
            {
              "type": "inspect",
              "target": "ch031.clue"
            },
            {
              "type": "speak",
              "target": "ch031.witness"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch031.evidence",
