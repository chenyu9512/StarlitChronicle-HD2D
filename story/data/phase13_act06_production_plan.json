  "puzzle_design": {
    "ch031_day_repeat": {
      "status": "design_only",
      "beats": [
        "核对连续三天街口花瓣、旅馆九页账簿和北门新墙",
        "依可证伪线索找出循环之外仍改变的事项",
        "让居民知情后选择是否继续待在梦中"
      ],
      "guard": "不能将不记得昨天等同自愿；不强制花贩打开女儿的信"
    },
    "ch032_mirror_gate": {
      "status": "design_only",
      "beats": [
        "镜门外观向内关锁，玩家比较使用者开关与管理员回路",
        "先听孩子需求并通过可靠监护人建立联系",
        "恢复从内侧可主动退出、重返与暂停的锚点"
      ],
      "guard": "映世幻想家人不是真死者复活；玄璃只以自主意识协作，尚未正式入队"
    },
    "ch033_seven_paths": {
      "status": "design_only",
      "route_markers": 7,
      "beats": [
        "为七条可能人生准备可认出的回程结",
        "玩家可选择只看一部分伙伴愿意公开的记忆",
        "不给玩家任务奖励来惩罚选择跳过私密遗憾"
      ],
      "guard": "七条道路是可选演出构想，不新增7个必须完成的正式主线旗标"
    },
    "ch034_identity_and_exit": {
      "status": "design_only",
      "beats": [
        "确认所谓错误台词确为玄璃主动改写",
        "在回收系统中发现缺少有效拒绝选项",
        "玄璃亲自否决回收并决定姓名、是否同行"
      ],
      "guard": "玄璃正式加入只在ch034.resolve；勿提前触发战斗队员状态"
    },
    "ch035_medical_aftercare": {
      "status": "design_only",
      "beats": [
        "将睡眠时长、重症护理风险与自愿程度分栏",
        "对每个居民设置可撤回的醒转时段与陪护",
        "保留安全的自愿短眠而非全面永久关闭梦室"
      ],
      "guard": "治疗的暂时波动不视为道德失败；不得把强制醒转塑造成唯一正解"
    },
    "ch036_lamp_protocol": {
      "status": "design_only",
      "beats": [
        "检查旧版个人退出与后加的中央强制锁控",
        "在不中断医护服务下逐个恢复自主退出",
        "告知共同维护与复核负责人"
      ],
      "guard": "镜眠灯不是许愿机，不能复活真实死者；不新建结局C硬门槛"
    }
  }
