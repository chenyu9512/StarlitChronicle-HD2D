        {
          "id": "ch037.opening",
          "title": "开场：旧洲外海·无名岛",
          "trigger": {
            "type": "chapter_enter",
            "region": "旧洲外海·无名岛"
          },
          "dialogue": [
            {
              "id": "ch037.opening.l01",
              "speaker": "旁白",
              "text": "【旧洲外海·无名岛】远方传来的声音打断了众人的脚步。"
            },
            {
              "id": "ch037.opening.l02",
              "speaker": "朔弦",
              "text": "我的故乡就藏在这些白纸后面，我敢肯定。"
            },
            {
              "id": "ch037.opening.l03",
              "speaker": "主角",
              "text": "我们先完成眼前的任务：拼接失落航页并找到通行航道。"
            },
            {
              "id": "ch037.opening.l04",
              "speaker": "旁白",
              "text": "地图上出现了新的调查标记。"
            }
          ],
          "objectives": [
            {
              "type": "reach",
              "target": "旧洲外海·无名岛"
            },
            {
              "type": "interact",
              "target": "ch037.key_npc"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch037.started",
              "value": true
            }
          ]
        },
        {
          "id": "ch037.investigate",
          "title": "寻找证据",
          "trigger": {
            "type": "interact",
            "target": "ch037.clue"
          },
          "dialogue": [
            {
              "id": "ch037.investigate.l01",
              "speaker": "旁白",
              "text": "某件不起眼的事物让众人停下脚步。"
            },
            {
              "id": "ch037.investigate.l02",
              "speaker": "朔弦",
              "text": "海面并非空无一物，而是所有测绘罗盘同时忽略同一片海。"
            },
            {
              "id": "ch037.investigate.l03",
              "speaker": "主角",
              "text": "光凭猜测还不够。去找能作证的人。"
            },
            {
              "id": "ch037.investigate.l04",
              "speaker": "旁白",
              "text": "调查内容被写入星灯手记。"
            }
          ],
          "objectives": [
            {
              "type": "inspect",
              "target": "ch037.clue"
            },
            {
              "type": "speak",
              "target": "ch037.witness"
