            "required_flags": [
              "ch042.started"
            ],
            "without_flags": [
              "story.ch042.done"
            ]
          },
          "source_dialogue_id": "ch042.opening.l02"
        },
        "investigating": {
          "id": "ch042.npc.during",
          "speaker": "伊泽",
          "text": "一首歌里不必有所有人的名字，很多首歌却能让每个人都有位置。",
          "conditions": {
            "required_flags": [
              "ch042.started"
            ],
            "stage": "investigate"
