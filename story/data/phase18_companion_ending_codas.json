        {
          "id": "coda.p18.ize.b.a.l01",
          "speaker": "旁白",
          "text": "无灯后有海湾居民写出抱怨的歌，也有人写出欢快的小调。"
        },
        {
          "id": "coda.p18.ize.b.a.l02",
          "speaker": "伊泽",
          "text": "两种歌我都愿意听，只要不是替不愿发声的人强行谱曲。"
        },
        {
          "id": "coda.p18.ize.b.a.l03",
          "speaker": "旁白",
          "text": "居民可共同署名、撤回或修订灾难见证，歌词不替他们选结局。"
        }
