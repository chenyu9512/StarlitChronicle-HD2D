{
  "schema": "starlit.story.chapter_npc_state.v1",
  "status": "text_only_not_bound",
  "authoring_note": "每章三个状态的候选NPC话术均引用现有主线对白，附源ID；12幕章末附加12句新写的地区后续对白。原脚本不修改，正式NPC绑定后再按地点/角色筛选。",
  "chapters": [
    {
      "id": "ch049",
      "title": "旧英雄的名字",
      "location": "十二年后·荒原邮站",
      "npc_states": {
        "before": {
          "id": "ch049.npc.before",
          "speaker": "成年诺依",
          "text": "你们知道画像里的人住在哪里吗？",
          "conditions": {
            "required_flags": [
              "ch049.started"
            ],
            "without_flags": [
              "story.ch049.done"
            ]
          },
          "source_dialogue_id": "ch049.opening.l02"
        },
        "investigating": {
          "id": "ch049.npc.during",
          "speaker": "老板",
          "text": "我当年只是个搬粮的，没什么值得说。",
          "conditions": {
            "required_flags": [
              "ch049.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch049.investigate.l02"
        },
        "completed": {
          "id": "ch049.npc.complete",
          "speaker": "老板",
          "text": "那人也许在雾岭。听说一个无名农夫总替山村修桥。",
          "conditions": {
            "required_flags": [
              "story.ch049.done"
            ]
          },
          "source_dialogue_id": "ch049.resolve.l02"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch050",
      "title": "改变的王都",
      "location": "十二年后·三誓王都",
      "npc_states": {
        "before": {
          "id": "ch050.npc.before",
          "speaker": "诺依",
          "text": "小时候这里还有一条卖热面包的街。",
          "conditions": {
            "required_flags": [
              "ch050.started"
            ],
            "without_flags": [
              "story.ch050.done"
            ]
          },
          "source_dialogue_id": "ch050.opening.l02"
        },
        "investigating": {
          "id": "ch050.npc.during",
          "speaker": "诺依",
          "text": "他在这边是居民，在那边却被当作危险接触者。",
          "conditions": {
            "required_flags": [
              "ch050.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch050.investigate.l02"
        },
        "completed": {
          "id": "ch050.npc.complete",
          "speaker": "老兵",
          "text": "雷索会喜欢你的做法，也会提醒你别总一个人扛。",
          "conditions": {
            "required_flags": [
              "story.ch050.done"
            ]
          },
          "source_dialogue_id": "ch050.resolve.l02"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch051",
      "title": "山间无名旅人",
      "location": "雾岭·偏远农庄",
      "npc_states": {
        "before": {
          "id": "ch051.npc.before",
          "speaker": "诺依",
          "text": "请问这里有没有一个从不留名字的旅人？",
          "conditions": {
            "required_flags": [
              "ch051.started"
            ],
            "without_flags": [
              "story.ch051.done"
            ]
          },
          "source_dialogue_id": "ch051.opening.l02"
        },
        "investigating": {
          "id": "ch051.npc.during",
          "speaker": "诺依",
          "text": "你这些年没有停止帮人。",
          "conditions": {
            "required_flags": [
              "ch051.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch051.investigate.l02"
        },
        "completed": {
          "id": "ch051.npc.complete",
          "speaker": "诺依",
          "text": "我知道你不想再去王都。你不用今天回答。",
          "conditions": {
            "required_flags": [
              "story.ch051.done"
            ]
          },
          "source_dialogue_id": "ch051.resolve.l02"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch052",
      "title": "再一次同行",
      "location": "暮林古道",
      "npc_states": {
        "before": {
          "id": "ch052.npc.before",
          "speaker": "岚音",
          "text": "我以为你会一直躲在山里，直到有人来找你修门。",
          "conditions": {
            "required_flags": [
              "ch052.started"
            ],
            "without_flags": [
              "story.ch052.done"
            ]
          },
          "source_dialogue_id": "ch052.opening.l02"
        },
        "investigating": {
          "id": "ch052.npc.during",
          "speaker": "岚音",
          "text": "我在医院见过很多不肯醒来的人。后来发现不能只靠我决定。",
          "conditions": {
            "required_flags": [
              "ch052.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch052.investigate.l02"
        },
        "completed": {
          "id": "ch052.npc.complete",
          "speaker": "诺依",
          "text": "你可以是我的伙伴。名字写在同一张表上就好。",
          "conditions": {
            "required_flags": [
              "story.ch052.done"
            ]
          },
          "source_dialogue_id": "ch052.resolve.l03"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch053",
      "title": "那些没能守住的家",
      "location": "晨露村·旧灯塔",
      "npc_states": {
        "before": {
          "id": "ch053.npc.before",
          "speaker": "老村民",
          "text": "我知道你是谁。你最好别站在我家门前。",
          "conditions": {
            "required_flags": [
              "ch053.started"
            ],
            "without_flags": [
              "story.ch053.done"
            ]
          },
          "source_dialogue_id": "ch053.opening.l02"
        },
        "investigating": {
          "id": "ch053.npc.during",
          "speaker": "诺依",
          "text": "这张纸上写着我的名字。后面还有很多空位。",
          "conditions": {
            "required_flags": [
              "ch053.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch053.investigate.l02"
        },
        "completed": {
          "id": "ch053.npc.complete",
          "speaker": "老村民",
          "text": "那块路标是给旅人看的，不是给我看的。",
          "conditions": {
            "required_flags": [
              "story.ch053.done"
            ]
          },
          "source_dialogue_id": "ch053.resolve.l02"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch054",
      "title": "传承之灯",
      "location": "旧洲·新生营地",
      "npc_states": {
        "before": {
          "id": "ch054.npc.before",
          "speaker": "年轻队员",
          "text": "听说你找到了十二年前的英雄。",
          "conditions": {
            "required_flags": [
              "ch054.started"
            ],
            "without_flags": [
              "story.ch054.done"
            ]
          },
          "source_dialogue_id": "ch054.opening.l02"
        },
        "investigating": {
          "id": "ch054.npc.during",
          "speaker": "诺依",
          "text": "我负责现场指挥，主角和雷索护送重伤者。",
          "conditions": {
            "required_flags": [
              "ch054.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch054.investigate.l02"
        },
        "completed": {
          "id": "ch054.npc.complete",
          "speaker": "诺依",
          "text": "我小时候一直想让你带我去海边。",
          "conditions": {
            "required_flags": [
              "story.ch054.done"
            ]
          },
          "source_dialogue_id": "ch054.resolve.l02"
        }
      },
      "act_end_extra": {
        "id": "ch054.npc.act_ending",
        "speaker": "成年救援学徒",
        "text": "以前说起英雄只知道一幅画像。现在我能把自己走过的路也画在地图上。",
        "conditions": {
          "required_flags": [
            "story.ch054.done"
          ]
        },
        "original_new_text": true
      }
    },
    {
      "id": "ch055",
      "title": "废墟上的第一间屋子",
      "location": "群灯之城·西区",
      "npc_states": {
        "before": {
          "id": "ch055.npc.before",
          "speaker": "缇珐",
          "text": "别急着建大广场。先把这间屋子的门装好。",
          "conditions": {
            "required_flags": [
              "ch055.started"
            ],
            "without_flags": [
              "story.ch055.done"
            ]
          },
          "source_dialogue_id": "ch055.opening.l02"
        },
        "investigating": {
          "id": "ch055.npc.during",
          "speaker": "工匠",
          "text": "那一家早就走了。还用问他们？",
          "conditions": {
            "required_flags": [
              "ch055.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch055.investigate.l02"
        },
        "completed": {
          "id": "ch055.npc.complete",
          "speaker": "新住户",
          "text": "我知道这不是永远属于我的房子，可今晚终于能安心睡一觉。",
          "conditions": {
            "required_flags": [
              "story.ch055.done"
            ]
          },
          "source_dialogue_id": "ch055.resolve.l02"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch056",
      "title": "冒险者的新公会",
      "location": "群灯之城·旧会馆",
      "npc_states": {
        "before": {
          "id": "ch056.npc.before",
          "speaker": "朔弦",
          "text": "开公会可以，但账得贴墙上。",
          "conditions": {
            "required_flags": [
              "ch056.started"
            ],
            "without_flags": [
              "story.ch056.done"
            ]
          },
          "source_dialogue_id": "ch056.opening.l02"
        },
        "investigating": {
          "id": "ch056.npc.during",
          "speaker": "诺依",
          "text": "这里的人当年不是不愿送，是没有知道路已经消失。",
          "conditions": {
            "required_flags": [
              "ch056.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch056.investigate.l02"
        },
        "completed": {
          "id": "ch056.npc.complete",
          "speaker": "会馆管理员",
          "text": "委托人能看到费用去向，受托者也能拒绝过高风险。",
          "conditions": {
            "required_flags": [
              "story.ch056.done"
            ]
          },
          "source_dialogue_id": "ch056.resolve.l02"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch057",
      "title": "值得回来的地方",
      "location": "群灯之城·居民街",
      "npc_states": {
        "before": {
          "id": "ch057.npc.before",
          "speaker": "岚音",
          "text": "有了面包香，大家才会觉得这里真的可以生活。",
          "conditions": {
            "required_flags": [
              "ch057.started"
            ],
            "without_flags": [
              "story.ch057.done"
            ]
          },
          "source_dialogue_id": "ch057.opening.l02"
        },
        "investigating": {
          "id": "ch057.npc.during",
          "speaker": "小摊主",
          "text": "我想在广场卖三种调料的炖菜。",
          "conditions": {
            "required_flags": [
              "ch057.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch057.investigate.l02"
        },
        "completed": {
          "id": "ch057.npc.complete",
          "speaker": "小摊主",
          "text": "你尝过了吗？三国的调料放在一起也很好吃。",
          "conditions": {
            "required_flags": [
              "story.ch057.done"
            ]
          },
          "source_dialogue_id": "ch057.resolve.l02"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch058",
      "title": "叛逃的记灯师",
      "location": "城郊·封存档案车",
      "npc_states": {
        "before": {
          "id": "ch058.npc.before",
          "speaker": "维莎",
          "text": "请救我。我带来的东西值得你们审查，也值得所有人审查。",
          "conditions": {
            "required_flags": [
              "ch058.started"
            ],
            "without_flags": [
              "story.ch058.done"
            ]
          },
          "source_dialogue_id": "ch058.opening.l02"
        },
        "investigating": {
          "id": "ch058.npc.during",
          "speaker": "维莎",
          "text": "因为我一直以为只要数字改善，代价就能够忽略。",
          "conditions": {
            "required_flags": [
              "ch058.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch058.investigate.l03"
        },
        "completed": {
          "id": "ch058.npc.complete",
          "speaker": "受害者家属",
          "text": "你能把那几年还给他们吗？",
          "conditions": {
            "required_flags": [
              "story.ch058.done"
            ]
          },
          "source_dialogue_id": "ch058.resolve.l02"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch059",
      "title": "不是所有人都想战斗",
      "location": "群灯城·自由议事厅",
      "npc_states": {
        "before": {
          "id": "ch059.npc.before",
          "speaker": "雷索",
          "text": "守护选择，也包括守护不拿武器的选择。",
          "conditions": {
            "required_flags": [
              "ch059.started"
            ],
            "without_flags": [
              "story.ch059.done"
            ]
          },
          "source_dialogue_id": "ch059.opening.l02"
        },
        "investigating": {
          "id": "ch059.npc.during",
          "speaker": "雷索",
          "text": "他们愿意承担的并不轻。",
          "conditions": {
            "required_flags": [
              "ch059.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch059.investigate.l02"
        },
        "completed": {
          "id": "ch059.npc.complete",
          "speaker": "工坊主人",
          "text": "我还是不愿造武器。但我会把桥修好。",
          "conditions": {
            "required_flags": [
              "story.ch059.done"
            ]
          },
          "source_dialogue_id": "ch059.resolve.l02"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch060",
      "title": "千灯共明",
      "location": "群灯城·星灯中枢",
      "npc_states": {
        "before": {
          "id": "ch060.npc.before",
          "speaker": "缇珐",
          "text": "以前坏掉一处，全城都得跟着熄灯。这次不一样。",
          "conditions": {
            "required_flags": [
              "ch060.started"
            ],
            "without_flags": [
              "story.ch060.done"
            ]
          },
          "source_dialogue_id": "ch060.opening.l02"
        },
        "investigating": {
          "id": "ch060.npc.during",
          "speaker": "维莎",
          "text": "这不是更完美的中央控制，而是一套可以随时质疑的协议。",
          "conditions": {
            "required_flags": [
              "ch060.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch060.investigate.l02"
        },
        "completed": {
          "id": "ch060.npc.complete",
          "speaker": "缇珐",
          "text": "每个节点的功率都很小，却没有一个人必须独自承担全部。",
          "conditions": {
            "required_flags": [
              "story.ch060.done"
            ]
          },
          "source_dialogue_id": "ch060.resolve.l02"
        }
      },
      "act_end_extra": {
        "id": "ch060.npc.act_ending",
        "speaker": "群灯城女工",
        "text": "有屋顶、有热饭、有能公开提意见的地方，这才像我们亲手建起来的城市。",
        "conditions": {
          "required_flags": [
            "story.ch060.done"
          ]
        },
        "original_new_text": true
      }
    },
    {
      "id": "ch061",
      "title": "驶向群星的船",
      "location": "天轨外海·浮空船坞",
      "npc_states": {
        "before": {
          "id": "ch061.npc.before",
          "speaker": "朔弦",
          "text": "从前以为海另一边就是尽头，现在连云上也有路。",
          "conditions": {
            "required_flags": [
              "ch061.started"
            ],
            "without_flags": [
              "story.ch061.done"
            ]
          },
          "source_dialogue_id": "ch061.opening.l02"
        },
        "investigating": {
          "id": "ch061.npc.during",
          "speaker": "朔弦",
          "text": "他修过的船真多，看来那人一辈子都在给别人留下退路。",
          "conditions": {
            "required_flags": [
              "ch061.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch061.investigate.l03"
        },
        "completed": {
          "id": "ch061.npc.complete",
          "speaker": "朔弦",
          "text": "第一条天空航路，记下来了。",
          "conditions": {
            "required_flags": [
              "story.ch061.done"
            ]
          },
          "source_dialogue_id": "ch061.resolve.l02"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch062",
      "title": "星灯诞生的地方",
      "location": "天轨圣域·原初实验室",
      "npc_states": {
        "before": {
          "id": "ch062.npc.before",
          "speaker": "维莎",
          "text": "这里不是神殿，是一座把未来当实验材料的研究所。",
          "conditions": {
            "required_flags": [
              "ch062.started"
            ],
            "without_flags": [
              "story.ch062.done"
            ]
          },
          "source_dialogue_id": "ch062.opening.l02"
        },
        "investigating": {
          "id": "ch062.npc.during",
          "speaker": "维莎",
          "text": "前两次试验确实帮助过很多人。",
          "conditions": {
            "required_flags": [
              "ch062.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch062.investigate.l02"
        },
        "completed": {
          "id": "ch062.npc.complete",
          "speaker": "维莎",
          "text": "我以前以为查到真正原因就能让过错变轻，现在知道不能。",
          "conditions": {
            "required_flags": [
              "story.ch062.done"
            ]
          },
          "source_dialogue_id": "ch062.resolve.l02"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch063",
      "title": "父亲留下的谎言",
      "location": "天轨圣域·澄舟密室",
      "npc_states": {
        "before": {
          "id": "ch063.npc.before",
          "speaker": "岚音",
          "text": "这尺上还留着你小时候的身高。",
          "conditions": {
            "required_flags": [
              "ch063.started"
            ],
            "without_flags": [
              "story.ch063.done"
            ]
          },
          "source_dialogue_id": "ch063.opening.l03"
        },
        "investigating": {
          "id": "ch063.npc.during",
          "speaker": "影像·澄舟",
          "text": "如果你看到这里，说明你已经走得比我希望的还远。",
          "conditions": {
            "required_flags": [
              "ch063.started"
            ],
            "stage": "investigate"
          },
          "source_dialogue_id": "ch063.investigate.l01"
        },
        "completed": {
          "id": "ch063.npc.complete",
          "speaker": "岚音",
          "text": "我们做不到。但可以记得他是怎样照顾过我们。",
          "conditions": {
            "required_flags": [
              "story.ch063.done"
            ]
          },
          "source_dialogue_id": "ch063.resolve.l03"
        }
      },
      "act_end_extra": null
    },
    {
      "id": "ch064",
      "title": "最后的母灯",
      "location": "天衡母灯坛",
      "npc_states": {
        "before": {
          "id": "ch064.npc.before",
          "speaker": "玄璃",
          "text": "这里的时间不是停下了，是被规定必须怎样走。",
          "conditions": {
            "required_flags": [
              "ch064.started"
            ],
            "without_flags": [
              "story.ch064.done"
            ]
          },
          "source_dialogue_id": "ch064.opening.l02"
        },
        "investigating": {
          "id": "ch064.npc.during",
          "speaker": "诺依",
          "text": "这些不是已经发生的事情。",
          "conditions": {
            "required_flags": [
              "ch064.started"
            ],
            "stage": "investigate"
          },
