{
  "schema": "starlit.story.regional_quests.v2",
  "status": "text_only_not_runtime_bound",
  "notes": "12幕分区新支线。玩家选择记入支线自身标志，不自动改变结局门槛；后续应接地图和正式运行器。",
  "quests": [
    {
      "id": "rq_001",
      "title": "遗失的贝壳罐",
      "type": "regional_v2",
      "region": "白砂港渔村",
      "npc": "渔家女儿",
      "premise": "父亲失忆归航后不记得给孩子收集贝壳的约定。",
      "required_chapter": "ch002",
      "required_flags": [
        "story.ch002.done"
      ],
      "completion_flag": "side.rq_001.done",
      "stages": [
        {
          "id": "rq_001.meet",
          "objective": "听取渔家女儿的委托",
          "dialogue": [
            {
              "id": "rq_001.0.l01",
              "speaker": "女儿",
              "text": "爸爸从前每次出海都带一个贝壳。"
            },
            {
              "id": "rq_001.0.l02",
              "speaker": "岚音",
              "text": "现在他可能不记得，但会愿意听你讲。"
            },
            {
              "id": "rq_001.0.l03",
              "speaker": "主角",
              "text": "先找那只装贝壳的旧罐。"
            }
          ],
          "effects": []
        },
        {
          "id": "rq_001.investigate",
          "objective": "调查白砂港渔村的相关证据",
          "dialogue": [
            {
              "id": "rq_001.1.l01",
              "speaker": "水手",
              "text": "我记得海浪的声音，却记不得罐子放哪儿。"
            },
            {
              "id": "rq_001.1.l02",
              "speaker": "女儿",
              "text": "我只找到盖子。"
            },
            {
              "id": "rq_001.1.l03",
              "speaker": "主角",
              "text": "旧船仓的木板下有一处能藏东西。"
            }
          ],
          "effects": []
        },
        {
          "id": "rq_001.choice",
          "objective": "处理与居民有关的冲突",
          "dialogue": [
            {
              "id": "rq_001.2.l01",
              "speaker": "女儿",
              "text": "如果爸爸再也记不起来，我们是不是就没了约定？"
            },
            {
              "id": "rq_001.2.l02",
              "speaker": "水手",
              "text": "我愿意从今天起陪你重新找。"
            },
            {
              "id": "rq_001.2.l03",
              "speaker": "岚音",
              "text": "过去的日子珍贵，今天也一样。"
            }
          ],
          "effects": [],
          "choice": {
            "id": "rq_001.choice",
            "prompt": "这件事你会如何处理？",
            "options": [
              {
                "id": "a",
                "label": "和父亲一起寻找最后一枚",
                "sets": {
                  "side.rq_001.approach": "a"
                }
              },
              {
                "id": "b",
                "label": "先修复旧罐与文字标签",
                "sets": {
                  "side.rq_001.approach": "b"
                }
              }
            ]
          }
        },
        {
          "id": "rq_001.resolution",
          "objective": "向渔家女儿反馈结果",
          "dialogue": [
            {
              "id": "rq_001.3.l01",
              "speaker": "旁白",
              "text": "小罐里有七枚贝壳，新的第八枚由父女一起捡起。"
            },
            {
              "id": "rq_001.3.l02",
              "speaker": "女儿",
              "text": "这枚是今天的。"
            },
            {
              "id": "rq_001.3.l03",
              "speaker": "水手",
              "text": "那就从今天继续。"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "side.rq_001.done",
              "value": true
            }
          ]
        }
      ],
      "ending_variation": {
        "a": "和父亲一起寻找最后一枚",
        "b": "先修复旧罐与文字标签"
      },
      "status": "authored_text_not_runtime_bound"
    },
    {
      "id": "rq_002",
      "title": "没有海兽的网",
      "type": "regional_v2",
      "region": "鲸骨浅滩",
      "npc": "渔网师傅",
      "premise": "渔夫要求加固带倒刺的捕兽网，却可能再次伤到受控海兽。",
      "required_chapter": "ch005",
      "required_flags": [
        "story.ch005.done"
      ],
      "completion_flag": "side.rq_002.done",
      "stages": [
        {
          "id": "rq_002.meet",
          "objective": "听取渔网师傅的委托",
          "dialogue": [
            {
              "id": "rq_002.0.l01",
              "speaker": "网师傅",
              "text": "大伙害怕海兽回来，想在网里多加几排铁钩。"
            },
            {
              "id": "rq_002.0.l02",
              "speaker": "朔弦",
              "text": "它伤人是因为星锁，不是为了吃渔夫。"
            },
            {
              "id": "rq_002.0.l03",
              "speaker": "主角",
              "text": "先看看哪些地方还会被鱼网缠住。"
            }
          ],
          "effects": []
        },
        {
          "id": "rq_002.investigate",
          "objective": "调查鲸骨浅滩的相关证据",
          "dialogue": [
            {
              "id": "rq_002.1.l01",
              "speaker": "网师傅",
              "text": "不用钩子，如何防止大鱼撞进来？"
            },
            {
              "id": "rq_002.1.l02",
              "speaker": "岚音",
              "text": "可以用声音和浮标引导。"
            },
            {
              "id": "rq_002.1.l03",
              "speaker": "朔弦",
              "text": "我知道一条不会穿过兽群活动区的航线。"
            }
          ],
          "effects": []
        },
        {
          "id": "rq_002.choice",
          "objective": "处理与居民有关的冲突",
          "dialogue": [
            {
              "id": "rq_002.2.l01",
              "speaker": "渔夫",
              "text": "我不信那头东西永远温顺。"
            },
            {
              "id": "rq_002.2.l02",
              "speaker": "主角",
              "text": "安全不是靠假装没有风险，我们可以设避让线。"
            },
            {
              "id": "rq_002.2.l03",
              "speaker": "网师傅",
              "text": "那就先试一组不会钩住皮肉的新网。"
            }
          ],
          "effects": [],
          "choice": {
            "id": "rq_002.choice",
            "prompt": "这件事你会如何处理？",
            "options": [
              {
                "id": "a",
                "label": "改造不伤海兽的浮标网",
                "sets": {
                  "side.rq_002.approach": "a"
                }
              },
              {
                "id": "b",
                "label": "先划定人兽共用的避让海域",
                "sets": {
                  "side.rq_002.approach": "b"
                }
              }
            ]
          }
        },
        {
          "id": "rq_002.resolution",
          "objective": "向渔网师傅反馈结果",
          "dialogue": [
            {
              "id": "rq_002.3.l01",
              "speaker": "旁白",
              "text": "新浮标让渔船远离海兽浅滩，渔网仍能正常捕鱼。"
            },
            {
              "id": "rq_002.3.l02",
              "speaker": "渔夫",
              "text": "我还是有点怕，但愿意试。"
            },
            {
              "id": "rq_002.3.l03",
              "speaker": "朔弦",
              "text": "肯承认怕，已经比逞强出海好多了。"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "side.rq_002.done",
              "value": true
            }
          ]
        }
      ],
      "ending_variation": {
        "a": "改造不伤海兽的浮标网",
        "b": "先划定人兽共用的避让海域"
      },
      "status": "authored_text_not_runtime_bound"
    },
    {
      "id": "rq_003",
      "title": "没人敲响的第二声钟",
      "type": "regional_v2",
      "region": "潮歌灯塔",
      "npc": "灯塔值夜人",
      "premise": "修灯后港口要求钟只报平安，却有人担心海难警报被压下。",
      "required_chapter": "ch006",
      "required_flags": [
        "story.ch006.done"
      ],
      "completion_flag": "side.rq_003.done",
      "stages": [
        {
          "id": "rq_003.meet",
          "objective": "听取灯塔值夜人的委托",
          "dialogue": [
            {
              "id": "rq_003.0.l01",
              "speaker": "值夜人",
              "text": "灯终于亮了，但第二声钟还是不准敲。"
            },
            {
              "id": "rq_003.0.l02",
              "speaker": "主角",
              "text": "十年前就是第二声钟引发了恐慌。"
            },
            {
              "id": "rq_003.0.l03",
              "speaker": "岚音",
              "text": "不能因为害怕警报就永远不报。"
            }
          ],
          "effects": []
        },
        {
          "id": "rq_003.investigate",
          "objective": "调查潮歌灯塔的相关证据",
          "dialogue": [
            {
              "id": "rq_003.1.l01",
              "speaker": "值夜人",
              "text": "第一次报归港，第二次报险情。"
            },
            {
              "id": "rq_003.1.l02",
              "speaker": "老渔妇",
              "text": "从前有人把警报当成灾难本身。"
            },
            {
              "id": "rq_003.1.l03",
              "speaker": "主角",
              "text": "那就说明不同钟声代表什么。"
            }
          ],
          "effects": []
        },
        {
          "id": "rq_003.choice",
          "objective": "处理与居民有关的冲突",
          "dialogue": [
            {
              "id": "rq_003.2.l01",
              "speaker": "港务员",
              "text": "警报太多会吓跑商人。"
            },
            {
              "id": "rq_003.2.l02",
              "speaker": "值夜人",
              "text": "不报警会让船沉在海里。"
            },
            {
              "id": "rq_003.2.l03",
              "speaker": "朔弦",
              "text": "把警报和误报都写进日志，向所有船长公开。"
            }
          ],
          "effects": [],
          "choice": {
            "id": "rq_003.choice",
            "prompt": "这件事你会如何处理？",
            "options": [
              {
                "id": "a",
                "label": "建立不同钟声的公开含义",
                "sets": {
                  "side.rq_003.approach": "a"
                }
              },
              {
                "id": "b",
                "label": "先组织船长的警报演练",
                "sets": {
                  "side.rq_003.approach": "b"
                }
              }
            ]
          }
        },
        {
          "id": "rq_003.resolution",
          "objective": "向灯塔值夜人反馈结果",
          "dialogue": [
            {
              "id": "rq_003.3.l01",
              "speaker": "旁白",
              "text": "港口挂出钟声说明，老人们自愿参加夜间轮值。"
            },
            {
              "id": "rq_003.3.l02",
              "speaker": "值夜人",
              "text": "今天第二声钟响，是因为真有船需要救。"
            },
            {
              "id": "rq_003.3.l03",
              "speaker": "主角",
              "text": "那就让它继续提醒人回家。"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "side.rq_003.done",
              "value": true
            }
          ]
        }
      ],
      "ending_variation": {
        "a": "建立不同钟声的公开含义",
        "b": "先组织船长的警报演练"
      },
      "status": "authored_text_not_runtime_bound"
    },
    {
      "id": "rq_004",
      "title": "三份重复的入境章",
      "type": "regional_v2",
      "region": "三誓王都外廷",
      "npc": "难民父亲",
      "premise": "跨国求医的父亲持有三份一样的签章却不被接待。",
      "required_chapter": "ch007",
      "required_flags": [
        "story.ch007.done"
      ],
      "completion_flag": "side.rq_004.done",
      "stages": [
        {
          "id": "rq_004.meet",
          "objective": "听取难民父亲的委托",
          "dialogue": [
            {
              "id": "rq_004.0.l01",
              "speaker": "父亲",
              "text": "三道门都盖章了，可没有一扇门让我进去。"
            },
            {
              "id": "rq_004.0.l02",
              "speaker": "雷索",
              "text": "签章不是治疗。"
            },
            {
              "id": "rq_004.0.l03",
              "speaker": "岚音",
              "text": "孩子先去医务所，手续我们随后处理。"
            }
          ],
          "effects": []
        },
        {
          "id": "rq_004.investigate",
          "objective": "调查三誓王都外廷的相关证据",
          "dialogue": [
            {
              "id": "rq_004.1.l01",
              "speaker": "书记官",
              "text": "这些章来自同一枚模具，所以都无效。"
            },
            {
              "id": "rq_004.1.l02",
              "speaker": "主角",
              "text": "是谁要求他们逐一排队？"
            },
            {
              "id": "rq_004.1.l03",
              "speaker": "父亲",
              "text": "我只知道每次排队，孩子都更虚弱。"
            }
          ],
          "effects": []
        },
        {
          "id": "rq_004.choice",
          "objective": "处理与居民有关的冲突",
          "dialogue": [
            {
              "id": "rq_004.2.l01",
              "speaker": "书记官",
              "text": "若不查清，别人也会要求破例。"
            },
            {
              "id": "rq_004.2.l02",
              "speaker": "雷索",
              "text": "紧急生命救助不应叫破例。"
            },
            {
              "id": "rq_004.2.l03",
              "speaker": "主角",
              "text": "保留原章作证，再制订跨境救医的确认流程。"
            }
          ],
          "effects": [],
          "choice": {
            "id": "rq_004.choice",
            "prompt": "这件事你会如何处理？",
            "options": [
              {
                "id": "a",
                "label": "先开展紧急救医，再追查假章",
                "sets": {
                  "side.rq_004.approach": "a"
                }
              },
              {
                "id": "b",
                "label": "公开三廷同一模具的调查",
                "sets": {
                  "side.rq_004.approach": "b"
                }
              }
            ]
          }
        },
        {
          "id": "rq_004.resolution",
          "objective": "向难民父亲反馈结果",
          "dialogue": [
            {
              "id": "rq_004.3.l01",
              "speaker": "旁白",
              "text": "三廷增设紧急医疗绿色通行登记。"
            },
            {
              "id": "rq_004.3.l02",
              "speaker": "父亲",
              "text": "我不想再拿着纸站一整夜。"
            },
            {
              "id": "rq_004.3.l03",
              "speaker": "岚音",
              "text": "以后先让医师见到病人。"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "side.rq_004.done",
              "value": true
            }
          ]
        }
      ],
      "ending_variation": {
        "a": "先开展紧急救医，再追查假章",
        "b": "公开三廷同一模具的调查"
      },
      "status": "authored_text_not_runtime_bound"
    },
    {
      "id": "rq_005",
      "title": "粮袋底下的字",
      "type": "regional_v2",
      "region": "三国边境议事站",
      "npc": "搬粮工",
      "premise": "运粮车上的袋子写着被烧村落的姓名，官员不愿公开。",
      "required_chapter": "ch010",
      "required_flags": [
        "story.ch010.done"
      ],
      "completion_flag": "side.rq_005.done",
      "stages": [
        {
          "id": "rq_005.meet",
          "objective": "听取搬粮工的委托",
          "dialogue": [
            {
              "id": "rq_005.0.l01",
              "speaker": "搬粮工",
              "text": "每袋粮底部都刻着一个名字。"
            },
            {
              "id": "rq_005.0.l02",
              "speaker": "雷索",
              "text": "这是从失火粮仓抢救的遗留物？"
            },
            {
              "id": "rq_005.0.l03",
              "speaker": "主角",
              "text": "先核实，不要用猜测伤害家属。"
            }
          ],
          "effects": []
        },
        {
          "id": "rq_005.investigate",
          "objective": "调查三国边境议事站的相关证据",
          "dialogue": [
            {
              "id": "rq_005.1.l01",
