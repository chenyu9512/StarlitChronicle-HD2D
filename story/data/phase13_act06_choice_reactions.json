      "condition": {
        "ch035.approach": "gradual",
        "world.ch035.approach": "gradual"
      },
      "insertion": "after_choice_commit_before_encounter",
      "optional": true,
      "independent_route": false,
      "dialogue": [
        {
          "id": "ch035.p13.choice.listen.l01",
          "speaker": "护士",
          "text": "先安排重症照护与陪伴时段，不用人数追成绩。"
        },
        {
          "id": "ch035.p13.choice.listen.l02",
          "speaker": "老人",
          "text": "我愿醒一会儿，不愿意时会告诉你们。"
        },
        {
          "id": "ch035.p13.choice.listen.l03",
          "speaker": "岚音",
          "text": "好，治疗计划可以随你的情况调整。"
        }
      ]
