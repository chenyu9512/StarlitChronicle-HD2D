      "condition": {
        "ch035.approach": "oversight",
        "world.ch035.approach": "oversight"
      },
      "insertion": "after_choice_commit_before_encounter",
      "optional": true,
      "independent_route": false,
      "dialogue": [
        {
          "id": "ch035.p13.choice.act.l01",
          "speaker": "玄璃",
          "text": "每扇梦门应有独立退出开关，也应有人定期检查。"
        },
        {
          "id": "ch035.p13.choice.act.l02",
          "speaker": "值夜护士",
          "text": "我会公布监督与申诉方式，不要求病人现场签长期协议。"
        },
        {
          "id": "ch035.p13.choice.act.l03",
          "speaker": "主角",
          "text": "谁来决定自己醒着多久，应该写得明明白白。"
        }
      ]
    },
