        }
      },
      "available_after": "chapter_complete",
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "followup.ch016.listen.l01",
          "speaker": "安置区护士",
          "text": "医院备用电源稳定后，矿工的缺失姓名陆续重新登记。"
        },
        {
          "id": "followup.ch016.listen.l02",
          "speaker": "岚音",
          "text": "登记前先让当事人知道记录用途，不要再偷填医疗资料。"
        },
        {
          "id": "followup.ch016.listen.l03",
          "speaker": "护士",
          "text": "连不愿公开姓名的人也有办法领到配餐。"
        }
      ],
      "text_revision": "repaired_original_distinct_choice_v2"
    },
