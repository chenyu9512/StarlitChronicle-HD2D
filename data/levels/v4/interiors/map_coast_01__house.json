  "investigations": [
    {
      "id": "inspect_stage_0_home_hutch",
      "source_visual_id": "stage_0_home_hutch",
      "kind": "home_hutch",
      "name": "澄舟的旧木橱",
      "cell": [
        30,
        14
      ],
      "first_text": "最里面放着一只少了盖的盐罐，底下压着‘第七位守灯人’的空信封。",
      "repeat_text": "你记起澄舟总把信封朝内放，怕潮气先毁掉落款。",
      "after_text": "橱门上新挂了一枚铜匙，旧信件已经被仔细装入纸夹。",
      "owner_absent_text": "这里有主人的旧信，不应擅自拿走。",
      "owner_present_text": "屋主同意你仔细查看「澄舟的旧木橱」，但提醒不要把家用物品带走。",
      "after_flag": "story.ch001.done",
      "privacy": "observe_only",
      "reward": null,
      "art_status": "existing_visual_only_d_input_pending"
    },
    {
      "id": "inspect_stage_1_harbor_guest_bed",
      "source_visual_id": "stage_1_harbor_guest_bed",
      "kind": "harbor_guest_bed",
      "name": "留给归人的床",
      "cell": [
        43,
        25
      ],
      "first_text": "枕套边用褪色蓝线缝着一颗星；床侧还留着一双旧草鞋。",
      "repeat_text": "被褥没有动，床角却一直保持整洁。",
      "after_text": "有人把洗净的枕套铺上，不再害怕为可能归来的人留出位置。",
      "owner_absent_text": "床上的东西是家人的牵挂，轻轻看一眼就好。",
      "owner_present_text": "屋主同意你仔细查看「留给归人的床」，但提醒不要把家用物品带走。",
      "after_flag": "story.ch001.done",
      "privacy": "observe_only",
      "reward": null,
      "art_status": "existing_visual_only_d_input_pending"
    },
    {
      "id": "inspect_stage_2_table",
      "source_visual_id": "stage_2_table",
      "kind": "table",
      "name": "三副碗筷的木桌",
      "cell": [
        36,
        24
      ],
      "first_text": "桌上有三枚深浅不同的茶杯印，第三副木筷比其他两副更旧。",
      "repeat_text": "木纹间还能看到当年的热汤痕迹。",
      "after_text": "第三只碗被摆正，桌上留出了一小块放新航图的空地。",
      "owner_absent_text": "没有主人允许，不应随便移动家人的摆设。",
      "owner_present_text": "屋主同意你仔细查看「三副碗筷的木桌」，但提醒不要把家用物品带走。",
      "after_flag": "story.ch001.done",
      "privacy": "observe_only",
      "reward": null,
      "art_status": "existing_visual_only_d_input_pending"
    },
    {
      "id": "inspect_stage_3_saltgrass_planter",
      "source_visual_id": "stage_3_saltgrass_planter",
      "kind": "saltgrass_planter",
      "name": "窗边盐草",
      "cell": [
        27,
        20
      ],
      "first_text": "旧花盆里只剩两株耐盐草，花盆背面有澄舟写的浇水日期。",
      "repeat_text": "土壤还有一点潮，今天不必再浇。",
      "after_text": "新叶比来时更绿，旁边添了一张记录潮湿天气的便签。",
      "owner_absent_text": "主人不在，浇水前最好先问清习惯。",
      "owner_present_text": "屋主同意你仔细查看「窗边盐草」，但提醒不要把家用物品带走。",
      "after_flag": "story.ch001.done",
