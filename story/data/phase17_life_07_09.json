{
  "schema": "starlit.story.phase17.life_branch_arcs.v1",
  "status": "authored_branch_arcs_not_runtime_bound",
  "batch": "03",
  "quests": [
    {
      "id": "sq_life_07",
      "late_chapter": "ch022",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "矿工家属探望",
            "dialogue": [
              {
                "id": "sq_life_07.p17.a.followup.l01",
                "speaker": "矿工遗属",
                "text": "猫还记得老矿工的手套气味。"
              },
              {
                "id": "sq_life_07.p17.a.followup.l02",
                "speaker": "学徒",
                "text": "让它自己走近，别急着抱走。"
              },
              {
                "id": "sq_life_07.p17.a.followup.l03",
                "speaker": "缇珐",
                "text": "炉房停机期间先划出安静的休息区。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "新猫窝",
            "dialogue": [
              {
                "id": "sq_life_07.p17.a.community.l01",
                "speaker": "工友",
                "text": "旧木箱垫上布了，远离热炉和搬运道。"
              },
              {
                "id": "sq_life_07.p17.a.community.l02",
                "speaker": "矿工遗属",
                "text": "猫想回厂房时，也有熟人接应。"
              },
              {
                "id": "sq_life_07.p17.a.community.l03",
                "speaker": "学徒",
                "text": "不是把它当老人的替身，只是照顾还活着的小家伙。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "停工后的脚步",
            "dialogue": [
              {
                "id": "sq_life_07.p17.a.revisit.l01",
                "speaker": "学徒",
                "text": "每到收工它还会来，现在也认得新工友了。"
              },
              {
                "id": "sq_life_07.p17.a.revisit.l02",
                "speaker": "矿工遗属",
                "text": "我偶尔来看它，不必天天守着那条旧路。"
              },
              {
                "id": "sq_life_07.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "炉房外多了个避风猫窝，门口留给来去自如的脚印。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "安全项圈",
            "dialogue": [
              {
                "id": "sq_life_07.p17.b.followup.l01",
                "speaker": "缇珐",
                "text": "项圈用易挣脱扣，不能把猫困在机器旁。"
              },
              {
                "id": "sq_life_07.p17.b.followup.l02",
                "speaker": "学徒",
                "text": "地址牌只写厂区联络点，不公开私人住址。"
              },
              {
                "id": "sq_life_07.p17.b.followup.l03",
                "speaker": "矿工遗属",
                "text": "先看它是否愿戴，不舒服就拿下来。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "走失寻找演练",
            "dialogue": [
              {
                "id": "sq_life_07.p17.b.community.l01",
                "speaker": "看门工",
                "text": "我在仓库看见它，没有追着跑，让它自己出来。"
              },
              {
                "id": "sq_life_07.p17.b.community.l02",
                "speaker": "学徒",
                "text": "安全点和清洁水碗都做了标记。"
              },
              {
                "id": "sq_life_07.p17.b.community.l03",
                "speaker": "缇珐",
                "text": "高温区域仍必须封闭，不能拿项圈替代防护。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "回来的猫",
            "dialogue": [
              {
                "id": "sq_life_07.p17.b.revisit.l01",
                "speaker": "看门工",
                "text": "今早它从旧街回来了，项圈上没勒痕。"
              },
              {
                "id": "sq_life_07.p17.b.revisit.l02",
                "speaker": "学徒",
                "text": "它想走时我们不关门，也有人照顾。"
              },
              {
                "id": "sq_life_07.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "炉房的安全牌上第一次多了一条动物避让提示。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_08",
      "late_chapter": "ch029",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "担架锤试验",
            "dialogue": [
              {
                "id": "sq_life_08.p17.a.followup.l01",
                "speaker": "岚音",
                "text": "敲开木梁时力道需要限制，不能伤到下面的人。"
              },
              {
                "id": "sq_life_08.p17.a.followup.l02",
                "speaker": "缇珐",
                "text": "我给锤头加缓冲面，请医护按真实场景测试。"
              },
              {
                "id": "sq_life_08.p17.a.followup.l03",
                "speaker": "护理员",
                "text": "先用沙袋假人，不让病人来试。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "救援模拟课",
            "dialogue": [
              {
                "id": "sq_life_08.p17.a.community.l01",
                "speaker": "医师",
                "text": "锤子能拆旧门，但强行敲击仍会震伤困住的人。"
              },
              {
                "id": "sq_life_08.p17.a.community.l02",
                "speaker": "缇珐",
                "text": "每次使用先确认支撑点，再换专业人员操作。"
              },
              {
                "id": "sq_life_08.p17.a.community.l03",
                "speaker": "学徒",
                "text": "我记下了失误步骤，不能只展示成功的一遍。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "第一次真实救援",
            "dialogue": [
              {
                "id": "sq_life_08.p17.a.revisit.l01",
                "speaker": "救援队员",
                "text": "新锤帮我们卸下压在门框的木楔。"
              },
              {
                "id": "sq_life_08.p17.a.revisit.l02",
                "speaker": "岚音",
                "text": "伤员已经安全转移，仍要检查工具是否出现裂纹。"
              },
              {
                "id": "sq_life_08.p17.a.revisit.l03",
                "speaker": "缇珐",
                "text": "终于有人用它开了救人的路。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "学徒评审台",
            "dialogue": [
              {
                "id": "sq_life_08.p17.b.followup.l01",
                "speaker": "学徒甲",
                "text": "锤头不能再磨尖，会变回可以制武器的样子。"
              },
              {
                "id": "sq_life_08.p17.b.followup.l02",
                "speaker": "缇珐",
                "text": "把结构设计和禁用工序一起留档。"
              },
              {
                "id": "sq_life_08.p17.b.followup.l03",
                "speaker": "工坊师傅",
                "text": "需要让维修者能拆开检查，而非只允许制造者碰。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "工坊耐久测试",
            "dialogue": [
              {
                "id": "sq_life_08.p17.b.community.l01",
                "speaker": "学徒乙",
                "text": "连续敲击后握柄松了，我申请重新装配。"
              },
              {
                "id": "sq_life_08.p17.b.community.l02",
                "speaker": "缇珐",
                "text": "先停用，安全退役也是设计的一部分。"
              },
              {
                "id": "sq_life_08.p17.b.community.l03",
                "speaker": "工坊师傅",
                "text": "把缺陷写上公告，别让下一批照着错图做。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "救援工具入库",
            "dialogue": [
              {
                "id": "sq_life_08.p17.b.revisit.l01",
                "speaker": "工坊师傅",
                "text": "工坊留下两个合格样品，领用要登记。"
              },
              {
                "id": "sq_life_08.p17.b.revisit.l02",
                "speaker": "缇珐",
                "text": "既不能改成兵器，也不能假装它绝不会造成伤害。"
              },
              {
                "id": "sq_life_08.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "非战斗工具柜旁贴着首次安全复核日期。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_09",
      "late_chapter": "ch031",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "修好的生日录音",
            "dialogue": [
              {
                "id": "sq_life_09.p17.a.followup.l01",
                "speaker": "老人",
                "text": "这句原来是女儿在笑，我以为机器坏了连她也不见了。"
              },
              {
                "id": "sq_life_09.p17.a.followup.l02",
                "speaker": "女儿",
                "text": "我们可以在家听一遍，不必让店里所有人围着看。"
              },
              {
                "id": "sq_life_09.p17.a.followup.l03",
                "speaker": "缇珐",
                "text": "音量慢慢调低，老机器的磁头还很脆弱。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "普通的一顿晚饭",
            "dialogue": [
              {
                "id": "sq_life_09.p17.a.community.l01",
                "speaker": "老人",
                "text": "录音里说想吃甜饼，今天我们要不要真的烤？"
              },
              {
                "id": "sq_life_09.p17.a.community.l02",
                "speaker": "女儿",
                "text": "可以，但别强求和记忆里一样好吃。"
              },
              {
                "id": "sq_life_09.p17.a.community.l03",
                "speaker": "岚音",
                "text": "一顿饭不用变成纪念演出，慢慢吃就好。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "新录的一句话",
            "dialogue": [
              {
                "id": "sq_life_09.p17.a.revisit.l01",
                "speaker": "女儿",
                "text": "我重新录了一句今天的生日祝福，没有擦掉旧磁带。"
              },
              {
                "id": "sq_life_09.p17.a.revisit.l02",
                "speaker": "老人",
                "text": "新声音听着陌生，却也是我们的日子。"
              },
              {
                "id": "sq_life_09.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "留声机仍偶尔卡顿，桌上多了一张新的录音标签。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "维修笔记",
            "dialogue": [
              {
                "id": "sq_life_09.p17.b.followup.l01",
                "speaker": "缇珐",
                "text": "把电容、磁头和缺损零件分别画下来。"
              },
              {
                "id": "sq_life_09.p17.b.followup.l02",
                "speaker": "老人",
                "text": "修法可以教别人，录音内容不放进教程。"
              },
              {
                "id": "sq_life_09.p17.b.followup.l03",
                "speaker": "学徒",
                "text": "我用空白磁带测试，避免拿原带反复试错。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "街坊旧机修复",
            "dialogue": [
              {
                "id": "sq_life_09.p17.b.community.l01",
                "speaker": "旧街居民",
                "text": "照着公开步骤，我也找到了机器的接触故障。"
              },
              {
                "id": "sq_life_09.p17.b.community.l02",
                "speaker": "缇珐",
                "text": "先断电再动手，不在通电时摸裸露部件。"
              },
              {
                "id": "sq_life_09.p17.b.community.l03",
                "speaker": "老人",
                "text": "我愿意出借维修图，不出借女儿那盒私密录音。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "修理间的开放日",
            "dialogue": [
              {
                "id": "sq_life_09.p17.b.revisit.l01",
                "speaker": "学徒",
                "text": "现在有几台留声机恢复播放，也有修不好的一台。"
              },
              {
                "id": "sq_life_09.p17.b.revisit.l02",
                "speaker": "老人",
                "text": "那台不能修也没关系，不需要编出声音来补全。"
              },
              {
                "id": "sq_life_09.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "公开修理手册多了安全页，私人的祝福仍属于一家人。"
              }
            ]
          }
        ]
      }
    }
  ]
}
