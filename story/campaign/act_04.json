      "chapter_number": 1,
      "title": "骑士最后的命令",
      "location": "十年前·肃清边村",
      "required_flags": [
        "story.ch018.done"
      ],
      "chapter_start_flag": "ch019.started",
      "chapter_complete_flag": "story.ch019.done",
      "lead_character": "雷索",
      "summary": "在十年前·肃清边村，操作年轻雷索保护村民撤离。直属长官命令雷索烧毁所有民宅以掩盖误报。最终，雷索放走居民，接受被夺爵位的代价。",
      "production_status": "scripted_blocking_v1",
      "recommended_level": [
        22,
        26
      ],
      "boss": "肃清队长",
      "scenes": [
        {
          "id": "ch019.opening",
          "title": "到达：十年前·肃清边村",
          "trigger": {
            "type": "chapter_enter",
            "region": "十年前·肃清边村"
          },
          "dialogue": [
            {
              "id": "ch019.opening.l01",
              "speaker": "旁白",
              "text": "【十年前·肃清边村】空气中藏着异样的气息。"
            },
            {
              "id": "ch019.opening.l02",
              "speaker": "雷索",
              "text": "军令写的是消灭敌人，可这里连一把剑都没有。"
            },
            {
              "id": "ch019.opening.l03",
              "speaker": "雷索（心声）",
              "text": "先把眼前的事弄清楚。操作年轻雷索保护村民撤离。"
            },
            {
              "id": "ch019.opening.l04",
              "speaker": "雷索",
              "text": "别忘了，沿途的人也有自己的故事。"
            }
          ],
          "objectives": [
            {
              "type": "reach",
              "target": "十年前·肃清边村"
            },
            {
              "type": "interact",
              "target": "ch019.key_npc"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch019.started",
              "value": true
            }
          ]
        },
        {
          "id": "ch019.investigate",
          "title": "调查线索",
          "trigger": {
            "type": "interact",
            "target": "ch019.clue"
          },
          "dialogue": [
            {
              "id": "ch019.investigate.l01",
              "speaker": "旁白",
              "text": "众人在十年前·肃清边村找到了一处被忽视的痕迹。"
            },
            {
              "id": "ch019.investigate.l02",
              "speaker": "雷索",
              "text": "所谓叛军信号来自村中用于求救的烟火。"
            },
            {
              "id": "ch019.investigate.l03",
              "speaker": "雷索（心声）",
              "text": "先别急着下结论。还有谁能证实这件事？"
            },
            {
              "id": "ch019.investigate.l04",
              "speaker": "旁白",
              "text": "日志、物件与目击证言彼此印证，事件终于露出轮廓。"
            }
          ],
          "objectives": [
            {
              "type": "inspect",
              "target": "ch019.clue"
            },
            {
              "type": "speak",
              "target": "ch019.witness"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch019.evidence",
              "value": true
            }
          ]
        },
        {
          "id": "ch019.crisis",
          "title": "真相与冲突",
          "trigger": {
            "type": "interact",
            "target": "ch019.crisis",
            "requires_flags": [
              "ch019.evidence"
            ]
          },
          "dialogue": [
            {
              "id": "ch019.crisis.l01",
              "speaker": "旁白",
              "text": "当最后一份证据摆上桌面，原本平静的局面终于被打破。"
            },
            {
              "id": "ch019.crisis.l02",
              "speaker": "雷索",
              "text": "直属长官命令雷索烧毁所有民宅以掩盖误报。"
            },
            {
              "id": "ch019.crisis.l03",
              "speaker": "雷索（心声）",
              "text": "不能只顾眼前的胜负。谁会因为我们的决定付出代价？"
            },
            {
              "id": "ch019.crisis.l04",
              "speaker": "雷索",
              "text": "这一次由你决定如何开口。我会一起承担后果。"
            }
          ],
          "objectives": [
            {
              "type": "decide",
              "target": "ch019.choice"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "ch019.decision_made",
              "value": true
            }
          ],
          "choice": {
            "id": "ch019.choice",
            "prompt": "面对眼前的矛盾，你打算怎样行动？",
            "options": [
              {
                "id": "listen",
                "label": "先听当事人的解释",
                "sets": {
                  "ch019.approach": "listen"
                }
              },
              {
                "id": "act",
                "label": "先保护可能受伤的人",
                "sets": {
                  "ch019.approach": "act"
                }
              }
            ]
          },
          "encounter": {
            "enemy_id": "boss.ch019",
            "display_name": "肃清队长",
            "win_flag": "ch019.battle_won",
            "recommended_level": 25
          }
        },
        {
          "id": "ch019.resolve",
          "title": "事件落幕",
          "trigger": {
            "type": "scene_after",
            "requires_flags": [
              "ch019.battle_won"
            ]
          },
          "dialogue": [
            {
              "id": "ch019.resolve.l01",
              "speaker": "旁白",
              "text": "风声渐弱，人们终于有机会面对自己刚才不愿承认的事。"
            },
            {
              "id": "ch019.resolve.l02",
              "speaker": "雷索",
              "text": "雷索放走居民，接受被夺爵位的代价。"
            },
            {
              "id": "ch019.resolve.l03",
              "speaker": "雷索（心声）",
              "text": "总有些事，不能只写成一行冒险记录。"
            },
            {
              "id": "ch019.resolve.l04",
              "speaker": "旁白",
              "text": "【任务完成】骑士最后的命令。新的道路正在展开。"
            }
          ],
          "objectives": [
            {
              "type": "finish_chapter",
              "target": "ch019"
            }
          ],
          "effects": [
            {
              "type": "set_flag",
              "key": "story.ch019.done",
              "value": true
            },
            {
              "type": "grant",
              "xp": 860,
              "gold": 306
            }
          ]
        }
      ],
      "npc_reactions": [
        {
          "condition": "ch019.started",
          "speaker": "路人",
          "text": "最近发生的事，你们也听说了吗？"
        },
        {
          "condition": "story.ch019.done",
          "speaker": "路人",
          "text": "听说你们在十年前·肃清边村帮了大忙。至少我们今天能安心一些。"
        }
