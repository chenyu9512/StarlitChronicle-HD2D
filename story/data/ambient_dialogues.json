  "camp_interludes": [
    {
      "id": "camp.001",
      "title": "路边留宿",
      "available_after_chapter": "ch008",
      "requires_flags": [
        "story.ch008.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.001.l01",
          "speaker": "岚音",
          "text": "饭锅里还有一点粥，谁没吃晚饭？"
        },
        {
          "id": "camp.001.l02",
          "speaker": "雷索",
          "text": "先给护粮的车夫。他今天一天都没坐下。"
        },
        {
          "id": "camp.001.l03",
          "speaker": "朔弦",
          "text": "你们两个总把自己的份让出去，我只好再添水了。"
        },
        {
          "id": "camp.001.l04",
          "speaker": "主角",
          "text": "水加太多，明天就成汤了。"
        }
      ]
    },
    {
      "id": "camp.002",
      "title": "审判前夜",
      "available_after_chapter": "ch009",
      "requires_flags": [
        "story.ch009.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.002.l01",
          "speaker": "雷索",
          "text": "我知道明天可能会输。"
        },
        {
          "id": "camp.002.l02",
          "speaker": "岚音",
          "text": "那你为什么还站到这里？"
        },
        {
          "id": "camp.002.l03",
          "speaker": "雷索",
          "text": "因为如果我不说，活下来的人还要替我说。"
        },
        {
          "id": "camp.002.l04",
          "speaker": "主角",
          "text": "那明天我们一起把话说完整。"
        }
      ]
    },
    {
      "id": "camp.003",
      "title": "三国小食",
      "available_after_chapter": "ch012",
      "requires_flags": [
        "story.ch012.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.003.l01",
          "speaker": "朔弦",
          "text": "三种烤饼放在同一桌上，谁都说自己的最好。"
        },
        {
          "id": "camp.003.l02",
          "speaker": "雷索",
          "text": "中间那种更耐放，行军时合适。"
        },
        {
          "id": "camp.003.l03",
          "speaker": "岚音",
          "text": "你评价食物时就不能先说味道吗？"
        },
        {
          "id": "camp.003.l04",
          "speaker": "雷索",
          "text": "……好吃。这样行吗？"
        }
      ]
    },
    {
      "id": "camp.004",
      "title": "赤炉的夜",
      "available_after_chapter": "ch013",
      "requires_flags": [
        "story.ch013.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.004.l01",
          "speaker": "缇珐",
          "text": "城里的人睡着，炉子却必须继续烧。"
        },
        {
          "id": "camp.004.l02",
          "speaker": "朔弦",
          "text": "你也必须一直干活？"
        },
        {
          "id": "camp.004.l03",
          "speaker": "缇珐",
          "text": "有人这样要求，我已经习惯了。"
        },
        {
          "id": "camp.004.l04",
          "speaker": "岚音",
          "text": "习惯不代表合理。今晚轮到你休息。"
        }
      ]
    },
    {
      "id": "camp.005",
      "title": "蓝围巾",
      "available_after_chapter": "ch014",
      "requires_flags": [
        "story.ch014.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.005.l01",
          "speaker": "缇珐",
          "text": "我对机器的记忆比对人清楚，这算不算很糟？"
        },
        {
          "id": "camp.005.l02",
          "speaker": "主角",
          "text": "从现在起，可以试着先记住人的名字。"
        },
        {
          "id": "camp.005.l03",
          "speaker": "缇珐",
          "text": "那个矿工的孩子叫小石头。我记住了。"
        },
        {
          "id": "camp.005.l04",
          "speaker": "岚音",
          "text": "他有真正的名字。明天我们去问他。"
        }
      ]
    },
    {
      "id": "camp.006",
      "title": "搬运煤袋",
      "available_after_chapter": "ch016",
      "requires_flags": [
        "story.ch016.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.006.l01",
          "speaker": "朔弦",
          "text": "我这辈子最后一次搬煤，真的。"
        },
        {
          "id": "camp.006.l02",
          "speaker": "雷索",
          "text": "半个时辰前你也是这样说的。"
        },
        {
          "id": "camp.006.l03",
          "speaker": "缇珐",
          "text": "你们把煤堆在通风口，我还得重搬。"
        },
        {
          "id": "camp.006.l04",
          "speaker": "主角",
          "text": "那今晚先把人和煤都摆对位置。"
        }
      ]
    },
    {
      "id": "camp.007",
      "title": "炉城的第一顿饭",
      "available_after_chapter": "ch018",
      "requires_flags": [
        "story.ch018.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.007.l01",
          "speaker": "缇珐",
          "text": "我总觉得机器会在我们吃饭时坏掉。"
        },
        {
          "id": "camp.007.l02",
          "speaker": "岚音",
          "text": "它若真坏了，我们吃完才有力气修。"
        },
        {
          "id": "camp.007.l03",
          "speaker": "朔弦",
          "text": "这句我要刻在工作台上。"
        },
        {
          "id": "camp.007.l04",
          "speaker": "雷索",
          "text": "别刻。饭菜会凉。"
        }
      ]
    },
    {
      "id": "camp.008",
      "title": "旧披风",
      "available_after_chapter": "ch019",
      "requires_flags": [
        "story.ch019.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.008.l01",
          "speaker": "雷索",
          "text": "很多年后，那孩子把披风还给了我。"
        },
        {
          "id": "camp.008.l02",
          "speaker": "岚音",
          "text": "你收下了吗？"
        },
        {
          "id": "camp.008.l03",
          "speaker": "雷索",
          "text": "收下了。然后又送给了一个怕冷的孩子。"
        },
        {
          "id": "camp.008.l04",
          "speaker": "主角",
          "text": "看来那件披风比你走过更远的路。"
        }
      ]
    },
    {
      "id": "camp.009",
      "title": "无人知晓的岛",
      "available_after_chapter": "ch020",
      "requires_flags": [
        "story.ch020.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.009.l01",
          "speaker": "朔弦",
          "text": "我记得故乡的树歪向左边。"
        },
        {
          "id": "camp.009.l02",
          "speaker": "岚音",
          "text": "也许多年后会歪向右边呢。"
        },
        {
          "id": "camp.009.l03",
          "speaker": "朔弦",
          "text": "那我也认得。树长歪了，家还是家。"
        },
        {
          "id": "camp.009.l04",
          "speaker": "主角",
          "text": "等到了那座岛，你可以慢慢看。"
        }
      ]
    },
    {
      "id": "camp.010",
      "title": "病历",
      "available_after_chapter": "ch021",
      "requires_flags": [
        "story.ch021.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.010.l01",
          "speaker": "岚音",
          "text": "你要是想一个人待会儿，我就在营火那边。"
        },
        {
          "id": "camp.010.l02",
          "speaker": "主角",
          "text": "不用，我只是不知道该从哪一页看起。"
        },
        {
          "id": "camp.010.l03",
          "speaker": "岚音",
          "text": "从你愿意看的那一页。我们不赶时间。"
        },
        {
          "id": "camp.010.l04",
          "speaker": "雷索",
          "text": "今晚谁都不该催你。"
        }
      ]
    },
    {
      "id": "camp.011",
      "title": "比剑还锋利的东西",
      "available_after_chapter": "ch023",
      "requires_flags": [
        "story.ch023.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.011.l01",
          "speaker": "雷索",
          "text": "以前我总认为，伤害人的是刀。"
        },
        {
          "id": "camp.011.l02",
          "speaker": "朔弦",
          "text": "改掉一行档案，也能让一个人无家可归。"
        },
        {
          "id": "camp.011.l03",
          "speaker": "岚音",
          "text": "医院也是，擦掉病历就像擦掉病人。"
        },
        {
          "id": "camp.011.l04",
          "speaker": "主角",
          "text": "所以该留下的证据，一页也别丢。"
        }
      ]
    },
    {
      "id": "camp.012",
      "title": "海风将至",
      "available_after_chapter": "ch024",
      "requires_flags": [
        "story.ch024.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.012.l01",
          "speaker": "朔弦",
          "text": "听说海歌港有一艘旧船还没人肯买。"
        },
        {
          "id": "camp.012.l02",
          "speaker": "雷索",
          "text": "为什么？"
        },
        {
          "id": "camp.012.l03",
          "speaker": "朔弦",
          "text": "漏水、破帆、还有船主欠了不少钱。"
        },
        {
          "id": "camp.012.l04",
          "speaker": "岚音",
          "text": "听起来非常适合你。"
        }
      ]
    },
    {
      "id": "camp.013",
      "title": "逐星号的晾衣绳",
      "available_after_chapter": "ch026",
      "requires_flags": [
        "story.ch026.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.013.l01",
          "speaker": "朔弦",
          "text": "谁把药草挂到了船头？"
        },
        {
          "id": "camp.013.l02",
          "speaker": "岚音",
          "text": "需要海风晾干。你不是说今天风向最好吗？"
        },
        {
          "id": "camp.013.l03",
          "speaker": "朔弦",
          "text": "我说的是航海，不是晾衣服。"
        },
        {
          "id": "camp.013.l04",
          "speaker": "主角",
          "text": "现在至少知道哪边风大了。"
        }
      ]
    },
    {
      "id": "camp.014",
      "title": "风航灯下",
      "available_after_chapter": "ch030",
      "requires_flags": [
        "story.ch030.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.014.l01",
          "speaker": "伊泽",
          "text": "一盏灯竟能照出这么多条回家的航路。"
        },
        {
          "id": "camp.014.l02",
          "speaker": "朔弦",
          "text": "因为大家愿意把航路告诉别人。"
        },
        {
          "id": "camp.014.l03",
          "speaker": "岚音",
          "text": "如果有人从来没有家呢？"
        },
        {
          "id": "camp.014.l04",
          "speaker": "伊泽",
          "text": "那我们就先写一首关于找到落脚之处的歌。"
        }
      ]
    },
    {
      "id": "camp.015",
      "title": "现实的雨",
      "available_after_chapter": "ch036",
      "requires_flags": [
        "story.ch036.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.015.l01",
          "speaker": "玄璃",
          "text": "现实里的雨会把鞋子弄湿，真麻烦。"
        },
        {
          "id": "camp.015.l02",
          "speaker": "岚音",
          "text": "你也可以抱怨它，这很正常。"
        },
        {
          "id": "camp.015.l03",
          "speaker": "玄璃",
          "text": "梦里的雨从不让我冷。"
        },
        {
          "id": "camp.015.l04",
          "speaker": "主角",
          "text": "所以我们才需要在雨停后烤火。"
        }
      ]
    },
    {
      "id": "camp.016",
      "title": "给诺依讲故事",
      "available_after_chapter": "ch042",
      "requires_flags": [
        "story.ch042.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.016.l01",
          "speaker": "诺依",
          "text": "世界上真的有从地图上掉下来的岛吗？"
        },
        {
          "id": "camp.016.l02",
          "speaker": "朔弦",
          "text": "有，掉下来时还差点砸中我。"
        },
        {
          "id": "camp.016.l03",
          "speaker": "岚音",
          "text": "别吓他，岛不是那样掉的。"
        },
        {
          "id": "camp.016.l04",
          "speaker": "主角",
          "text": "先吃饭。等吃完我再把故事讲完整。"
        }
      ]
    },
    {
      "id": "camp.017",
      "title": "撤离营火",
      "available_after_chapter": "ch048",
      "requires_flags": [
        "story.ch048.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.017.l01",
          "speaker": "雷索",
          "text": "最后一辆马车已经上路。"
        },
        {
          "id": "camp.017.l02",
          "speaker": "岚音",
          "text": "还有人没找到，但我们不能再把孩子留在这里。"
        },
        {
          "id": "camp.017.l03",
          "speaker": "主角",
          "text": "我明白。"
        },
        {
          "id": "camp.017.l04",
          "speaker": "朔弦",
          "text": "别看我。我也不知道这次该说什么。"
        }
      ]
    },
    {
      "id": "camp.018",
      "title": "旧照片",
      "available_after_chapter": "ch049",
      "requires_flags": [
        "story.ch049.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.018.l01",
          "speaker": "诺依",
          "text": "他们说你年轻时连饭都顾不上吃。"
        },
        {
          "id": "camp.018.l02",
          "speaker": "主角",
          "text": "那只是朔弦把自己的份藏起来了。"
        },
        {
          "id": "camp.018.l03",
          "speaker": "诺依",
          "text": "所以传说里有一半是他编的？"
        },
        {
          "id": "camp.018.l04",
          "speaker": "主角",
          "text": "不止一半。"
        }
      ]
    },
    {
      "id": "camp.019",
      "title": "旧灯塔旁",
      "available_after_chapter": "ch053",
      "requires_flags": [
        "story.ch053.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.019.l01",
          "speaker": "诺依",
          "text": "有人不愿意原谅你。"
        },
        {
          "id": "camp.019.l02",
          "speaker": "主角",
          "text": "他有权这样想。"
        },
        {
          "id": "camp.019.l03",
          "speaker": "诺依",
          "text": "那你还要帮这个村子吗？"
        },
        {
          "id": "camp.019.l04",
          "speaker": "主角",
          "text": "要。帮忙不是换一句原谅。"
        }
      ]
    },
    {
      "id": "camp.020",
      "title": "维莎的手记",
      "available_after_chapter": "ch058",
      "requires_flags": [
        "story.ch058.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.020.l01",
          "speaker": "维莎",
          "text": "我的手记只写数字，不写姓名。"
        },
        {
          "id": "camp.020.l02",
          "speaker": "缇珐",
          "text": "从今天起，先学会写名字。"
        },
        {
          "id": "camp.020.l03",
          "speaker": "维莎",
          "text": "我怕自己写错。"
        },
        {
          "id": "camp.020.l04",
          "speaker": "岚音",
          "text": "写错可以改。什么都不写才是真的把人丢下。"
        }
      ]
    },
    {
      "id": "camp.021",
      "title": "自由城夜市",
      "available_after_chapter": "ch060",
      "requires_flags": [
        "story.ch060.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.021.l01",
          "speaker": "朔弦",
          "text": "以前我们走到哪儿都要先找旅馆。"
        },
        {
          "id": "camp.021.l02",
          "speaker": "岚音",
          "text": "现在这里也有一间是我们一起修的。"
        },
        {
          "id": "camp.021.l03",
          "speaker": "主角",
          "text": "以后有人路过时，就能在这里歇脚。"
        },
        {
          "id": "camp.021.l04",
          "speaker": "诺依",
          "text": "那我来写欢迎牌。"
        }
      ]
    },
    {
      "id": "camp.022",
      "title": "天轨窗口",
      "available_after_chapter": "ch066",
      "requires_flags": [
        "story.ch066.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.022.l01",
          "speaker": "玄璃",
          "text": "那边的星星，和映世里的并不一样。"
        },
        {
          "id": "camp.022.l02",
          "speaker": "维莎",
          "text": "因为这里的未来没有全部固定下来。"
        },
        {
          "id": "camp.022.l03",
          "speaker": "诺依",
          "text": "原来天空也可以让人走错路。"
        },
        {
          "id": "camp.022.l04",
          "speaker": "主角",
          "text": "走错了还能回头，这样就够了。"
        }
      ]
    },
    {
      "id": "camp.023",
      "title": "最终决战之前",
      "available_after_chapter": "ch071",
      "requires_flags": [
        "story.ch071.done"
      ],
      "repeatable": false,
      "status": "text_only_optional",
      "dialogue": [
        {
          "id": "camp.023.l01",
          "speaker": "雷索",
          "text": "每个人都记得自己为什么来到这里吗？"
        },
        {
          "id": "camp.023.l02",
          "speaker": "朔弦",
          "text": "我当然记得。只是有点紧张。"
        },
        {
          "id": "camp.023.l03",
          "speaker": "岚音",
          "text": "紧张也可以说出来。"
        },
        {
          "id": "camp.023.l04",
          "speaker": "主角",
          "text": "那我先说。我很怕，但不会一个人进去。"
        }
      ]
    }
  ]
}
