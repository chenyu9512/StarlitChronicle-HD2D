{
  "schema": "starlit.story.phase17.life_branch_arcs.v1",
  "status": "authored_branch_arcs_not_runtime_bound",
  "batch": "07",
  "quests": [
    {
      "id": "sq_life_19",
      "late_chapter": "ch050",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "两种姓名索引",
            "dialogue": [
              {
                "id": "sq_life_19.p17.a.followup.l01",
                "speaker": "书记员",
                "text": "这个名字读音相同，旧纸上的写法却有两种。"
              },
              {
                "id": "sq_life_19.p17.a.followup.l02",
                "speaker": "旧洲居民",
                "text": "现用名我自己决定，旧名只当历史线索。"
              },
              {
                "id": "sq_life_19.p17.a.followup.l03",
                "speaker": "玄璃",
                "text": "先让本人确认，档案不是替人取名的机器。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "给识字学生的练习",
            "dialogue": [
              {
                "id": "sq_life_19.p17.a.community.l01",
                "speaker": "教师",
                "text": "写错了可以改，不要当众让申请人读自己的旧名。"
              },
              {
                "id": "sq_life_19.p17.a.community.l02",
                "speaker": "书记员",
                "text": "索引分开记发音、历史写法和来源。"
              },
              {
                "id": "sq_life_19.p17.a.community.l03",
                "speaker": "居民",
                "text": "我愿更正祖母的名字，自己的地址先不公开。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "后来的一次申诉",
            "dialogue": [
              {
                "id": "sq_life_19.p17.a.revisit.l01",
                "speaker": "书记员",
                "text": "新索引找到两处重名，不再把两户并成一户。"
              },
              {
                "id": "sq_life_19.p17.a.revisit.l02",
                "speaker": "居民",
                "text": "我终于有了自己选用的称呼，也能查祖先线索。"
              },
              {
                "id": "sq_life_19.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "档案柜增设勘误栏，名字没有被谁永久定死。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "本人签字台",
            "dialogue": [
              {
                "id": "sq_life_19.p17.b.followup.l01",
                "speaker": "书记员",
                "text": "这张表给你自己填写，来不及想好可以带回家。"
              },
              {
                "id": "sq_life_19.p17.b.followup.l02",
                "speaker": "旧洲居民",
                "text": "我想先只写读音，不公布旧日来历。"
              },
              {
                "id": "sq_life_19.p17.b.followup.l03",
                "speaker": "玄璃",
                "text": "本人可以拒绝被别人挑选名字。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "隐私查询练习",
            "dialogue": [
              {
                "id": "sq_life_19.p17.b.community.l01",
                "speaker": "居民",
                "text": "能让祖母查到我吗？陌生人不可以。"
              },
              {
                "id": "sq_life_19.p17.b.community.l02",
                "speaker": "书记员",
                "text": "公开与亲属授权分开设置，还能随时撤回。"
              },
              {
                "id": "sq_life_19.p17.b.community.l03",
                "speaker": "岚音",
                "text": "医疗档里不要自动同步旧名，先取得同意。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "新生儿的名字",
            "dialogue": [
              {
                "id": "sq_life_19.p17.b.revisit.l01",
                "speaker": "年轻父母",
                "text": "孩子的名字写好啦，以后她也能决定怎么称呼自己。"
              },
              {
                "id": "sq_life_19.p17.b.revisit.l02",
                "speaker": "书记员",
                "text": "登记不是终身封印，有更正途径。"
              },
              {
                "id": "sq_life_19.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "大厅里第一次有了让申请者坐下慢慢写字的桌子。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_20",
      "late_chapter": "ch054",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "诺依的第一句话",
            "dialogue": [
              {
                "id": "sq_life_20.p17.a.followup.l01",
                "speaker": "诺依",
                "text": "我想写“妈妈，我今天吃了热饭”，这样可以吗？"
              },
              {
                "id": "sq_life_20.p17.a.followup.l02",
                "speaker": "岚音",
                "text": "可以，你想写多短都行。"
              },
              {
                "id": "sq_life_20.p17.a.followup.l03",
                "speaker": "主角",
                "text": "不要让旁人替他写成勇敢或者已经想开。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "无地址纪念邮筒",
            "dialogue": [
              {
                "id": "sq_life_20.p17.a.community.l01",
                "speaker": "营地邮差",
                "text": "没有地址的信也能收，但不擅自拆阅。"
              },
              {
                "id": "sq_life_20.p17.a.community.l02",
                "speaker": "诺依",
                "text": "我自己把那颗糖画在信封角上。"
              },
              {
                "id": "sq_life_20.p17.a.community.l03",
                "speaker": "岚音",
                "text": "你随时可以改主意，把信留在自己手里。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "多年后的信封",
            "dialogue": [
              {
                "id": "sq_life_20.p17.a.revisit.l01",
                "speaker": "成年诺依",
                "text": "我还记得第一封写得歪歪的信。"
              },
              {
                "id": "sq_life_20.p17.a.revisit.l02",
                "speaker": "主角",
                "text": "后来你写了很多封，也不必每封都有答案。"
              },
              {
                "id": "sq_life_20.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "旧邮筒仍收无地址来信，诺依偶尔会来帮忙整理。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "海的颜色",
            "dialogue": [
              {
                "id": "sq_life_20.p17.b.followup.l01",
                "speaker": "诺依",
                "text": "我今天不想写字，先画一片海好吗？"
              },
              {
                "id": "sq_life_20.p17.b.followup.l02",
                "speaker": "岚音",
                "text": "好，海也可以画成你记得的颜色。"
              },
              {
                "id": "sq_life_20.p17.b.followup.l03",
                "speaker": "主角",
                "text": "没有必要为一封信规定完成时间。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "第二张画纸",
            "dialogue": [
              {
                "id": "sq_life_20.p17.b.community.l01",
                "speaker": "营地孩子",
                "text": "我也想画给没回来的人，不知道画什么。"
              },
              {
                "id": "sq_life_20.p17.b.community.l02",
                "speaker": "诺依",
                "text": "先画我们吃过的饭吧，画错了还可以再画。"
              },
              {
                "id": "sq_life_20.p17.b.community.l03",
                "speaker": "岚音",
                "text": "画不会代替寻找，但能陪你们度过今天。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "十二年后的海边",
            "dialogue": [
              {
                "id": "sq_life_20.p17.b.revisit.l01",
                "speaker": "成年诺依",
                "text": "以前那张海画还在，我今天终于写了一行字。"
              },
              {
                "id": "sq_life_20.p17.b.revisit.l02",
                "speaker": "主角",
                "text": "你不欠任何人一封准时寄出的信。"
              },
              {
                "id": "sq_life_20.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "诺依把画和字分开装好，沿着真实的海岸继续走。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_21",
      "late_chapter": "ch063",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "旧茶杯与量身尺",
            "dialogue": [
              {
                "id": "sq_life_21.p17.a.followup.l01",
                "speaker": "老邻居",
                "text": "澄舟总等茶放凉才喝，怕孩子碰倒烫着。"
              },
              {
                "id": "sq_life_21.p17.a.followup.l02",
                "speaker": "主角",
                "text": "这杯子我记得，可我不记得他何时修了屋檐。"
              },
              {
                "id": "sq_life_21.p17.a.followup.l03",
                "speaker": "岚音",
                "text": "我们把修缮日期单独查，不用茶杯证明他还活着。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "村屋的木梁",
            "dialogue": [
              {
                "id": "sq_life_21.p17.a.community.l01",
                "speaker": "修屋匠",
                "text": "第三根梁上有澄舟旧年的修补记号。"
              },
              {
                "id": "sq_life_21.p17.a.community.l02",
                "speaker": "老邻居",
                "text": "这小事比传说里的伟大发明更像他。"
              },
              {
                "id": "sq_life_21.p17.a.community.l03",
                "speaker": "主角",
                "text": "把工匠姓名也记上，屋子不是一人修起来的。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "后来量身尺旁",
            "dialogue": [
              {
                "id": "sq_life_21.p17.a.revisit.l01",
                "speaker": "主角",
                "text": "我把茶杯放在这里，不是等他某天突然回来。"
              },
              {
                "id": "sq_life_21.p17.a.revisit.l02",
                "speaker": "老邻居",
                "text": "有些人留下的是怎么照顾别人。"
              },
              {
                "id": "sq_life_21.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "旧屋添了一把新椅子，来访的人还能自己泡茶。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "老邻居慢慢说",
            "dialogue": [
              {
                "id": "sq_life_21.p17.b.followup.l01",
                "speaker": "老邻居",
                "text": "我只记得他每晚把茶晾凉，别催我想起更多。"
              },
              {
                "id": "sq_life_21.p17.b.followup.l02",
                "speaker": "主角",
                "text": "你记得什么就说什么，不知道也没关系。"
              },
              {
                "id": "sq_life_21.p17.b.followup.l03",
                "speaker": "岚音",
                "text": "未经核实的日期先写在旁注。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "不同人的记忆",
            "dialogue": [
              {
                "id": "sq_life_21.p17.b.community.l01",
                "speaker": "修屋匠",
                "text": "我记得屋檐是雨季修的，他却说在秋天。"
              },
              {
                "id": "sq_life_21.p17.b.community.l02",
                "speaker": "老邻居",
                "text": "那就都记下，等找到账本再对照。"
              },
              {
                "id": "sq_life_21.p17.b.community.l03",
                "speaker": "主角",
                "text": "不要为了完整故事逼老人选一个正确答案。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "旧屋的访客登记",
            "dialogue": [
              {
                "id": "sq_life_21.p17.b.revisit.l01",
                "speaker": "老邻居",
                "text": "我后来想起另一件小事，今天自己来补记。"
              },
              {
                "id": "sq_life_21.p17.b.revisit.l02",
                "speaker": "主角",
                "text": "谢谢。我们可以保留早先的记录，不抹掉更改过程。"
              },
              {
                "id": "sq_life_21.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "茶壶仍在炉边，口述册多出几页诚实的不确定。"
              }
            ]
          }
        ]
      }
    }
  ]
}
