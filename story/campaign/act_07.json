            "options": [
              {
                "id": "hear",
                "label": "先取得更多证词",
                "sets": {
                  "ch037.approach": "hear"
                }
              },
              {
                "id": "protect",
                "label": "先保护受威胁的人",
                "sets": {
                  "ch037.approach": "protect"
                }
              }
            ]
          },
          "encounter": {
            "enemy_id": "boss.ch037",
            "display_name": "遮航迷雾",
            "win_flag": "ch037.battle_won",
            "recommended_level": 47
          }
