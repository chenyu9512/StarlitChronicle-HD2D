    {
      "id": "ch033.p13.choice.listen",
      "chapter_id": "ch033",
      "after_choice_id": "ch033.choice",
      "choice_option_id": "listen",
      "condition": {
        "ch033.approach": "share",
        "world.ch033.approach": "share"
      },
      "insertion": "after_choice_commit_before_encounter",
      "optional": true,
      "independent_route": false,
      "dialogue": [
        {
          "id": "ch033.p13.choice.listen.l01",
          "speaker": "雷索",
          "text": "我看到的选择，不必替别人证明哪条路更好。"
        },
        {
          "id": "ch033.p13.choice.listen.l02",
          "speaker": "岚音",
          "text": "愿意说的人慢慢说；我也准备好听问题。"
        },
        {
          "id": "ch033.p13.choice.listen.l03",
          "speaker": "玄璃",
          "text": "没有被选择的未来，可以被记住，而不必被住进去。"
        }
      ]
    },
    {
      "id": "ch033.p13.choice.act",
      "chapter_id": "ch033",
      "after_choice_id": "ch033.choice",
      "choice_option_id": "act",
      "condition": {
        "ch033.approach": "space",
        "world.ch033.approach": "space"
      },
      "insertion": "after_choice_commit_before_encounter",
      "optional": true,
      "independent_route": false,
      "dialogue": [
        {
          "id": "ch033.p13.choice.act.l01",
          "speaker": "朔弦",
          "text": "有人不想谈，就给他留张椅子和一杯水吧。"
        },
        {
          "id": "ch033.p13.choice.act.l02",
          "speaker": "伊泽",
          "text": "我不会把每个人的遗憾唱给所有听众。"
        },
        {
          "id": "ch033.p13.choice.act.l03",
          "speaker": "主角",
          "text": "等愿意的时候再说，我们继续沿真实的路走。"
        }
      ]
    },
    {
      "id": "ch034.p13.choice.listen",
      "chapter_id": "ch034",
      "after_choice_id": "ch034.choice",
      "choice_option_id": "listen",
      "condition": {
        "ch034.approach": "self_voice",
        "world.ch034.approach": "self_voice"
