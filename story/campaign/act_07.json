            {
              "id": "ch037.crisis.l01",
              "speaker": "旁白",
              "text": "被掩埋的矛盾终于爆发。"
            },
            {
              "id": "ch037.crisis.l02",
              "speaker": "朔弦",
              "text": "航页一旦被修复，海上商会就要承认自己隐瞒了几十年的航线。"
            },
            {
              "id": "ch037.crisis.l03",
              "speaker": "主角",
              "text": "我们作出的选择，会成为别人生活的一部分。"
            },
            {
              "id": "ch037.crisis.l04",
              "speaker": "朔弦",
              "text": "说出你的决定吧，我会站在这里。"
            }
          ],
          "objectives": [
            {
              "type": "decide",
              "target": "ch037.choice"
            }
