{
  "schema": "starlit.story.npc_barks.v1",
  "lines": [
    {
      "id": "npc_bark_001",
      "speaker": "城门卫兵",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch008.started"
      ],
      "text": "今天过关要检查三次，连我们自己都烦了。"
    },
    {
      "id": "npc_bark_002",
      "speaker": "粮贩",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch012.done"
      ],
      "text": "三国又有商队来了，希望这条路别再关上。"
    },
    {
      "id": "npc_bark_003",
      "speaker": "矿工",
      "location": "赤炉联邦",
      "requires_flags": [
        "story.ch016.started"
      ],
      "text": "我从工厂回来，儿子竟然不认识我了。"
    },
    {
      "id": "npc_bark_004",
      "speaker": "矿工家属",
      "location": "赤炉联邦",
      "requires_flags": [
        "story.ch018.done"
      ],
      "text": "工资还没补足，不过总算有人肯承认我们存在。"
    },
    {
      "id": "npc_bark_005",
      "speaker": "海港船工",
      "location": "海歌港",
      "requires_flags": [
        "story.ch025.started"
      ],
      "text": "这船漏得能养鱼，可修起来会是一艘好船。"
    },
    {
      "id": "npc_bark_006",
      "speaker": "海岛邮差",
      "location": "海歌群岛",
      "requires_flags": [
        "story.ch026.done"
      ],
      "text": "信终于有地方寄了，有些答案不急着到。"
    },
    {
      "id": "npc_bark_007",
      "speaker": "年轻画师",
      "location": "镜眠王都",
      "requires_flags": [
        "story.ch031.started"
      ],
      "text": "我每天都画同一朵花，怎么画也觉得差一点。"
    },
    {
      "id": "npc_bark_008",
      "speaker": "护士",
      "location": "镜眠王都",
      "requires_flags": [
        "story.ch035.done"
      ],
      "text": "醒来的人会哭，也会笑。至少都是自己的心情。"
    },
    {
      "id": "npc_bark_009",
      "speaker": "旧洲商人",
      "location": "旧洲",
      "requires_flags": [
        "story.ch042.done"
      ],
      "text": "我们能重新标上家乡的地名了。"
    },
    {
      "id": "npc_bark_010",
      "speaker": "老人",
      "location": "晨露村",
      "requires_flags": [
        "world.black_star"
      ],
      "text": "灯塔还站着，可我已经忘了它以前是什么颜色。"
    },
    {
      "id": "npc_bark_011",
      "speaker": "修桥工",
      "location": "灾后王都",
      "requires_flags": [
        "story.ch050.done"
      ],
      "text": "旧桥断了好多年，我们正在把路接起来。"
    },
    {
      "id": "npc_bark_012",
      "speaker": "旅店老板",
      "location": "群灯之城",
      "requires_flags": [
        "story.ch057.done"
      ],
      "text": "今天又多了一户人搬进来，厨房得多备两份菜。"
    },
    {
      "id": "npc_bark_013",
      "speaker": "卫兵",
      "location": "群灯之城",
      "requires_flags": [
        "story.ch060.done"
      ],
      "text": "我不替灯王守门，我给愿意回家的居民指路。"
    },
    {
      "id": "npc_bark_014",
      "speaker": "学者",
      "location": "天轨圣域",
      "requires_flags": [
        "story.ch062.done"
      ],
      "text": "原来所谓“万无一失”，从第一天起就是自欺欺人。"
    },
    {
      "id": "npc_bark_015",
      "speaker": "孩子",
      "location": "晨露村",
      "requires_flags": [
        "story.ch072.done"
      ],
      "text": "今天海面上的星星好亮。我想长大后也去旅行。"
    }
  ]
}
