  "major_setpiece_design": {
    "flashback_transition": {
      "scope": "ch019_ch021",
      "status": "design_not_runtime_bound",
      "rules": [
        "第19章年轻雷索、第20章年轻朔弦、第21章少年岚音分别使用不同年代临时操作视角，不读取现世同伴UI组队状态作为剧情前置",
        "每段回忆在resolve时回归现世；第21章例外：ch021.crisis对白后必须先转回现世，再弹出关于岚音隐瞒的原有choice",
        "不能在过去时间层触发现世地图NPC、现世伙伴野外对话、现代地区商店或未来已获得道具",
        "既有4场主线和完成旗标仍保留；新镜头切换不能改变存档格式"
      ]
    },
    "white_night_infiltration": {
      "scope": "ch022",
      "status": "design_not_runtime_bound",
      "beats": [
        "街市可选修灯生活戏，与潜入目标并行",
        "搬琴伪装经过幕后通道，无需与普通居民交战",
        "记录托管人和运输车次，避开公开受害者姓名",
        "决定先匿名公开账册还是先护送证人撤离"
      ]
    },
    "archive_identity_puzzle": {
      "scope": "ch023",
      "status": "design_not_runtime_bound",
      "beats": [
        "按古钟周期观察书架编号变化",
        "核对匿名记忆预算总数与缺失签字",
        "在档案抹名危机中互相确认身份，但不代替他人签字",
        "确认封底维莎为署名线索，仅第58章才是正式队员"
      ]
    },
    "council_hearing": {
      "scope": "ch024",
      "status": "design_not_runtime_bound",
      "beats": [
        "拆分自愿共鸣与强制记忆提取的时间顺序",
        "读取九百年后致歉书及其收件人不确定性",
        "为地区原件保全、匿名咨询及民众听证安排分工",
        "将已核实的海歌港线索带入下一幕，不虚构提前取得失落航页"
      ]
    }
  }
}
