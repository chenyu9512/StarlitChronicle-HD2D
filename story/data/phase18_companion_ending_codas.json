      "dialogue": [
        {
          "id": "coda.p18.shouxian.a.a.l01",
          "speaker": "旁白",
          "text": "七灯指引重新照亮海歌港，但新航路报告旁还保留可手写的风险标注。"
        },
        {
          "id": "coda.p18.shouxian.a.a.l02",
          "speaker": "朔弦",
          "text": "灯会指出远方，却不会替船长替家属偿还当年的账。"
        },
        {
          "id": "coda.p18.shouxian.a.a.l03",
          "speaker": "旁白",
          "text": "公开维护基金不因少数富船捐得多就让他们先被救。"
        }
      ]
    },
