            "type": "chapter_enter",
            "region": "天轨外海·浮空船坞"
          },
          "dialogue": [
            {
              "id": "ch061.opening.l01",
              "speaker": "旁白",
              "text": "【天轨外海·浮空船坞】远方传来的声音打断了众人的脚步。"
            },
            {
              "id": "ch061.opening.l02",
              "speaker": "朔弦",
              "text": "以前以为海那边就是尽头，现在连天空也有航路。"
            },
            {
              "id": "ch061.opening.l03",
              "speaker": "主角",
              "text": "我们先完成眼前的任务：修复星帆并升至浮空岛。"
            },
            {
              "id": "ch061.opening.l04",
              "speaker": "旁白",
              "text": "地图上出现了新的调查标记。"
            }
          ],
          "objectives": [
            {
              "type": "reach",
              "target": "天轨外海·浮空船坞"
