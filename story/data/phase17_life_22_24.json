{
  "schema": "starlit.story.phase17.life_branch_arcs.v1",
  "status": "authored_branch_arcs_not_runtime_bound",
  "batch": "08",
  "quests": [
    {
      "id": "sq_life_22",
      "late_chapter": "ch060",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "两张队伍照片",
            "dialogue": [
              {
                "id": "sq_life_22.p17.a.followup.l01",
                "speaker": "旅店老板",
                "text": "旧照和今天的照片都可以挂，不用挑哪张更像英雄。"
              },
              {
                "id": "sq_life_22.p17.a.followup.l02",
                "speaker": "伊泽",
                "text": "旧照里有人瞪眼，别修得像人人都在笑。"
              },
              {
                "id": "sq_life_22.p17.a.followup.l03",
                "speaker": "诺依",
                "text": "我帮忙调灯光，大家还是自己决定站哪儿。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "驿站合影日",
            "dialogue": [
              {
                "id": "sq_life_22.p17.a.community.l01",
                "speaker": "雷索",
                "text": "这回我站在旁边，别再为了中央位置争半天。"
              },
              {
                "id": "sq_life_22.p17.a.community.l02",
                "speaker": "朔弦",
                "text": "没有到的人先留一把椅子，不用画个假人代替。"
              },
              {
                "id": "sq_life_22.p17.a.community.l03",
                "speaker": "旅店老板",
                "text": "我按原样保存照片，不改掉岁月留下的痕迹。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "后来路过驿站",
            "dialogue": [
              {
                "id": "sq_life_22.p17.a.revisit.l01",
                "speaker": "成年诺依",
                "text": "旧照片旁有人贴了新的旅行路线。"
              },
              {
                "id": "sq_life_22.p17.a.revisit.l02",
                "speaker": "旅店老板",
                "text": "我终于也坐在椅子上拍了一张。"
              },
              {
                "id": "sq_life_22.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "两个时代的照片并排挂着，没有一张宣称冒险已经结束。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "每个人的注释",
            "dialogue": [
              {
                "id": "sq_life_22.p17.b.followup.l01",
                "speaker": "岚音",
                "text": "那天的笑容背后也有疲惫，我想把这个写上。"
              },
              {
                "id": "sq_life_22.p17.b.followup.l02",
                "speaker": "朔弦",
                "text": "我记得吵架的原因和你不同，别替我改成同一版本。"
              },
              {
                "id": "sq_life_22.p17.b.followup.l03",
                "speaker": "伊泽",
                "text": "各写各的，歌里也可以有不同声部。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "照片背后的路线",
            "dialogue": [
              {
                "id": "sq_life_22.p17.b.community.l01",
                "speaker": "雷索",
                "text": "背面写的旅行计划没能完成，不用编成后来都去了。"
              },
              {
                "id": "sq_life_22.p17.b.community.l02",
                "speaker": "旅店老板",
                "text": "每段注释都签上本人名字，不能让一条说明代替大家。"
              },
              {
                "id": "sq_life_22.p17.b.community.l03",
                "speaker": "诺依",
                "text": "我也能写我后来看到的，不抢他们当年的记忆。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "迟来的第三条注释",
            "dialogue": [
              {
                "id": "sq_life_22.p17.b.revisit.l01",
                "speaker": "旅店老板",
                "text": "有人来补写一句，旧注释还保留着。"
              },
              {
                "id": "sq_life_22.p17.b.revisit.l02",
                "speaker": "岚音",
                "text": "大家可以改变看法，不必为当年的愿望感到羞愧。"
              },
              {
                "id": "sq_life_22.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "照片角落多出几种笔迹，驿站仍给新旅客留座。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_23",
      "late_chapter": "ch062",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "第一周轮班",
            "dialogue": [
              {
                "id": "sq_life_23.p17.a.followup.l01",
                "speaker": "工匠",
                "text": "我愿上白班，夜里要陪家人吃饭。"
              },
              {
                "id": "sq_life_23.p17.a.followup.l02",
                "speaker": "诺依",
                "text": "先把危险工种的休息时数写清楚。"
              },
              {
                "id": "sq_life_23.p17.a.followup.l03",
                "speaker": "缇珐",
                "text": "交接设备之前要先停机，不能赶着下班就省步骤。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "回家的工地",
            "dialogue": [
              {
                "id": "sq_life_23.p17.a.community.l01",
                "speaker": "工匠家属",
                "text": "今天他答应天黑前回来，真的回来了。"
              },
              {
                "id": "sq_life_23.p17.a.community.l02",
                "speaker": "工地班长",
                "text": "替班人也有工钱，不靠额外加班填缺口。"
              },
              {
                "id": "sq_life_23.p17.a.community.l03",
                "speaker": "诺依",
                "text": "城市不是靠一个人耗尽自己才建起来。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "工地旁的晚餐",
            "dialogue": [
              {
                "id": "sq_life_23.p17.a.revisit.l01",
                "speaker": "工匠",
                "text": "屋子还没全修完，可我今天能陪孩子吃饭。"
              },
              {
                "id": "sq_life_23.p17.a.revisit.l02",
                "speaker": "工地班长",
                "text": "施工表能调整，不会因此把谁记成懒惰。"
              },
              {
                "id": "sq_life_23.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "建筑群慢慢长高，工地的晚灯按时熄灭。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "社区工期听证",
            "dialogue": [
              {
                "id": "sq_life_23.p17.b.followup.l01",
                "speaker": "居民",
                "text": "学校屋顶比纪念广场更急，能先修吗？"
              },
              {
                "id": "sq_life_23.p17.b.followup.l02",
                "speaker": "工匠",
                "text": "材料有限，先听实际住在这儿的人的需求。"
              },
              {
                "id": "sq_life_23.p17.b.followup.l03",
                "speaker": "诺依",
                "text": "把紧急维修与好看工程分开排序。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "优先修缮投票",
            "dialogue": [
              {
                "id": "sq_life_23.p17.b.community.l01",
                "speaker": "轮椅居民",
                "text": "医院坡道也需要修，不要只听跑得快的人发言。"
              },
              {
                "id": "sq_life_23.p17.b.community.l02",
                "speaker": "缇珐",
                "text": "施工步骤要留安全绕路，别把邻里通道封死。"
              },
              {
                "id": "sq_life_23.p17.b.community.l03",
                "speaker": "工匠",
                "text": "今天改工期，还是照常给已上工的人付工钱。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "新的维修清单",
            "dialogue": [
              {
                "id": "sq_life_23.p17.b.revisit.l01",
                "speaker": "居民",
                "text": "学校和坡道修好了，剩下的工程仍能继续排。"
              },
              {
                "id": "sq_life_23.p17.b.revisit.l02",
                "speaker": "工匠",
                "text": "需求会改变，下季度还能重新提议。"
              },
              {
                "id": "sq_life_23.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "公共修缮牌留下讨论记录，没有工程被称作永恒的第一名。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_24",
      "late_chapter": "ch067",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "三国小食试吃",
            "dialogue": [
              {
                "id": "sq_life_24.p17.a.followup.l01",
                "speaker": "摊主",
                "text": "三种调料分开摆，愿意混着吃的人自己选。"
              },
              {
                "id": "sq_life_24.p17.a.followup.l02",
                "speaker": "异国厨师",
                "text": "我不争第一，只想保留家乡的酸味。"
              },
              {
                "id": "sq_life_24.p17.a.followup.l03",
                "speaker": "孩子",
                "text": "我投票给最喜欢的，不等于其他菜不好吃。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "夜市共用炉灶",
            "dialogue": [
              {
                "id": "sq_life_24.p17.a.community.l01",
                "speaker": "厨师甲",
                "text": "不同食物要错开烹制，免得沾到过敏的食材。"
              },
              {
                "id": "sq_life_24.p17.a.community.l02",
                "speaker": "摊主",
                "text": "每个摊主自己标价，节庆收入按公开费用分摊。"
              },
              {
                "id": "sq_life_24.p17.a.community.l03",
                "speaker": "厨师乙",
                "text": "今天生意好，明天我们还能交换做法。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "来年的新菜单",
            "dialogue": [
              {
                "id": "sq_life_24.p17.a.revisit.l01",
                "speaker": "摊主",
                "text": "菜单多了三国混合汤，也没删旧家乡味。"
              },
              {
                "id": "sq_life_24.p17.a.revisit.l02",
                "speaker": "居民",
                "text": "我喜欢其中两样，不想被要求选唯一最正宗。"
              },
              {
                "id": "sq_life_24.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "广场上飘着几种香气，谁也没把它写成胜负。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "家乡做法记录",
            "dialogue": [
              {
                "id": "sq_life_24.p17.b.followup.l01",
                "speaker": "厨师甲",
                "text": "这勺香料要先烘，不是把它写成同一种糖就行。"
              },
              {
                "id": "sq_life_24.p17.b.followup.l02",
                "speaker": "厨师乙",
                "text": "我愿公开手法，不愿交出祖母私下给我的家庭故事。"
              },
              {
                "id": "sq_life_24.p17.b.followup.l03",
                "speaker": "摊主",
                "text": "食谱注明谁同意公开到哪一步。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "独立小摊协作",
            "dialogue": [
              {
                "id": "sq_life_24.p17.b.community.l01",
                "speaker": "异国厨师",
                "text": "我们保留自己的牌子，也能共用清洁水源。"
              },
              {
                "id": "sq_life_24.p17.b.community.l02",
                "speaker": "摊主",
                "text": "调味区分开，避免让忌口的人吃错。"
              },
              {
                "id": "sq_life_24.p17.b.community.l03",
                "speaker": "孩子",
                "text": "原来不混在一起，也能坐同一桌吃饭。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "新居民的小摊位",
            "dialogue": [
              {
                "id": "sq_life_24.p17.b.revisit.l01",
                "speaker": "新来的厨师",
                "text": "我能带来自己的菜，不必先通过谁的正宗考试吧？"
              },
              {
                "id": "sq_life_24.p17.b.revisit.l02",
                "speaker": "摊主",
                "text": "可以。清洁和食安规则对大家一样。"
              },
              {
                "id": "sq_life_24.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "自由广场留出空摊位，让未来的城市自己添味道。"
              }
            ]
          }
        ]
      }
    }
  ]
}
