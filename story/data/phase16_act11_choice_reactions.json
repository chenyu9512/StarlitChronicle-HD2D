    {
      "id": "ch062.p16.choice.hear",
      "chapter_id": "ch062",
      "after_choice_id": "ch062.choice",
      "choice_option_id": "hear",
      "condition": {
        "ch062.approach": "publish_report",
        "world.ch062.approach": "publish_report"
      },
      "insertion": "after_choice_commit_before_encounter_or_resolve",
      "optional": true,
      "independent_route": false,
      "once_only": true,
      "dialogue": [
        {
          "id": "ch062.p16.choice.hear.l01",
          "speaker": "维莎",
          "text": "报告可以公开，私人病历须经过本人或合适代理人同意。"
        },
        {
          "id": "ch062.p16.choice.hear.l02",
          "speaker": "诺依",
          "text": "把发现的不确定处一并写上，不要伪称全部弄清。"
        },
        {
          "id": "ch062.p16.choice.hear.l03",
          "speaker": "玄璃",
          "text": "历史上的真实救助与后来的剥夺都应被看见。"
        }
      ]
    },
    {
      "id": "ch062.p16.choice.protect",
      "chapter_id": "ch062",
      "after_choice_id": "ch062.choice",
      "choice_option_id": "protect",
      "condition": {
        "ch062.approach": "protect_records",
        "world.ch062.approach": "protect_records"
      },
      "insertion": "after_choice_commit_before_encounter_or_resolve",
      "optional": true,
      "independent_route": false,
      "once_only": true,
      "dialogue": [
        {
          "id": "ch062.p16.choice.protect.l01",
          "speaker": "岚音",
          "text": "优先保护受害者原始记录，再终止强制继续的命令。"
        },
        {
          "id": "ch062.p16.choice.protect.l02",
          "speaker": "缇珐",
          "text": "停止自动实验不等于关闭还能救人的医疗装置。"
        },
        {
          "id": "ch062.p16.choice.protect.l03",
          "speaker": "主角",
          "text": "留好可审核的停机过程，让后人检查我们有没有遗漏。"
        }
      ]
    },
    {
      "id": "ch063.p16.choice.hear",
      "chapter_id": "ch063",
      "after_choice_id": "ch063.choice",
      "choice_option_id": "hear",
      "condition": {
        "ch063.approach": "keep_blank",
        "world.ch063.approach": "keep_blank"
      },
      "insertion": "after_choice_commit_before_encounter_or_resolve",
      "optional": true,
      "independent_route": false,
      "once_only": true,
      "dialogue": [
        {
          "id": "ch063.p16.choice.hear.l01",
          "speaker": "主角",
          "text": "我愿将澄舟研究的事实留下，但自己的明天不交给系统。"
        },
        {
          "id": "ch063.p16.choice.hear.l02",
          "speaker": "岚音",
          "text": "这些年我也做过替你决定的事，愿意继续回答。"
        },
        {
          "id": "ch063.p16.choice.hear.l03",
          "speaker": "维莎",
          "text": "档案上的未来一栏将保留空白，不被写作数据故障。"
        }
      ]
    },
    {
      "id": "ch063.p16.choice.protect",
      "chapter_id": "ch063",
      "after_choice_id": "ch063.choice",
      "choice_option_id": "protect",
      "condition": {
        "ch063.approach": "preserve_history",
        "world.ch063.approach": "preserve_history"
      },
      "insertion": "after_choice_commit_before_encounter_or_resolve",
      "optional": true,
      "independent_route": false,
      "once_only": true,
      "dialogue": [
        {
          "id": "ch063.p16.choice.protect.l01",
          "speaker": "诺依",
          "text": "先整理他曾经做过的事，不编造他没留下的遗言。"
        },
        {
          "id": "ch063.p16.choice.protect.l02",
          "speaker": "玄璃",
          "text": "知晓历史并不要求按它指定的方向生活。"
        },
        {
          "id": "ch063.p16.choice.protect.l03",
          "speaker": "主角",
          "text": "等我愿意的时候，再决定怎样向晨露村的人讲述。"
        }
      ]
    },
    {
      "id": "ch064.p16.choice.hear",
