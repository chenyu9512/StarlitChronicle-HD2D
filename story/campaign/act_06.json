            "enemy_id": "boss.ch031",
            "display_name": "笑颜面偶",
            "win_flag": "ch031.battle_won",
            "recommended_level": 40
          }
        },
        {
          "id": "ch031.resolve",
          "title": "事件落幕",
          "trigger": {
            "type": "scene_after",
            "requires_flags": [
              "ch031.battle_won"
            ]
          },
          "dialogue": [
            {
              "id": "ch031.resolve.l01",
              "speaker": "旁白",
              "text": "风声渐弱，人们终于有机会面对自己刚才不愿承认的事。"
            },
            {
              "id": "ch031.resolve.l02",
              "speaker": "玄璃",
              "text": "主角决定调查幻境源头，而不是强行叫醒所有人。"
            },
            {
              "id": "ch031.resolve.l03",
              "speaker": "主角",
              "text": "总有些事，不能只写成一行冒险记录。"
            },
            {
              "id": "ch031.resolve.l04",
              "speaker": "旁白",
              "text": "【任务完成】永远晴朗的街道。新的道路正在展开。"
            }
