{
  "schema": "starlit.story.phase17.life_branch_arcs.v1",
  "status": "authored_branch_arcs_not_runtime_bound",
  "batch": "05",
  "quests": [
    {
      "id": "sq_life_13",
      "late_chapter": "ch038",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "船舱花盆支架",
            "dialogue": [
              {
                "id": "sq_life_13.p17.a.followup.l01",
                "speaker": "水手",
                "text": "我想把家带上船，可花盆滚来滚去。"
              },
              {
                "id": "sq_life_13.p17.a.followup.l02",
                "speaker": "朔弦",
                "text": "支架装在低处，不挡逃生道。"
              },
              {
                "id": "sq_life_13.p17.a.followup.l03",
                "speaker": "缇珐",
                "text": "集雨盒加溢流孔，风暴天不会灌进舱里。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "雨水收集日",
            "dialogue": [
              {
                "id": "sq_life_13.p17.a.community.l01",
                "speaker": "水手",
                "text": "雨少时盆栽叶子垂了，我测量了储水量。"
              },
              {
                "id": "sq_life_13.p17.a.community.l02",
                "speaker": "朔弦",
                "text": "船上饮水先给人，花用回收的非饮用雨水。"
              },
              {
                "id": "sq_life_13.p17.a.community.l03",
                "speaker": "缇珐",
                "text": "污水别倒回盆里，会把根泡坏。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "航海中的新芽",
            "dialogue": [
              {
                "id": "sq_life_13.p17.a.revisit.l01",
                "speaker": "水手",
                "text": "新叶长出来了，我终于不总担心它离不开岸。"
              },
              {
                "id": "sq_life_13.p17.a.revisit.l02",
                "speaker": "朔弦",
                "text": "花盆底下留着紧固检查日期。"
              },
              {
                "id": "sq_life_13.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "逐星号颠簸时，一点绿色稳稳待在船舱。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "三班浇水",
            "dialogue": [
              {
                "id": "sq_life_13.p17.b.followup.l01",
                "speaker": "水手",
                "text": "我负责早班，但靠岸时想去见家人。"
              },
              {
                "id": "sq_life_13.p17.b.followup.l02",
                "speaker": "船员",
                "text": "我接你的班，照护表上写了换班人。"
              },
              {
                "id": "sq_life_13.p17.b.followup.l03",
                "speaker": "朔弦",
                "text": "先问谁愿意，别把爱花变成强制轮值。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "识别根部病害",
            "dialogue": [
              {
                "id": "sq_life_13.p17.b.community.l01",
                "speaker": "年轻船员",
                "text": "我浇太多水了，泥闻起来不对。"
              },
              {
                "id": "sq_life_13.p17.b.community.l02",
                "speaker": "水手",
                "text": "先让土透气，再按记录调整。"
              },
              {
                "id": "sq_life_13.p17.b.community.l03",
                "speaker": "岚音",
                "text": "并不是每个人都懂养花，写清简单注意事项。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "船员共同的小花园",
            "dialogue": [
              {
                "id": "sq_life_13.p17.b.revisit.l01",
                "speaker": "船员",
                "text": "值班表换过几次，盆栽依然在。"
              },
              {
                "id": "sq_life_13.p17.b.revisit.l02",
                "speaker": "水手",
                "text": "原来家可以有人一起照料，不必只靠我守着。"
              },
              {
                "id": "sq_life_13.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "逐星号的乘员换了几拨，花盆还留在安全角落。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_14",
      "late_chapter": "ch042",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "公益灯塔账",
            "dialogue": [
              {
                "id": "sq_life_14.p17.a.followup.l01",
                "speaker": "守塔妇人",
                "text": "燃料和玻璃维修都要钱，但求救不能收费。"
              },
              {
                "id": "sq_life_14.p17.a.followup.l02",
                "speaker": "船主",
                "text": "我愿按能力出资，不能把捐款变成优先救援权。"
              },
              {
                "id": "sq_life_14.p17.a.followup.l03",
                "speaker": "朔弦",
                "text": "基金账让居民查看，出海的人才能信这盏灯。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "风暴后的账单",
            "dialogue": [
              {
                "id": "sq_life_14.p17.a.community.l01",
                "speaker": "修灯工",
                "text": "暴雨打坏一块镜片，预算先用在它上面。"
              },
              {
                "id": "sq_life_14.p17.a.community.l02",
                "speaker": "守塔妇人",
                "text": "损坏报告要公开，别说捐款全都花得完美。"
              },
              {
                "id": "sq_life_14.p17.a.community.l03",
                "speaker": "渔夫",
                "text": "救援信号亮着，谁交不起钱都能求助。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "又一个迷航夜",
            "dialogue": [
              {
                "id": "sq_life_14.p17.a.revisit.l01",
                "speaker": "小船船长",
                "text": "那晚灯塔救了我，我只捐得起一小瓶灯油。"
              },
              {
                "id": "sq_life_14.p17.a.revisit.l02",
                "speaker": "守塔妇人",
                "text": "多少都可以，没有人要你以救命付费。"
              },
              {
                "id": "sq_life_14.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "公益账逐年更新，灯仍向所有船亮着。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "船队轮流守塔",
            "dialogue": [
              {
                "id": "sq_life_14.p17.b.followup.l01",
                "speaker": "船长",
                "text": "这周我守塔，但下周要出远海。"
              },
              {
                "id": "sq_life_14.p17.b.followup.l02",
                "speaker": "守塔妇人",
                "text": "名单写清交接人和专业维护者。"
              },
              {
                "id": "sq_life_14.p17.b.followup.l03",
                "speaker": "朔弦",
                "text": "不懂电路的人只负责观察和求救，别冒险维修。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "值守交接训练",
            "dialogue": [
              {
                "id": "sq_life_14.p17.b.community.l01",
                "speaker": "渔夫",
                "text": "雾里先检查响号，再确认灯罩是否转动。"
              },
              {
                "id": "sq_life_14.p17.b.community.l02",
                "speaker": "守塔妇人",
                "text": "遇到真正求救要先发讯号，不必等全体船主开会。"
              },
              {
                "id": "sq_life_14.p17.b.community.l03",
                "speaker": "船长",
                "text": "轮值不表示每个人都该冒着风暴爬塔。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "灯塔的第二班人",
            "dialogue": [
              {
                "id": "sq_life_14.p17.b.revisit.l01",
                "speaker": "年轻船员",
                "text": "我学会读灯志，但还没有资格拆修主灯。"
              },
              {
                "id": "sq_life_14.p17.b.revisit.l02",
                "speaker": "守塔妇人",
                "text": "愿意轮班的人有休息权，也要留下替班电话。"
              },
              {
                "id": "sq_life_14.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "老灯塔不再只有一个守塔人，遇险者仍免费靠岸。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_15",
      "late_chapter": "ch043",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "海兽回应声音",
            "dialogue": [
              {
                "id": "sq_life_15.p17.a.followup.l01",
                "speaker": "少年",
                "text": "我叫它小蓝，它没有来，只在远处转了个圈。"
              },
              {
                "id": "sq_life_15.p17.a.followup.l02",
                "speaker": "朔弦",
                "text": "名字是我们交流用的，不是给它下达的命令。"
              },
              {
                "id": "sq_life_15.p17.a.followup.l03",
                "speaker": "岚音",
                "text": "别用食物逼它靠近船边。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "声音辨识观察",
            "dialogue": [
              {
                "id": "sq_life_15.p17.a.community.l01",
                "speaker": "少年",
                "text": "它会避开尖锐的钟声，低声唱歌时才慢慢浮上来。"
              },
              {
                "id": "sq_life_15.p17.a.community.l02",
                "speaker": "海洋观察员",
                "text": "水下距离不明，别为了拍近处而追它。"
              },
              {
                "id": "sq_life_15.p17.a.community.l03",
                "speaker": "朔弦",
                "text": "把观察记下来，不能把一次靠近当驯服成功。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "再次经过鲸背水道",
            "dialogue": [
              {
                "id": "sq_life_15.p17.a.revisit.l01",
                "speaker": "少年",
                "text": "小蓝还在自由游，我远远叫它就很满足。"
              },
              {
                "id": "sq_life_15.p17.a.revisit.l02",
                "speaker": "观察员",
                "text": "航道标出避让范围，它不必接受人类名字。"
              },
              {
                "id": "sq_life_15.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "船只轻轻放慢速度，水面没有竖起捕获用的网。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "避让通航线",
            "dialogue": [
              {
                "id": "sq_life_15.p17.b.followup.l01",
                "speaker": "舵手",
                "text": "鲸背水道的深槽是海兽经过的路。"
              },
              {
                "id": "sq_life_15.p17.b.followup.l02",
                "speaker": "朔弦",
                "text": "标两条绕行线，不能堵住它回巢的方向。"
              },
              {
                "id": "sq_life_15.p17.b.followup.l03",
                "speaker": "少年",
                "text": "不一定见到它，也能让它好好生活。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "安静航行练习",
            "dialogue": [
              {
                "id": "sq_life_15.p17.b.community.l01",
                "speaker": "船员",
                "text": "经过这里先减速，不鸣长号。"
              },
              {
                "id": "sq_life_15.p17.b.community.l02",
                "speaker": "观察员",
                "text": "发现幼兽就加大距离，不能拿它们当观光项目。"
              },
              {
                "id": "sq_life_15.p17.b.community.l03",
                "speaker": "少年",
                "text": "我可以画警示牌，让游客知道为什么要安静。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "水道新的航行守则",
            "dialogue": [
              {
                "id": "sq_life_15.p17.b.revisit.l01",
                "speaker": "舵手",
                "text": "按避让线走，船仍能按时到港。"
              },
              {
                "id": "sq_life_15.p17.b.revisit.l02",
                "speaker": "少年",
                "text": "没给它取正式名字也没关系，我记得它救过我。"
              },
              {
                "id": "sq_life_15.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "鲸背水道变成了可以共用、却不属于人类的路线。"
              }
            ]
          }
        ]
      }
    }
  ]
}
