          "dialogue": [
            {
              "id": "ch061.resolve.l01",
              "speaker": "旁白",
              "text": "风暴暂时平息，有些问题却仍在等待回答。"
            },
            {
              "id": "ch061.resolve.l02",
              "speaker": "朔弦",
              "text": "众人建立往返补给站，星帆船驶入云海。"
            },
            {
              "id": "ch061.resolve.l03",
              "speaker": "主角",
              "text": "把这段经历记下来。不要让它再被抹去。"
            },
            {
              "id": "ch061.resolve.l04",
              "speaker": "旁白",
              "text": "【任务完成】驶向群星的船。"
            }
          ],
          "objectives": [
            {
              "type": "finish_chapter",
              "target": "ch061"
