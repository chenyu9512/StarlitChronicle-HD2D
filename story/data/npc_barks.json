{
  "schema": "starlit.story.npc_barks.v1",
  "lines": [
    {
      "id": "npc_bark_001",
      "speaker": "城门卫兵",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch008.started"
      ],
      "text": "今天过关要检查三次，连我们自己都烦了。"
    },
    {
      "id": "npc_bark_002",
      "speaker": "粮贩",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch012.done"
      ],
      "text": "三国又有商队来了，希望这条路别再关上。"
    },
    {
      "id": "npc_bark_003",
      "speaker": "矿工",
      "location": "赤炉联邦",
      "requires_flags": [
        "story.ch016.started"
      ],
      "text": "我从工厂回来，儿子竟然不认识我了。"
    },
    {
      "id": "npc_bark_004",
      "speaker": "矿工家属",
      "location": "赤炉联邦",
      "requires_flags": [
        "story.ch018.done"
      ],
      "text": "工资还没补足，不过总算有人肯承认我们存在。"
    },
    {
      "id": "npc_bark_005",
      "speaker": "海港船工",
      "location": "海歌港",
      "requires_flags": [
        "story.ch025.started"
      ],
      "text": "这船漏得能养鱼，可修起来会是一艘好船。"
    },
    {
      "id": "npc_bark_006",
      "speaker": "海岛邮差",
      "location": "海歌群岛",
      "requires_flags": [
        "story.ch026.done"
      ],
      "text": "信终于有地方寄了，有些答案不急着到。"
    },
    {
      "id": "npc_bark_007",
      "speaker": "年轻画师",
      "location": "镜眠王都",
      "requires_flags": [
        "story.ch031.started"
      ],
      "text": "我每天都画同一朵花，怎么画也觉得差一点。"
    },
    {
      "id": "npc_bark_008",
      "speaker": "护士",
      "location": "镜眠王都",
      "requires_flags": [
        "story.ch035.done"
      ],
      "text": "醒来的人会哭，也会笑。至少都是自己的心情。"
    },
    {
      "id": "npc_bark_009",
      "speaker": "旧洲商人",
      "location": "旧洲",
      "requires_flags": [
        "story.ch042.done"
      ],
      "text": "我们能重新标上家乡的地名了。"
    },
    {
      "id": "npc_bark_010",
      "speaker": "老人",
      "location": "晨露村",
      "requires_flags": [
        "world.black_star"
      ],
      "text": "灯塔还站着，可我已经忘了它以前是什么颜色。"
    },
    {
      "id": "npc_bark_011",
      "speaker": "修桥工",
      "location": "灾后王都",
      "requires_flags": [
        "story.ch050.done"
      ],
      "text": "旧桥断了好多年，我们正在把路接起来。"
    },
    {
      "id": "npc_bark_012",
      "speaker": "旅店老板",
      "location": "群灯之城",
      "requires_flags": [
        "story.ch057.done"
      ],
      "text": "今天又多了一户人搬进来，厨房得多备两份菜。"
    },
    {
      "id": "npc_bark_013",
      "speaker": "卫兵",
      "location": "群灯之城",
      "requires_flags": [
        "story.ch060.done"
      ],
      "text": "我不替灯王守门，我给愿意回家的居民指路。"
    },
    {
      "id": "npc_bark_014",
      "speaker": "学者",
      "location": "天轨圣域",
      "requires_flags": [
        "story.ch062.done"
      ],
      "text": "原来所谓“万无一失”，从第一天起就是自欺欺人。"
    },
    {
      "id": "npc_bark_015",
      "speaker": "孩子",
      "location": "晨露村",
      "requires_flags": [
        "story.ch072.done"
      ],
      "text": "今天海面上的星星好亮。我想长大后也去旅行。"
    },
    {
      "id": "npc_bark_016",
      "speaker": "三国门卫",
      "location": "三誓王都·外廷",
      "requires_flags": [
        "story.ch007.started"
      ],
      "text": "我也只拿一份薪水，却被要求替三个国家查通行证。"
    },
    {
      "id": "npc_bark_017",
      "speaker": "医师",
      "location": "三誓王都·后巷",
      "requires_flags": [
        "story.ch007.done"
      ],
      "text": "这几天多了些病人，至少这次我们知道他们叫什么。"
    },
    {
      "id": "npc_bark_018",
      "speaker": "难民孩子",
      "location": "三誓王都·后巷",
      "requires_flags": [
        "story.ch007.done"
      ],
      "text": "药师姐姐说我的名字可以写在真正的病历上。"
    },
    {
      "id": "npc_bark_019",
      "speaker": "车夫",
      "location": "灰鹰商道",
      "requires_flags": [
        "story.ch008.started"
      ],
      "text": "我的驴比这三国官员还明白什么时候该让路。"
    },
    {
      "id": "npc_bark_020",
      "speaker": "桥头守卫",
      "location": "灰鹰商道",
      "requires_flags": [
        "story.ch008.done"
      ],
      "text": "两边的人终于能一起在桥上修木板了。"
    },
    {
      "id": "npc_bark_021",
      "speaker": "面包师",
      "location": "灰鹰商道",
      "requires_flags": [
        "story.ch008.done"
      ],
      "text": "一袋面粉从两国经过，吃起来也没变味。"
    },
    {
      "id": "npc_bark_022",
      "speaker": "审判厅书记",
      "location": "三誓王都·审判厅",
      "requires_flags": [
        "story.ch009.started"
      ],
      "text": "今日旁听者太多，请不要把剑带上台阶。"
    },
    {
      "id": "npc_bark_023",
      "speaker": "幸存老妇",
      "location": "三誓王都·审判厅",
      "requires_flags": [
        "story.ch009.done"
      ],
      "text": "他们说今天我很勇敢，其实我只是终于能把话说完。"
    },
    {
      "id": "npc_bark_024",
      "speaker": "旧骑士团学徒",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch009.done"
      ],
      "text": "雷索拒绝复职，我却更愿意向他学怎么举盾。"
    },
    {
      "id": "npc_bark_025",
      "speaker": "粮仓管理员",
      "location": "边境议事站",
      "requires_flags": [
        "story.ch010.started"
      ],
      "text": "这把钥匙是南国的，那把是北国的，都开不了我家的门。"
    },
    {
      "id": "npc_bark_026",
      "speaker": "使者助手",
      "location": "边境议事站",
      "requires_flags": [
        "story.ch010.done"
      ],
      "text": "以前各写各的报告，现在终于有人肯把纸放到一起。"
    },
    {
      "id": "npc_bark_027",
      "speaker": "搬粮士兵",
      "location": "边境议事站",
      "requires_flags": [
        "story.ch010.done"
      ],
      "text": "昨天还盯着对方的剑，今天一起抬车，腰都要断了。"
    },
    {
      "id": "npc_bark_028",
      "speaker": "工兵",
      "location": "旧盟约桥",
      "requires_flags": [
        "story.ch011.started"
      ],
      "text": "桥底的引线不是我装的。但我知道它连着什么。"
    },
    {
      "id": "npc_bark_029",
      "speaker": "使节随员",
      "location": "旧盟约桥",
      "requires_flags": [
        "story.ch011.done"
      ],
      "text": "终于不用在黑石和白石的交界处停下来行礼了。"
    },
    {
      "id": "npc_bark_030",
      "speaker": "小贩",
      "location": "旧盟约桥",
      "requires_flags": [
        "story.ch011.done"
      ],
      "text": "这桥恢复通行，我的热汤才卖得出去。"
    },
    {
      "id": "npc_bark_031",
      "speaker": "果农",
      "location": "律序灯坛",
      "requires_flags": [
        "story.ch012.done"
      ],
      "text": "果树不认王印，它只知道我每年都来浇水。"
    },
    {
      "id": "npc_bark_032",
      "speaker": "议事书记",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch012.done"
      ],
      "text": "上个月的军令和粮食记录都贴在广场，谁都能去看。"
    },
    {
      "id": "npc_bark_033",
      "speaker": "三国商人",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch012.done"
      ],
      "text": "三种钱币还是不好算，但比三道封锁好多了。"
    },
    {
      "id": "npc_bark_034",
      "speaker": "七号矿工",
      "location": "赤炉七号矿坑",
      "requires_flags": [
        "story.ch013.started"
      ],
      "text": "别问我昨天挖了多少矿，我昨天根本没下井。"
    },
    {
      "id": "npc_bark_035",
      "speaker": "矿工家属",
      "location": "赤炉七号矿坑",
      "requires_flags": [
        "story.ch013.done"
      ],
      "text": "他回来了。忘记我的名字没关系，我们可以再认识。"
    },
    {
      "id": "npc_bark_036",
      "speaker": "电工",
      "location": "赤炉总署",
      "requires_flags": [
        "story.ch013.done"
      ],
      "text": "有些电路接得太密了，像有人怕你看见它通向哪里。"
    },
    {
      "id": "npc_bark_037",
      "speaker": "工坊学徒",
      "location": "缇珐工坊",
      "requires_flags": [
        "story.ch014.started"
      ],
      "text": "师傅不是不睡觉，她只是永远认为再修一下就能好了。"
    },
    {
      "id": "npc_bark_038",
      "speaker": "矿工孩子",
      "location": "缇珐工坊",
      "requires_flags": [
        "story.ch014.done"
      ],
      "text": "我把蓝围巾带回家了。爸爸还记不得，但他会摸摸它。"
    },
    {
      "id": "npc_bark_039",
      "speaker": "旧机保管员",
      "location": "缇珐工坊",
      "requires_flags": [
        "story.ch014.done"
      ],
      "text": "以前机器开着我害怕，现在关了我反而想起那段声音。"
    },
    {
      "id": "npc_bark_040",
      "speaker": "百工塔学徒",
      "location": "赤炉百工塔",
      "requires_flags": [
        "story.ch015.started"
      ],
      "text": "我家没钱签终身合同，就只能在塔外看别人练习。"
    },
    {
      "id": "npc_bark_041",
      "speaker": "护盾考官",
      "location": "赤炉百工塔",
      "requires_flags": [
        "story.ch015.done"
      ],
      "text": "最好的守卫不只会举盾，还会知道什么时候让别人先走。"
    },
    {
      "id": "npc_bark_042",
      "speaker": "学徒父亲",
      "location": "赤炉百工塔",
      "requires_flags": [
        "story.ch015.done"
      ],
      "text": "第一次看儿子拿着自己画的图纸回家。"
    },
    {
      "id": "npc_bark_043",
      "speaker": "灰砂老妇",
      "location": "赤炉安置区",
      "requires_flags": [
        "story.ch016.started"
      ],
      "text": "我把老伴名字绣进袖子。每天都要摸一摸。"
    },
    {
      "id": "npc_bark_044",
      "speaker": "档案员",
      "location": "赤炉安置区",
      "requires_flags": [
        "story.ch016.done"
      ],
      "text": "今天终于可以不用独自证明昨天写过的字了。"
    },
    {
      "id": "npc_bark_045",
      "speaker": "街头居民",
      "location": "赤炉安置区",
      "requires_flags": [
        "story.ch016.done"
      ],
      "text": "热水没停，名册也没烧。看来不是非得选一样失去。"
    },
    {
      "id": "npc_bark_046",
      "speaker": "医院医师",
      "location": "赤炉主炉",
      "requires_flags": [
        "story.ch017.started"
      ],
      "text": "我们有很多伤员，可不能靠一门大炮替他们供氧。"
    },
    {
      "id": "npc_bark_047",
      "speaker": "备用电工",
      "location": "赤炉主炉",
      "requires_flags": [
        "story.ch017.done"
      ],
      "text": "那夜三分钟像三小时。再不能让医院和炮口接在同一条线上。"
    },
    {
      "id": "npc_bark_048",
      "speaker": "小孩",
      "location": "赤炉主炉",
      "requires_flags": [
        "story.ch017.done"
      ],
      "text": "那台大机器不再朝我们转头了。"
    },
    {
      "id": "npc_bark_049",
      "speaker": "熔炉工人",
      "location": "赤炉联邦",
      "requires_flags": [
        "story.ch018.started"
      ],
      "text": "说实话我们害怕停工，但也不想拿同事的过去换工资。"
    },
    {
      "id": "npc_bark_050",
      "speaker": "小摊主",
      "location": "赤炉联邦",
      "requires_flags": [
        "story.ch018.done"
      ],
      "text": "电灯不像以前那么亮，可我知道是谁把它点亮的。"
    },
    {
      "id": "npc_bark_051",
      "speaker": "学徒",
      "location": "赤炉联邦",
      "requires_flags": [
        "story.ch018.done"
      ],
      "text": "师傅说图纸可以改，我第一次敢问她为什么。"
    },
    {
      "id": "npc_bark_052",
      "speaker": "灰石村民",
      "location": "十年前·灰石边村",
      "requires_flags": [
        "story.ch019.started"
      ],
      "text": "那天我们只在屋顶放了求救烟，怎么就变成叛军？"
    },
    {
      "id": "npc_bark_053",
      "speaker": "村民后代",
      "location": "三誓边村",
      "requires_flags": [
        "story.ch019.done"
      ],
      "text": "祖父留下雷索的故事，不是叫人去崇拜英雄，是叫我们别随便点火。"
    },
    {
      "id": "npc_bark_054",
      "speaker": "旧军士",
      "location": "三誓边村",
      "requires_flags": [
        "story.ch019.done"
      ],
      "text": "我那天签了字。即使没人夸我，我也不想再说谎。"
    },
    {
      "id": "npc_bark_055",
      "speaker": "老船员",
      "location": "无名海",
      "requires_flags": [
        "story.ch020.started"
      ],
      "text": "海图边缘那块白色，像有人把家乡生生刮掉了。"
    },
    {
      "id": "npc_bark_056",
      "speaker": "渔童",
      "location": "旧航路港",
      "requires_flags": [
        "story.ch020.done"
      ],
      "text": "我也想见见朔弦说的那棵歪树。"
    },
    {
      "id": "npc_bark_057",
      "speaker": "海港贩子",
      "location": "旧航路港",
      "requires_flags": [
        "story.ch020.done"
      ],
      "text": "有人拿再多钱，也买不走你记得的味道。"
    },
    {
      "id": "npc_bark_058",
      "speaker": "药房邻居",
      "location": "晨露村",
      "requires_flags": [
        "story.ch021.started"
      ],
      "text": "那几天药房的人都头疼，只有两个孩子还说得出那个名字。"
    },
    {
      "id": "npc_bark_059",
      "speaker": "守灯人",
      "location": "晨露村",
      "requires_flags": [
        "story.ch021.done"
      ],
      "text": "岚音藏了那么久的病历，终于可以不再由她一个人承担。"
    },
    {
      "id": "npc_bark_060",
      "speaker": "小药师",
      "location": "晨露村",
      "requires_flags": [
        "story.ch021.done"
      ],
      "text": "如果有病人不肯说话，我会先陪他坐着。"
    },
    {
      "id": "npc_bark_061",
      "speaker": "灯笼商",
      "location": "王都白夜祭",
      "requires_flags": [
        "story.ch022.started"
      ],
      "text": "今年灯笼卖得不错，可王宫忽然多了好几队陌生守卫。"
    },
    {
      "id": "npc_bark_062",
      "speaker": "宫廷乐师",
      "location": "王都白夜祭",
      "requires_flags": [
        "story.ch022.done"
      ],
      "text": "有些歌能唱出来，有些人声必须先问主人能不能放给别人听。"
    },
    {
      "id": "npc_bark_063",
      "speaker": "庆典孩子",
      "location": "王都白夜祭",
      "requires_flags": [
        "story.ch022.done"
      ],
      "text": "明年白夜祭我想自己做一盏不卖的灯。"
    },
    {
      "id": "npc_bark_064",
      "speaker": "档案抄写员",
      "location": "王城档案室",
      "requires_flags": [
        "story.ch023.started"
      ],
      "text": "这架书柜又换了位置，明明昨天我还给它做过记号。"
    },
    {
      "id": "npc_bark_065",
      "speaker": "档案抄写员",
      "location": "王城档案室",
      "requires_flags": [
        "story.ch023.done"
      ],
      "text": "现在进门先登记姓名，不再有人把档案上的人当成数字。"
    },
    {
      "id": "npc_bark_066",
      "speaker": "古文研究者",
      "location": "王城档案室",
      "requires_flags": [
        "story.ch023.done"
      ],
      "text": "“自愿”旁边少了签名，居然这么多年都没人问过。"
    },
    {
      "id": "npc_bark_067",
      "speaker": "断层祭司",
      "location": "断层议会遗迹",
      "requires_flags": [
        "story.ch024.started"
      ],
      "text": "人们都说七灯是奇迹，可奇迹是给谁看的？"
    },
    {
      "id": "npc_bark_068",
      "speaker": "平民见证者",
      "location": "断层议会遗迹",
      "requires_flags": [
        "story.ch024.done"
      ],
      "text": "我们可以为当年的救人感激，也可以为当年的伤害生气。"
    },
    {
      "id": "npc_bark_069",
      "speaker": "档案守夜人",
      "location": "断层议会遗迹",
      "requires_flags": [
        "story.ch024.done"
      ],
      "text": "今天有人来献花，也有人骂了整晚。我会替他们把门留着。"
    },
    {
      "id": "npc_bark_070",
      "speaker": "老船工",
      "location": "海歌港",
      "requires_flags": [
        "story.ch025.done"
      ],
      "text": "这艘破船总算重新下水了。要是漏了水，记得先回来找我，别跟海赌气。"
    },
    {
      "id": "npc_bark_071",
      "speaker": "晴汐邮差",
      "location": "晴汐小岛",
      "requires_flags": [
        "story.ch026.done"
      ],
      "text": "三封信都送到了。有些人没能回来，信也仍然值得寄。"
    },
    {
      "id": "npc_bark_072",
      "speaker": "沉城研究员",
      "location": "青蓝海沟",
      "requires_flags": [
        "story.ch027.done"
      ],
      "text": "海底的钟只响了一次，但有人终于把整座城的姓名抄全了。"
    },
    {
      "id": "npc_bark_073",
      "speaker": "断歌礁渔人",
      "location": "断歌礁",
      "requires_flags": [
        "story.ch028.done"
      ],
      "text": "那首歌现在不再把人吓得睡不着。听说有人正给它写新的歌词。"
    },
    {
      "id": "npc_bark_074",
      "speaker": "获救船长",
      "location": "静浪禁航区",
      "requires_flags": [
        "story.ch029.done"
      ],
      "text": "我们把航标重新校准了。下一艘船不用再付钱才能找到出口。"
    },
    {
      "id": "npc_bark_075",
      "speaker": "群岛船主",
      "location": "风航群岛",
      "requires_flags": [
        "story.ch030.done"
      ],
      "text": "风航灯亮了。可每天轮值守望的人还是得按时来。"
    },
    {
      "id": "npc_bark_076",
      "speaker": "卖花少女",
      "location": "镜眠王都",
      "requires_flags": [
        "story.ch031.done"
      ],
      "text": "花瓣落在了地上。我才发现花谢了也挺好看。"
    },
    {
      "id": "npc_bark_077",
      "speaker": "镜宫孩子",
      "location": "镜眠王都",
      "requires_flags": [
        "story.ch032.done"
      ],
      "text": "我给护理师画了那块餐巾。我现在会画一个新花样了。"
    },
    {
      "id": "npc_bark_078",
      "speaker": "梦庭守卫",
      "location": "七重梦庭",
      "requires_flags": [
        "story.ch033.done"
      ],
      "text": "有人走出门时仍然犹豫，但没人在门口替他们写答案。"
    },
    {
      "id": "npc_bark_079",
      "speaker": "剧场管理员",
      "location": "无名剧场",
      "requires_flags": [
        "story.ch034.done"
      ],
      "text": "舞台上多了一个真正的名字，不再只有素材编号。"
    },
    {
      "id": "npc_bark_080",
      "speaker": "疗养院医师",
      "location": "镜眠王都",
      "requires_flags": [
        "story.ch035.done"
      ],
      "text": "醒来的人不必马上高兴。我们先问他今天想吃什么。"
    },
    {
      "id": "npc_bark_081",
      "speaker": "钟匠",
      "location": "镜眠王都",
      "requires_flags": [
        "story.ch036.done"
      ],
      "text": "明天也可能下雨。我在修一把真正能测时间的钟。"
    },
    {
      "id": "npc_bark_082",
      "speaker": "归乡岛民",
      "location": "旧洲外海",
      "requires_flags": [
        "story.ch037.done"
      ],
      "text": "码头旁的歪树还在。许多老地方都变了，可这还是我们的家。"
    },
    {
      "id": "npc_bark_083",
      "speaker": "默契城书记",
      "location": "默契城",
      "requires_flags": [
        "story.ch038.done"
      ],
      "text": "新户籍表允许把“不知道”写进去，我终于能坦白自己不知道了。"
    },
    {
      "id": "npc_bark_084",
      "speaker": "裂谷救援员",
      "location": "旧洲裂谷村",
      "requires_flags": [
        "story.ch039.done"
      ],
      "text": "诺依跟着你们走了。希望他还会写信告诉我们旅程里的事。"
    },
    {
      "id": "npc_bark_085",
      "speaker": "回廊记录员",
      "location": "岁影回廊",
      "requires_flags": [
        "story.ch040.done"
      ],
      "text": "那两份证词还在互相矛盾。有人不喜欢，可终于没人再偷偷烧掉它们。"
    },
    {
      "id": "npc_bark_086",
      "speaker": "地脉工匠",
      "location": "旧洲树海",
      "requires_flags": [
        "story.ch041.done"
      ],
      "text": "根系图纸有一半空白。好在现在谁有新办法都能往上添。"
    },
    {
      "id": "npc_bark_087",
      "speaker": "旧洲长者",
      "location": "根忆灯坛",
      "requires_flags": [
        "story.ch042.done"
      ],
      "text": "我女儿的名字回来了。我不求全世界夸她，只求知道她曾经活过。"
    },
    {
      "id": "npc_bark_088",
      "speaker": "星务署文员",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch043.done"
      ],
      "text": "输能图贴上公开栏之后，我们这些小职员也终于敢问能量去哪了。"
    },
    {
      "id": "npc_bark_089",
      "speaker": "广场居民",
      "location": "群灯广场",
      "requires_flags": [
        "story.ch044.done"
      ],
      "text": "我仍然想有一个不会再失去亲人的地方，但现在至少知道那条路的代价。"
    },
    {
      "id": "npc_bark_090",
      "speaker": "避难街护士",
      "location": "赤炉城区",
      "requires_flags": [
        "story.ch045.done"
      ],
      "text": "有的人赞成永昼，有的人反对。我替两边的孩子一样换药。"
    },
    {
      "id": "npc_bark_091",
      "speaker": "观测员",
      "location": "天顶观测站",
      "requires_flags": [
        "story.ch046.done"
      ],
      "text": "黑星的那晚，我们保住了一条疏散路线。没能救下的地方仍写在报告里。"
    },
    {
      "id": "npc_bark_092",
      "speaker": "旧城门守卫",
      "location": "三誓王都",
      "requires_flags": [
        "story.ch047.done"
      ],
      "text": "以前我只会等命令，如今每次开门先看看门外是不是有人。"
    },
    {
      "id": "npc_bark_093",
      "speaker": "潮歌灯塔看守",
      "location": "晨露海岸",
      "requires_flags": [
        "story.ch048.done"
      ],
      "text": "那一夜的失踪名单还在。我不会拿一块新碑说事情已经过去。"
    },
    {
      "id": "npc_bark_094",
      "speaker": "荒原邮站老板",
      "location": "荒原邮站",
      "requires_flags": [
        "story.ch049.done"
      ],
      "text": "那孩子真跑去找旧英雄了。看他出发时的样子，我想起很多年前。"
    },
    {
      "id": "npc_bark_095",
      "speaker": "王都药房医师",
      "location": "十二年后·三誓王都",
      "requires_flags": [
        "story.ch050.done"
      ],
      "text": "东边的药送到了西边。分区的章没盖上，可病人先好起来。"
    },
    {
      "id": "npc_bark_096",
      "speaker": "雾岭村妇",
      "location": "雾岭农庄",
      "requires_flags": [
        "story.ch051.done"
      ],
      "text": "那位沉默的修屋顶师傅走了，窗台上还留着一枚小星灯。"
    },
    {
      "id": "npc_bark_097",
      "speaker": "暮林旅店老板",
      "location": "暮林古道",
      "requires_flags": [
        "story.ch052.done"
      ],
      "text": "以前是几位英雄歇脚的驿站，现在每个淋雨的人都能进来。"
    },
    {
      "id": "npc_bark_098",
      "speaker": "晨露村花贩",
      "location": "晨露村",
      "requires_flags": [
        "story.ch053.done"
      ],
      "text": "有人仍然不愿原谅他。今天他们一起把那座小桥修好了。"
    },
    {
      "id": "npc_bark_099",
      "speaker": "新生营地学徒",
      "location": "旧洲新生营地",
      "requires_flags": [
        "story.ch054.done"
      ],
      "text": "诺依教我们先问谁会什么，而不是先问谁最厉害。"
    },
    {
      "id": "npc_bark_100",
      "speaker": "暂住家庭",
      "location": "群灯之城",
      "requires_flags": [
        "story.ch055.done"
      ],
      "text": "这是借住的房子，不是抢来的。我们会照协议一起修第二间。"
    },
    {
      "id": "npc_bark_101",
      "speaker": "公益委托员",
      "location": "群灯之城",
      "requires_flags": [
        "story.ch056.done"
      ],
      "text": "任务板第一栏终于不是赏金了。今日需要给学校修路。"
    },
    {
      "id": "npc_bark_102",
      "speaker": "群灯节摊主",
      "location": "群灯之城",
      "requires_flags": [
        "story.ch057.done"
      ],
      "text": "收获节的面包和海祭的鱼摆在一桌，谁也没被要求换家乡。"
    },
    {
      "id": "npc_bark_103",
      "speaker": "公开档案员",
      "location": "群灯之城",
      "requires_flags": [
        "story.ch058.done"
      ],
      "text": "维莎那份记录仍有人来质问。我们把每次质问也留在档案里。"
    },
    {
      "id": "npc_bark_104",
      "speaker": "群灯城面包师",
      "location": "群灯之城",
      "requires_flags": [
        "story.ch059.done"
      ],
      "text": "我不会拿剑，但我每天能给守城的人烤两百份面包。"
    },
    {
      "id": "npc_bark_105",
      "speaker": "街角居民",
      "location": "群灯之城",
      "requires_flags": [
        "story.ch060.done"
      ],
      "text": "我家的小灯今夜没接入，邻居仍来问我需不需要帮忙。"
    },
    {
      "id": "npc_bark_106",
      "speaker": "浮空坞水手",
      "location": "天轨外海",
      "requires_flags": [
        "story.ch061.done"
      ],
      "text": "上去的人会回来，留在地上的人也能等到下一趟船。"
    },
    {
      "id": "npc_bark_107",
      "speaker": "实验室记录员",
      "location": "天轨圣域",
      "requires_flags": [
        "story.ch062.done"
      ],
      "text": "原初报告还在。现在翻开它的人不会只看到“全部成功”。"
    },
    {
      "id": "npc_bark_108",
      "speaker": "晨露旧邻居",
      "location": "澄舟密室",
      "requires_flags": [
        "story.ch063.done"
      ],
      "text": "澄舟最爱修坏掉的水壶。比起古代秘密，我更记得他修完会烫到手。"
    },
    {
      "id": "npc_bark_109",
      "speaker": "天衡祭司",
      "location": "天衡母灯坛",
      "requires_flags": [
        "story.ch064.done"
      ],
      "text": "钟走得不那么准了。奇怪的是，大家反而敢计划明天。"
    },
    {
      "id": "npc_bark_110",
      "speaker": "议会抄写员",
      "location": "环形议会",
      "requires_flags": [
        "story.ch065.done"
      ],
      "text": "七个守门者仍有不同意见。这次我不用删掉六份才能留下一份。"
    },
    {
      "id": "npc_bark_111",
      "speaker": "天桥信使",
      "location": "终末天桥",
      "requires_flags": [
        "story.ch066.done"
      ],
      "text": "天桥可以双向走了。可别把这件事又改成专属于某个人的权限。"
    },
    {
      "id": "npc_bark_112",
      "speaker": "永昼园丁",
      "location": "永昼花园",
      "requires_flags": [
        "story.ch067.done"
      ],
      "text": "今天有人要求种第二季的花。我不确定该怎样做，但我愿学。"
    },
    {
      "id": "npc_bark_113",
      "speaker": "归人长廊旅人",
      "location": "永昼归人长廊",
      "requires_flags": [
        "story.ch068.done"
      ],
      "text": "我仍想见妈妈。如今至少可以先离开，再决定何时回来看那些记忆。"
    },
    {
      "id": "npc_bark_114",
      "speaker": "静时钟匠",
      "location": "永昼静时城市",
      "requires_flags": [
        "story.ch069.done"
      ],
      "text": "我的钟今天走错了五分钟。可至少今天和昨天不再完全一样。"
    },
    {
      "id": "npc_bark_115",
      "speaker": "七灯代表",
      "location": "永昼评议庭",
      "requires_flags": [
        "story.ch070.done"
      ],
      "text": "我们没有投出一个永远正确的答案。会议记录还要留给后来的人。"
    },
    {
      "id": "npc_bark_116",
      "speaker": "终幕殿看守",
      "location": "永昼终幕殿",
      "requires_flags": [
        "story.ch071.done"
      ],
      "text": "司录者终于放下笔。这里第一次有人问我想不想换一份工作。"
    },
    {
      "id": "npc_bark_117",
      "speaker": "晨露码头船工",
      "location": "晨露海岸",
      "requires_flags": [
        "story.ch072.done"
      ],
      "text": "下一艘船已经出港。不知道他们会看到什么，但我愿留一盏灯等他们。"
    }
  ]
}
