      "choice_option_id": "listen",
      "condition": {
        "ch036.approach": "exit_first",
        "world.ch036.approach": "exit_first"
      },
      "insertion": "after_choice_commit_before_encounter",
      "optional": true,
      "independent_route": false,
      "dialogue": [
        {
          "id": "ch036.p13.choice.listen.l01",
          "speaker": "玄璃",
          "text": "先把每扇门交还使用者自己，谁想醒来都不必申请。"
        },
        {
          "id": "ch036.p13.choice.listen.l02",
          "speaker": "岚音",
