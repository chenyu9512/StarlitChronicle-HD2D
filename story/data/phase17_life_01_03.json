{
  "schema": "starlit.story.phase17.life_branch_arcs.v1",
  "status": "authored_branch_arcs_not_runtime_bound",
  "batch": "01",
  "quests": [
    {
      "id": "sq_life_01",
      "late_chapter": "ch006",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "邻里轮班",
            "dialogue": [
              {
                "id": "sq_life_01.p17.a.followup.l01",
                "speaker": "灯匠",
                "text": "我教大家认配电箱的危险标志，不会修的人只负责报告。"
              },
              {
                "id": "sq_life_01.p17.a.followup.l02",
                "speaker": "街坊",
                "text": "第三盏灯闪烁的时间我写在值班板上。"
              },
              {
                "id": "sq_life_01.p17.a.followup.l03",
                "speaker": "孩子",
                "text": "今晚不用抓传说里的海怪了。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "雨夜报修",
            "dialogue": [
              {
                "id": "sq_life_01.p17.a.community.l01",
                "speaker": "夜班渔夫",
                "text": "第二盏暗了，我照表去找当值灯匠。"
              },
              {
                "id": "sq_life_01.p17.a.community.l02",
                "speaker": "灯匠",
                "text": "及时停电换零件，不让居民碰裸线。"
              },
              {
                "id": "sq_life_01.p17.a.community.l03",
                "speaker": "岚音",
                "text": "回家路终于有了可靠的光。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "下一次黄昏",
            "dialogue": [
              {
                "id": "sq_life_01.p17.a.revisit.l01",
                "speaker": "街坊",
                "text": "灯匠生病也有人知道联系谁。"
              },
              {
                "id": "sq_life_01.p17.a.revisit.l02",
                "speaker": "孩子",
                "text": "值班板上我画了小螃蟹提醒大家。"
              },
              {
                "id": "sq_life_01.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "三盏灯不总是完美，却有人轮流守护。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "耐盐线盒",
            "dialogue": [
              {
                "id": "sq_life_01.p17.b.followup.l01",
                "speaker": "灯匠",
                "text": "新线盒高过蟹钳够得到的位置。"
              },
              {
                "id": "sq_life_01.p17.b.followup.l02",
                "speaker": "夜班渔夫",
                "text": "再经历一次涨潮的盐雾才算试好。"
              },
              {
                "id": "sq_life_01.p17.b.followup.l03",
                "speaker": "主角",
                "text": "断电后从安全位置观察接头。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "更换垫圈",
            "dialogue": [
              {
                "id": "sq_life_01.p17.b.community.l01",
                "speaker": "船匠",
                "text": "这套紧固件耐海风，材料由我捐。"
              },
              {
                "id": "sq_life_01.p17.b.community.l02",
                "speaker": "灯匠",
                "text": "维修记录照样记下，不能靠好心人一直无偿补。"
              },
              {
                "id": "sq_life_01.p17.b.community.l03",
                "speaker": "孩子",
                "text": "小螃蟹不会再钻进灯柱啦。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "盐潮复查",
            "dialogue": [
              {
                "id": "sq_life_01.p17.b.revisit.l01",
                "speaker": "岚音",
                "text": "连续两场雨，夜路没再大面积熄灯。"
              },
              {
                "id": "sq_life_01.p17.b.revisit.l02",
                "speaker": "灯匠",
                "text": "下个月还要检查垫圈，不能一劳永逸。"
              },
              {
                "id": "sq_life_01.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "灯柱旁多了一张可查的检修日期表。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_02",
      "late_chapter": "ch008",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "床位公开清单",
            "dialogue": [
              {
                "id": "sq_life_02.p17.a.followup.l01",
                "speaker": "岚音",
                "text": "捐木料人的名字记在账里，病人名字不展示。"
              },
              {
                "id": "sq_life_02.p17.a.followup.l02",
                "speaker": "木匠",
                "text": "床架要先测试承重，不能赶着剪彩。"
              },
              {
                "id": "sq_life_02.p17.a.followup.l03",
                "speaker": "病人",
                "text": "床头无需写谁出的钱，我只想休息。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "维修值班日",
            "dialogue": [
              {
                "id": "sq_life_02.p17.a.community.l01",
                "speaker": "护士",
                "text": "活动脚轮松动了，记得从维护预算里支出。"
              },
              {
                "id": "sq_life_02.p17.a.community.l02",
                "speaker": "岚音",
                "text": "公开的不只捐款，还有后续检修费用。"
              },
              {
                "id": "sq_life_02.p17.a.community.l03",
                "speaker": "村民",
                "text": "下次帮忙前我先学安全搬床。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "冬季第二张床",
            "dialogue": [
              {
                "id": "sq_life_02.p17.a.revisit.l01",
                "speaker": "病人家属",
                "text": "今年不用再让老人睡在地板上。"
              },
              {
                "id": "sq_life_02.p17.a.revisit.l02",
                "speaker": "岚音",
                "text": "维修账还在，照护不会到捐赠当天就结束。"
              },
              {
                "id": "sq_life_02.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "捐赠册挂在库房外，床边只有护理须知。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "护理基础课",
            "dialogue": [
              {
                "id": "sq_life_02.p17.b.followup.l01",
                "speaker": "岚音",
                "text": "学洗手与求救，不擅自诊断或给药。"
              },
              {
                "id": "sq_life_02.p17.b.followup.l02",
                "speaker": "村民",
                "text": "我能安全换床单，也知道什么时候找医师。"
              },
              {
                "id": "sq_life_02.p17.b.followup.l03",
                "speaker": "护士",
                "text": "培训签到不代表获得医疗执照。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "安排夜班轮休",
            "dialogue": [
              {
                "id": "sq_life_02.p17.b.community.l01",
                "speaker": "村民",
                "text": "我愿做两班，凌晨要回家陪孩子。"
              },
              {
                "id": "sq_life_02.p17.b.community.l02",
                "speaker": "岚音",
                "text": "好，下一班交给其他志愿者。"
              },
              {
                "id": "sq_life_02.p17.b.community.l03",
                "speaker": "病人",
                "text": "有人陪我慢慢说话，比一直熬夜的护士更轻松。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "新一批志愿者",
            "dialogue": [
              {
                "id": "sq_life_02.p17.b.revisit.l01",
                "speaker": "年轻村民",
                "text": "我会安全搬床，遇到发热还是先找医生。"
              },
              {
                "id": "sq_life_02.p17.b.revisit.l02",
                "speaker": "岚音",
                "text": "互助不要求人人都变成医师。"
              },
              {
                "id": "sq_life_02.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "床边贴着轮替名单，任何人都可按规定休息。"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "sq_life_03",
      "late_chapter": "ch009",
      "arms": {
        "a": [
          {
            "kind": "followup",
            "title": "调料罐重排",
            "dialogue": [
              {
                "id": "sq_life_03.p17.a.followup.l01",
                "speaker": "厨娘",
                "text": "先晾干潮湿木柜，两种罐子用不同形状的勺。"
              },
              {
                "id": "sq_life_03.p17.a.followup.l02",
                "speaker": "学徒",
                "text": "我摸得到凸纹，不看字也不容易拿错。"
              },
              {
                "id": "sq_life_03.p17.a.followup.l03",
                "speaker": "朔弦",
                "text": "旧饭钱我认，但别算成整间厨房装修。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "闭眼取料练习",
            "dialogue": [
              {
                "id": "sq_life_03.p17.a.community.l01",
                "speaker": "学徒",
                "text": "刚才差点拿错糖，我重新洗好勺子再试。"
              },
              {
                "id": "sq_life_03.p17.a.community.l02",
                "speaker": "厨娘",
                "text": "做汤之前先确认食客有没有忌口。"
              },
              {
                "id": "sq_life_03.p17.a.community.l03",
                "speaker": "朔弦",
                "text": "我洗锅抵掉一部分旧债。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "又一锅热汤",
            "dialogue": [
              {
                "id": "sq_life_03.p17.a.revisit.l01",
                "speaker": "码头工",
                "text": "不认字的新学徒也能区分盐糖了。"
              },
              {
                "id": "sq_life_03.p17.a.revisit.l02",
                "speaker": "厨娘",
                "text": "柜子保持干燥比夸奖新标签更重要。"
              },
              {
                "id": "sq_life_03.p17.a.revisit.l03",
                "speaker": "旁白",
                "text": "厨房旧账结清，汤照样每天有新味道。"
              }
            ]
          }
        ],
        "b": [
          {
            "kind": "followup",
            "title": "旧饭账分开",
            "dialogue": [
              {
                "id": "sq_life_03.p17.b.followup.l01",
                "speaker": "朔弦",
                "text": "欠一顿饭是我自己的事，修柜是公共维修。"
              },
              {
                "id": "sq_life_03.p17.b.followup.l02",
                "speaker": "厨娘",
                "text": "我承认标签出过错，不会把全部费用扔给船员。"
              },
              {
                "id": "sq_life_03.p17.b.followup.l03",
                "speaker": "学徒",
                "text": "我把材料费记在公共账上。"
              }
            ]
          },
          {
            "kind": "community",
            "title": "厨房修柜日",
            "dialogue": [
              {
                "id": "sq_life_03.p17.b.community.l01",
                "speaker": "码头工",
                "text": "坏铰链是谁用坏的，现在总算查清。"
              },
              {
                "id": "sq_life_03.p17.b.community.l02",
                "speaker": "厨娘",
                "text": "维修费和旧债各有签收人。"
              },
              {
                "id": "sq_life_03.p17.b.community.l03",
                "speaker": "朔弦",
                "text": "这次我可以抬头走进厨房吃饭了。"
              }
            ]
          },
          {
            "kind": "revisit",
            "title": "新菜单价目",
            "dialogue": [
              {
                "id": "sq_life_03.p17.b.revisit.l01",
                "speaker": "厨娘",
                "text": "老账结清了，新的菜价也贴在墙上。"
              },
              {
                "id": "sq_life_03.p17.b.revisit.l02",
                "speaker": "朔弦",
                "text": "还钱不代表要永远吃同一种鱼汤。"
              },
              {
                "id": "sq_life_03.p17.b.revisit.l03",
                "speaker": "旁白",
                "text": "小厨房多出一个由食客共同监督的维修账本。"
              }
            ]
          }
        ]
      }
    }
  ]
}
